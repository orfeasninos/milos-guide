---
import '@fontsource-variable/dm-sans';
import '@fontsource/dm-serif-display/400.css';
import '@fontsource/dm-serif-display/400-italic.css';
import MilosIcon from '../components/milosicon.astro';

interface Props {
  title: string;
  description: string;
  lang?: 'en' | 'el';
  jsonld?: object | object[] | null;
  preloadImage?: string;
  preloadImageSrcset?: string;
  preloadImageSizes?: string;
}

const { title, description, lang = 'en', jsonld: pageJsonld = null, preloadImage, preloadImageSrcset, preloadImageSizes = '100vw' } = Astro.props;

const siteUrl = (Astro.site?.toString() ?? 'https://milos.guide').replace(/\/$/, '');
const canonicalURL = new URL(Astro.url.pathname, siteUrl);
const currentPath = Astro.url.pathname;

const isEl = lang === 'el';
const t = (en: string, el: string) => (isEl ? el : en);
const href = (path: string) => (isEl ? `/el${path}` : path);
const isCurrent = (path: string) => currentPath.startsWith(href(path));

const navItems = [
  { path: '/stays/', label: t('Stay', 'Διαμονή') },
  { path: '/restaurants/', label: t('Food', 'Φαγητό') },
  { path: '/beaches/', label: t('Beaches', 'Παραλίες') },
  { path: '/sights/', label: t('Sights', 'Αξιοθέατα') },
  { path: '/villages/', label: t('Villages', 'Χωριά') },
];

const englishURL = new URL(currentPath.replace(/^\/el(?=\/|$)/, '') || '/', siteUrl);
const year = new Date().getFullYear();

// --- BreadcrumbList ---
const cleanPath = currentPath.replace(/^\/el/, '').replace(/\/$/, '');
const pathParts = cleanPath.split('/').filter(Boolean);

const segmentLabels: Record<string, { el: string; en: string }> = {
  beaches:        { el: 'Παραλίες',            en: 'Beaches' },
  villages:       { el: 'Χωριά',               en: 'Villages' },
  sights:         { el: 'Αξιοθέατα',           en: 'Sights & Attractions' },
  restaurants:    { el: 'Εστιατόρια',          en: 'Restaurants' },
  stays:          { el: 'Διαμονή',             en: 'Where to Stay' },
  weather:        { el: 'Καιρός Μήλου',        en: 'Milos Weather' },
  map:            { el: 'Χάρτης Μήλου',        en: 'Milos Map' },
  about:          { el: 'Σχετικά με τη Μήλο',  en: 'About Milos' },
  search:         { el: 'Αναζήτηση',           en: 'Search' },
  contact:        { el: 'Επικοινωνία',         en: 'Contact' },
  'how-to-reach': { el: 'Πώς να φτάσετε',     en: 'How to Reach Milos' },
};

const breadcrumbs: { name: string; url: string }[] = [
  { name: 'Milos.guide', url: siteUrl + (isEl ? '/el' : '/') },
];
let accumulated = isEl ? '/el' : '';
pathParts.forEach((part, i) => {
  accumulated += '/' + part;
  const isLast = i === pathParts.length - 1;
  breadcrumbs.push({
    name: isLast ? title : (segmentLabels[part]?.[isEl ? 'el' : 'en'] ?? part),
    url: siteUrl + accumulated + '/',
  });
});

const isHome = pathParts.length === 0;

// --- Schema graph ---
const schemas: object[] = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    '@id': siteUrl + '/#website',
    name: 'Milos.guide',
    // "Milos Guide" first: Google uses alternateName to tie the brand query to the site name.
    alternateName: isEl ? ['Milos Guide', 'Οδηγός Μήλου'] : ['Milos Guide', 'Milos Island Guide'],
    url: siteUrl,
    description: isEl
      ? 'Ο πλήρης οδηγός για τη Μήλο — παραλίες, χωριά, αξιοθέατα και ιστορία. Χωρίς διαφημίσεις.'
      : 'The complete travel guide to Milos island — beaches, villages, sights and history. No ads.',
    inLanguage: isEl ? 'el-GR' : 'en',
    potentialAction: {
      '@type': 'SearchAction',
      target: { '@type': 'EntryPoint', urlTemplate: siteUrl + '/search/?q={search_term_string}' },
      'query-input': 'required name=search_term_string',
    },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'Organization',
    '@id': siteUrl + '/#organization',
    name: 'Milos.guide',
    alternateName: 'Milos Guide',
    url: siteUrl,
    logo: {
      '@type': 'ImageObject',
      url: siteUrl + '/og-image.jpg',
      width: 1200,
      height: 630,
    },
    description: isEl
      ? 'Ανεξάρτητος, αδιαφήμιστος οδηγός για τη Μήλο.'
      : 'Independent, ad-free travel guide for Milos island.',
  },
  {
    '@context': 'https://schema.org',
    '@type': 'WebPage',
    '@id': canonicalURL.toString() + '#webpage',
    url: canonicalURL.toString(),
    name: title + ' | Milos.guide',
    description: description,
    inLanguage: isEl ? 'el-GR' : 'en',
    isPartOf: { '@type': 'WebSite', '@id': siteUrl + '/#website' },
    about: { '@type': 'TouristDestination', '@id': siteUrl + '/#milos' },
    publisher: { '@type': 'Organization', '@id': siteUrl + '/#organization' },
  },
  ...(breadcrumbs.length > 1 ? [{
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: breadcrumbs.map((crumb, i) => ({
      '@type': 'ListItem',
      position: i + 1,
      name: crumb.name,
      item: crumb.url,
    })),
  }] : []),
  ...(isHome ? [{
    '@context': 'https://schema.org',
    '@type': 'TouristDestination',
    '@id': siteUrl + '/#milos',
    name: isEl ? 'Μήλος' : 'Milos',
    description: isEl
      ? 'Ηφαιστειογενές νησί στις Κυκλάδες με εξωτικές παραλίες, κρυσταλλένια νερά, ζωντανά χωριά και 2.500 χρόνια ιστορίας.'
      : 'Volcanic Cycladic island with exotic beaches, crystal-clear waters, vibrant villages and 2,500 years of history.',
    url: siteUrl + (isEl ? '/el' : '/'),
    image: siteUrl + '/og-image.jpg',
    geo: { '@type': 'GeoCoordinates', latitude: 36.7217, longitude: 24.4389 },
    containedInPlace: {
      '@type': 'AdministrativeArea',
      name: isEl ? 'Κυκλάδες' : 'Cyclades',
      containedInPlace: {
        '@type': 'Country',
        name: isEl ? 'Ελλάδα' : 'Greece',
        sameAs: 'https://www.wikidata.org/wiki/Q41',
      },
    },
    touristType: [
      { '@type': 'Audience', audienceType: isEl ? 'Παραλία' : 'Beach' },
      { '@type': 'Audience', audienceType: isEl ? 'Φύση' : 'Nature' },
      { '@type': 'Audience', audienceType: isEl ? 'Πολιτισμός' : 'Culture' },
      { '@type': 'Audience', audienceType: isEl ? 'Γαστρονομία' : 'Gastronomy' },
    ],
    sameAs: [
      'https://en.wikipedia.org/wiki/Milos',
      'https://www.wikidata.org/wiki/Q170579',
    ],
  }] : []),
  ...(pageJsonld ? (Array.isArray(pageJsonld) ? pageJsonld : [pageJsonld]) : []),
];
---

<!DOCTYPE html>
<html lang={lang}>
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title} | Milos.guide</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonicalURL} />
  <meta name="robots" content="index, follow" />
  <meta name="author" content="Milos.guide" />
  <link rel="alternate" hreflang="en"        href={englishURL} />
  <link rel="alternate" hreflang="x-default" href={englishURL} />
  <meta property="og:type"         content="website" />
  <meta property="og:url"          content={canonicalURL} />
  <meta property="og:title"        content={`${title} | Milos.guide`} />
  <meta property="og:description"  content={description} />
  <meta property="og:image"        content={siteUrl + "/og-image.jpg"} />
  <meta property="og:image:width"  content="1200" />
  <meta property="og:image:height" content="630" />
  <meta property="og:locale"       content={isEl ? 'el_GR' : 'en_US'} />
  <meta property="og:site_name"    content="Milos.guide" />
  <meta name="twitter:card"        content="summary_large_image" />
  <meta name="twitter:title"       content={`${title} | Milos.guide`} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image"       content={siteUrl + "/og-image.jpg"} />
  {schemas.map(s => (
    <script is:inline type="application/ld+json" set:html={JSON.stringify(s)} />
  ))}
  <link rel="icon"             sizes="16x16" href="/favicon-16x16.png" type="image/png" />
  <link rel="icon"             sizes="32x32" href="/favicon-32x32.png" type="image/png" />
  <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
  <link rel="manifest"         href="/site.webmanifest" />
  <meta name="theme-color" content="#0d2b4e" />
  <script is:inline defer src="https://cloud.umami.is/script.js" data-website-id="009b43d8-5a1a-4c08-9c44-ffc380e4e872"></script>
  {preloadImageSrcset && (
    <link rel="preload" as="image" imagesrcset={preloadImageSrcset} imagesizes={preloadImageSizes} fetchpriority="high" />
  )}
  {preloadImage && !preloadImageSrcset && (
    <link rel="preload" as="image" href={preloadImage} type={preloadImage.endsWith('.avif') ? 'image/avif' : preloadImage.endsWith('.webp') ? 'image/webp' : undefined} fetchpriority="high" />
  )}
  <slot name="head" />
</head>
<body>
  <a href="#main-content" class="skip-link">{t('Skip to content', 'Μετάβαση στο περιεχόμενο')}</a>

  <header class="site-header" id="site-header">
    <div class="container header-inner">
      <a href={href('/')} class="logo" aria-label={t('Milos.guide home', 'Milos.guide αρχική')}>
        <span class="logo-name">Milos</span><span class="logo-dot">.</span><span class="logo-tld">guide</span>
      </a>

      <nav class="main-nav" id="main-nav" aria-label={t('Main', 'Κύρια πλοήγηση')}>
        <ul class="nav-list">
          {navItems.map(item => (
            <li>
              <a href={href(item.path)} class="nav-link" aria-current={isCurrent(item.path) ? 'page' : undefined}>{item.label}</a>
            </li>
          ))}
        </ul>
        <div class="nav-icons">
          <!-- Without JS (or on Enter with no highlighted result) the form falls back to the /search/ page. -->
          <form class="header-search" id="header-search" action={href('/search/')} method="get" role="search">
            <svg class="hs-icon" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
            <input
              id="hs-input"
              class="hs-input"
              type="search"
              name="q"
              placeholder={t('Search Milos…', 'Αναζήτηση…')}
              aria-label={t('Search beaches, sights, villages, food and stays', 'Αναζήτηση παραλιών, αξιοθέατων, χωριών, φαγητού και διαμονής')}
              autocomplete="off"
              spellcheck="false"
              role="combobox"
              aria-expanded="false"
              aria-controls="hs-results"
              aria-autocomplete="list"
            />
            <ul class="hs-results" id="hs-results" role="listbox" hidden></ul>
          </form>
          <a href={href('/map/')} class="icon-btn" data-tooltip={t('Map', 'Χάρτης')} aria-current={isCurrent('/map/') ? 'page' : undefined}>
            <MilosIcon />
            <span class="icon-btn-label">{t('Map', 'Χάρτης')}</span>
          </a>
          <a href={href('/weather/')} class="icon-btn" data-tooltip={t('Weather', 'Καιρός')} aria-current={isCurrent('/weather/') ? 'page' : undefined}>
            <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <circle cx="12" cy="12" r="5"/>
              <line x1="12" y1="1" x2="12" y2="3"/><line x1="12" y1="21" x2="12" y2="23"/>
              <line x1="4.22" y1="4.22" x2="5.64" y2="5.64"/><line x1="18.36" y1="18.36" x2="19.78" y2="19.78"/>
              <line x1="1" y1="12" x2="3" y2="12"/><line x1="21" y1="12" x2="23" y2="12"/>
              <line x1="4.22" y1="19.78" x2="5.64" y2="18.36"/><line x1="18.36" y1="5.64" x2="19.78" y2="4.22"/>
            </svg>
            <span class="icon-btn-label">{t('Weather', 'Καιρός')}</span>
          </a>
        </div>
      </nav>

      <button class="nav-toggle" id="nav-toggle" type="button" aria-expanded="false" aria-controls="main-nav"
        aria-label={t('Menu', 'Μενού')}>
        <span class="nav-toggle-bar"></span>
        <span class="nav-toggle-bar"></span>
        <span class="nav-toggle-bar"></span>
      </button>
    </div>
  </header>

  <main class="page-main" id="main-content">
    <slot />
  </main>

  <footer class="site-footer">
    <div class="footer-top">
      <div class="container footer-top-inner">
        <div class="footer-brand">
          <a href={href('/')} class="footer-logo" aria-label={t('Milos.guide home', 'Milos.guide αρχική')}>
            <span class="logo-name">Milos</span><span class="logo-dot">.</span><span class="logo-tld">guide</span>
          </a>
          <p class="footer-tagline">
            {t('The most complete guide\nto Milos — no ads.', 'Ο πιο πλήρης οδηγός\nγια τη Μήλο — χωρίς διαφημίσεις.')}
          </p>
        </div>

        <nav class="footer-cols" aria-label={t('Footer', 'Υποσέλιδο')}>
          <div class="footer-col">
            <p class="footer-col-title">{t('Explore', 'Εξερεύνηση')}</p>
            <a href={href('/stays/')}><span class="flink-icon" aria-hidden="true">🛏</span>{t('Where to stay', 'Διαμονή')}</a>
            <a href={href('/restaurants/')}><span class="flink-icon" aria-hidden="true">🍽</span>{t('Restaurants', 'Εστιατόρια')}</a>
            <a href={href('/beaches/')}><span class="flink-icon" aria-hidden="true">🏖</span>{t('Beaches', 'Παραλίες')}</a>
            <a href={href('/sights/')}><span class="flink-icon" aria-hidden="true">🏛</span>{t('Sights', 'Αξιοθέατα')}</a>
            <a href={href('/villages/')}><span class="flink-icon" aria-hidden="true">🏘</span>{t('Villages', 'Χωριά')}</a>
          </div>

          <div class="footer-col">
            <p class="footer-col-title">{t('Information', 'Πληροφορίες')}</p>
            <a href={href('/about/')}>{t('About Milos', 'Η Μήλος')}</a>
            <a href={href('/weather/')}>{t('Weather', 'Καιρός')}</a>
            <a href={href('/map/')}>{t('Island map', 'Χάρτης νησιού')}</a>
            <a href={href('/how-to-reach/')}>{t('How to reach', 'Πώς να φτάσετε')}</a>
            <a href={href('/contact/')}>{t('Contact', 'Επικοινωνία')}</a>
          </div>
        </nav>
      </div>
    </div>

    <div class="footer-wave" aria-hidden="true">
      <svg viewBox="0 0 1440 40" preserveAspectRatio="none" xmlns="http://www.w3.org/2000/svg">
        <path d="M0,20 C240,40 480,0 720,20 C960,40 1200,0 1440,20 L1440,40 L0,40 Z" fill="rgba(255,255,255,0.04)"/>
      </svg>
    </div>

    <div class="footer-bottom">
      <div class="container footer-bottom-inner">
        <p class="footer-copy">&copy; {year} Milos.guide · <a href={href('/privacy/')} class="footer-policy-link">{t('Privacy Policy', 'Πολιτική Απορρήτου')}</a></p>
        <p class="footer-note">{t('Made with love for Milos · No ads', 'Φτιαγμένο με αγάπη για τη Μήλο · Χωρίς διαφημίσεις')}</p>
      </div>
    </div>
  </footer>

<script>
import { fold, matches, highlight, type SearchItem } from '../lib/search-match';

const header = document.getElementById('site-header');
const toggle = document.getElementById('nav-toggle') as HTMLButtonElement | null;
const nav = document.getElementById('main-nav');

const onScroll = () => header?.classList.toggle('is-scrolled', window.scrollY > 8);
window.addEventListener('scroll', onScroll, { passive: true });
onScroll();

const setOpen = (open: boolean) => {
  nav?.classList.toggle('is-open', open);
  if (!toggle) return;
  toggle.setAttribute('aria-expanded', String(open));
};
const isOpen = () => nav?.classList.contains('is-open') ?? false;

toggle?.addEventListener('click', () => setOpen(!isOpen()));
document.addEventListener('click', e => {
  const target = e.target as Node;
  if (isOpen() && !nav?.contains(target) && !toggle?.contains(target)) setOpen(false);
});
document.addEventListener('keydown', e => {
  if (e.key === 'Escape' && isOpen()) { setOpen(false); toggle?.focus(); }
});
window.matchMedia('(min-width: 721px)').addEventListener('change', e => { if (e.matches) setOpen(false); });

// ── Header search ──
const searchForm = document.getElementById('header-search') as HTMLFormElement | null;
const searchInput = document.getElementById('hs-input') as HTMLInputElement | null;
const searchList = document.getElementById('hs-results');
const searchIsEl = document.documentElement.lang === 'el';
const MAX_RESULTS = 8;

let searchIndex: Promise<SearchItem[]> | null = null;
let activeIndex = -1;

// Fetched on first focus instead of inlined, so pages that never use search don't pay for it.
const loadIndex = () => searchIndex ??= fetch('/search-index.json')
  .then(r => r.json() as Promise<SearchItem[]>)
  .catch(() => { searchIndex = null; return []; });

const resultLinks = () => [...(searchList?.querySelectorAll<HTMLAnchorElement>('.hs-result') ?? [])];

const showResults = (show: boolean) => {
  if (!searchList || !searchInput) return;
  searchList.hidden = !show;
  searchInput.setAttribute('aria-expanded', String(show));
  if (!show) setActive(-1);
};

const setActive = (i: number) => {
  const links = resultLinks();
  activeIndex = i;
  links.forEach((a, n) => a.setAttribute('aria-selected', String(n === i)));
  if (links[i]) {
    searchInput?.setAttribute('aria-activedescendant', links[i].id);
    links[i].scrollIntoView({ block: 'nearest' });
  } else {
    searchInput?.removeAttribute('aria-activedescendant');
  }
};

async function renderSearch() {
  if (!searchInput || !searchList || !searchForm) return;
  const raw = searchInput.value.trim();
  const q = fold(raw);
  // One letter matches nearly everything, so wait for a second one.
  if ([...q].length < 2) { showResults(false); searchList.innerHTML = ''; return; }

  const index = await loadIndex();
  // The user may have kept typing while the index loaded.
  if (fold(searchInput.value.trim()) !== q) return;

  const results = index.filter(item => matches(item, q));
  const allUrl = `${searchForm.action}?q=${encodeURIComponent(raw)}`;

  searchList.innerHTML = results.length
    ? results.slice(0, MAX_RESULTS).map((item, i) => `
      <li role="presentation">
        <a href="${item.url}" class="hs-result" id="hs-opt-${i}" role="option" aria-selected="false">
          ${item.logo ? `<img src="${item.logo}" alt="" class="hs-result-logo" />` : `<span class="hs-result-icon" aria-hidden="true">${item.icon}</span>`}
          <span class="hs-result-body">
            <span class="hs-result-name">${highlight(searchIsEl ? item.nameEl : item.nameEn, q)}</span>
            <span class="hs-result-meta">${searchIsEl ? item.typeEl : item.typeEn} · ${item.area}</span>
          </span>
        </a>
      </li>`).join('') + (results.length > MAX_RESULTS ? `
      <li role="presentation"><a href="${allUrl}" class="hs-all">${searchIsEl ? `Όλα τα ${results.length} αποτελέσματα` : `All ${results.length} results`} →</a></li>` : '')
    : `<li class="hs-empty" role="presentation">${searchIsEl ? 'Δεν βρέθηκαν αποτελέσματα.' : 'No results found.'}</li>`;

  setActive(-1);
  showResults(true);
}

searchInput?.addEventListener('focus', () => { loadIndex(); renderSearch(); });
searchInput?.addEventListener('input', renderSearch);
searchInput?.addEventListener('keydown', e => {
  const links = resultLinks();
  if (e.key === 'ArrowDown' && links.length) {
    e.preventDefault();
    if (searchList?.hidden) showResults(true);
    setActive((activeIndex + 1) % links.length);
  } else if (e.key === 'ArrowUp' && links.length) {
    e.preventDefault();
    setActive(activeIndex <= 0 ? links.length - 1 : activeIndex - 1);
  } else if (e.key === 'Escape' && !searchList?.hidden) {
    // Stop the mobile menu's Escape handler from also closing the menu.
    e.stopPropagation();
    showResults(false);
  }
});
searchForm?.addEventListener('submit', e => {
  const link = resultLinks()[activeIndex];
  if (link) { e.preventDefault(); window.location.href = link.href; }
  else if (!searchInput?.value.trim()) e.preventDefault();
});
document.addEventListener('click', e => {
  if (searchForm && !searchForm.contains(e.target as Node)) showResults(false);
});
</script>
</body>
</html>

<style is:global>
/* SmartImage: <img> always fills its <picture> wrapper */
picture > img { width: 100%; height: 100%; object-fit: cover; display: block; }

:root {
  --deep-blue:   #0d2b4e;
  --aegean:      #1a5c8a;
  --sea:         #3a9bc9;
  --sky:         #7dd3f8;
  --sand:        #f5f0e8;
  --sand-dark:   #e8e0cf;
  --white:       #ffffff;
  --ink:         #111827;
  --muted:       #6b7280;
  --border:      rgba(0,0,0,0.08);
  --border-lt:   rgba(255,255,255,0.09);
  --font-sans:   'DM Sans Variable', 'DM Sans', system-ui, sans-serif;
  --font-serif:  'DM Serif Display', Georgia, serif;
  --radius-sm:   6px;
  --radius-md:   12px;
  --radius-lg:   20px;
  --radius-full: 100px;
  --header-h:    60px;
  --shadow-sm:   0 1px 3px rgba(0,0,0,0.06), 0 1px 2px rgba(0,0,0,0.04);
  --shadow-md:   0 4px 16px rgba(0,0,0,0.08), 0 2px 6px rgba(0,0,0,0.04);
  --shadow-lg:   0 16px 48px rgba(0,0,0,0.14), 0 4px 12px rgba(0,0,0,0.06);
  --ease:        cubic-bezier(0.4, 0, 0.2, 1);
  --ease-spring: cubic-bezier(0.34, 1.56, 0.64, 1);
  --ease-out:    cubic-bezier(0, 0, 0.2, 1);
}

*, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
html { scroll-behavior: smooth; -webkit-text-size-adjust: 100%; text-size-adjust: 100%; }
body { display: flex; flex-direction: column; min-height: 100vh; font-family: var(--font-sans); font-size: 16px; line-height: 1.65; color: var(--ink); background: var(--sand); -webkit-font-smoothing: antialiased; -moz-osx-font-smoothing: grayscale; overflow-x: hidden; }
