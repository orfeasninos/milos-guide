---
// src/layouts/Layout.astro
const { title, description } = Astro.props;
---

<!DOCTYPE html>
<html lang="el">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title} | Milos Guide</title>
    <meta name="description" content={description} />
</head>
<body>
    <header class="navbar">
        <div class="container">
            <a href="/" class="logo">Milos<span>.guide</span></a>
            <nav>
                <a href="/eat">🍽️ Φαγητό</a>
                <a href="/beaches">🏖️ Παραλίες</a>
            </nav>
        </div>
    </header>

    <main class="container animate-fade">
        <slot />
    </main>

    <footer>
        <p>&copy; 2026 Milos.guide — Ultra-fast Local Directory</p>
    </footer>
</body>
</html>

<style is:global>
    :root {
        --bg-color: #fafafa;
        --card-bg: #ffffff;
        --text-main: #222222;
        --aegean-blue: #0056b3;
        --border-color: #e5e7eb;
    }

    * { box-sizing: border-box; margin: 0; padding: 0; }
    body {
        font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Arial, sans-serif;
        background-color: var(--bg-color);
        color: var(--text-main);
        line-height: 1.6;
    }
    .container { width: 100%; max-width: 1100px; margin: 0 auto; padding: 0 1.5rem; }
    .navbar { background: var(--card-bg); border-bottom: 1px solid var(--border-color); padding: 1rem 0; position: sticky; top: 0; z-index: 100; }
    .navbar .container { display: flex; justify-content: space-between; align-items: center; }
    .logo { font-size: 1.5rem; font-weight: 800; color: var(--text-main); text-decoration: none; }
    .logo span { color: var(--aegean-blue); }
    nav a { margin-left: 1.5rem; text-decoration: none; color: var(--text-main); font-weight: 500; }
    nav a:hover { color: var(--aegean-blue); }
    footer { text-align: center; padding: 2rem 0; margin-top: 4rem; font-size: 0.9rem; color: #666; border-top: 1px solid var(--border-color); }
</style>