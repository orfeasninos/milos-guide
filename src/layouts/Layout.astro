---
const { title, description, lang = 'el' } = Astro.props;
const base = import.meta.env.BASE_URL;

const canonicalURL = new URL(Astro.url.pathname, Astro.site ?? 'https://milos.guide');

// Language switcher logic
// EN pages are at root (/beaches), EL pages at /el/beaches
const currentPath = Astro.url.pathname;
const langSwitchHref = lang === 'el'
  ? currentPath.replace(/^\/el/, '') || '/'          // /el/beaches → /beaches
  : `/el${currentPath === '/' ? '' : currentPath}`;  // /beaches → /el/beaches

const isEl = lang === 'el';
---

<!DOCTYPE html>
<html lang={lang}>
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />

  <title>{title} | Milos.guide</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonicalURL} />
  <meta name="robots" content="index, follow" />
  <meta name="author" content="Milos.guide" />

  <!-- hreflang -->
  <link rel="alternate" hreflang="el" href={new URL(isEl ? currentPath : `/el${currentPath}`, Astro.site ?? 'https://milos.guide')} />
  <link rel="alternate" hreflang="en" href={new URL(isEl ? currentPath.replace(/^\/el/, '') || '/' : currentPath, Astro.site ?? 'https://milos.guide')} />
  <link rel="alternate" hreflang="x-default" href={new URL(isEl ? currentPath.replace(/^\/el/, '') || '/' : currentPath, Astro.site ?? 'https://milos.guide')} />

  <!-- Open Graph -->
  <meta property="og:type"         content="website" />
  <meta property="og:url"          content={canonicalURL} />
  <meta property="og:title"        content={`${title} | Milos.guide`} />
  <meta property="og:description"  content={description} />
  <meta property="og:image"        content="/og-image.jpg" />
  <meta property="og:image:width"  content="1200" />
  <meta property="og:image:height" content="630" />
  <meta property="og:locale"       content={isEl ? 'el_GR' : 'en_US'} />
  <meta property="og:site_name"    content="Milos.guide" />

  <!-- Twitter Card -->
  <meta name="twitter:card"        content="summary_large_image" />
  <meta name="twitter:title"       content={`${title} | Milos.guide`} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image"       content="/og-image.jpg" />

  <!-- JSON-LD -->
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "WebSite",
    "name": "Milos.guide",
    "url": "https://milos.guide",
    "description": isEl
      ? "Ο πλήρης οδηγός για τη Μήλο — παραλίες, εστιατόρια, χωριά."
      : "The complete guide to Milos — beaches, restaurants, villages.",
    "inLanguage": lang,
  })} />

  <!-- Favicon -->
  <link rel="icon" sizes="16x16" href="/favicon-16x16.png" type="image/png" />
  <link rel="icon" sizes="32x32" href="/favicon-32x32.png" type="image/png" />
  <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
  <link rel="manifest" href="/site.webmanifest" />

  <!-- Fonts -->
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=DM+Serif+Display:ital@0;1&family=DM+Sans:opsz,wght@9..40,300;9..40,400;9..40,500;9..40,600&display=swap" rel="stylesheet" />

  <meta name="theme-color" content="#0d2b4e" />
</head>

<body>

  <a href="#main-content" class="skip-link">
    {isEl ? 'Μετάβαση στο περιεχόμενο' : 'Skip to content'}
  </a>

  <!-- HEADER -->
  <header class="site-header" id="site-header">
    <div class="header-inner container">

      <a href={isEl ? '/el' : '/'} class="logo" aria-label="Milos.guide">
        <span class="logo-serif">milos</span><span class="logo-dot">.</span><span class="logo-guide">guide</span>
      </a>

      <nav class="main-nav" id="main-nav" aria-label={isEl ? 'Κύρια πλοήγηση' : 'Main navigation'}>
        <a href={isEl ? '/el/eat' : '/eat'} class="nav-link" data-navlink>
          <span class="nav-icon" aria-hidden="true">🍽</span>
          <span>{isEl ? 'Φαγητό' : 'Food'}</span>
        </a>
        <a href={isEl ? '/el/beaches' : '/beaches'} class="nav-link" data-navlink>
          <span class="nav-icon" aria-hidden="true">🏖</span>
          <span>{isEl ? 'Παραλίες' : 'Beaches'}</span>
        </a>

        <a class="nav-link nav-link--soon" aria-disabled="true" tabindex="-1">
          <span class="nav-icon" aria-hidden="true">🚤</span>
          <span>Boat Tours</span>
          <span class="badge-soon">{isEl ? 'Σύντομα' : 'Soon'}</span>
        </a>

        <!-- Search -->
        <a href={isEl ? '/el/search' : '/search'} class="search-btn" aria-label={isEl ? 'Αναζήτηση' : 'Search'}>
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
        </a>

        <!-- Map — Milos silhouette -->
        <a href={isEl ? '/el/map' : '/map'} class="map-btn" aria-label={isEl ? 'Χάρτης' : 'Map'}>
          <svg width="26" height="18" viewBox="0 0 260 174" fill="none" xmlns="http://www.w3.org/2000/svg">
            <path d="M163.034592,148.399704 C164.030991,149.265259 164.972229,150.207367 166.038727,150.975601 C167.185501,151.801651 169.144592,152.199142 169.543747,153.244080 C171.368027,158.020035 172.536865,156.369781 174.265488,153.189835 C178.218246,145.918365 180.512131,145.320541 187.781403,149.226486 C190.036880,150.438400 194.693405,148.708267 195.681793,146.390167 C196.580719,144.281876 197.148941,141.199219 198.754028,140.446640 C200.561356,139.599228 203.895691,140.140579 205.627594,141.384308 C209.380264,144.079178 210.290741,141.547455 211.923676,139.141724 C213.001266,137.554108 215.019531,135.009781 216.012482,135.262970 C218.841324,135.984299 221.406067,137.844696 223.976807,139.416977 C224.839569,139.944641 225.407623,140.954178 226.110397,141.743454 C226.740417,140.738525 227.382004,139.740646 227.997482,138.726898 C228.744598,137.496292 229.261459,136.040344 230.254272,135.064972 C231.660828,133.683090 234.046158,132.992020 234.897079,131.406662 C237.567978,126.430550 243.386246,122.926659 242.311035,116.098518 C242.211090,115.463837 242.877533,114.354385 243.490784,114.019249 C247.332428,111.919922 247.040894,108.806618 247.446854,104.848335 C248.024368,99.217087 248.057617,94.640442 245.185669,89.438934 C242.373322,84.345367 241.908752,78.003777 239.445404,72.656006 C236.846466,67.013855 236.898621,62.227573 241.416199,57.225281 C238.892960,56.419609 236.663757,55.940079 234.667160,54.977898 C233.575653,54.451881 232.008011,52.951740 232.151169,52.162144 C232.804779,48.557381 233.050262,44.268490 235.198257,41.685760 C238.540039,37.667599 243.304565,34.832691 247.806122,31.223665 C247.154770,29.202925 246.595749,26.821115 242.637848,28.647379 C241.389481,29.223410 239.070114,27.872990 237.413116,27.055300 C235.831100,26.274622 234.484421,25.023508 233.014267,24.008175 C230.788467,22.470997 228.545288,20.958952 226.309509,19.436222 C226.754089,19.192150 227.198685,18.948076 227.643265,18.704002 C227.768753,17.327719 227.894241,15.951435 228.01