}

@media (max-width: 720px) {
  .main-nav { display: none; position: absolute; top: calc(var(--header-h) - 5px); left: 0; right: 0; flex-direction: row; flex-wrap: wrap; background: rgba(255,255,255,0.98); backdrop-filter: blur(16px); -webkit-backdrop-filter: blur(16px); padding: 0.6rem; border-bottom: 1px solid var(--border); box-shadow: var(--shadow-lg); gap: 0.15rem; }
  .main-nav.is-open { display: flex; animation: mobileNavIn 0.2s var(--ease-out); }
  @keyframes mobileNavIn { from { opacity: 0; transform: translateY(-10px); } to { opacity: 1; transform: translateY(0); } }
  .nav-link { width: 100%; padding: 0.65rem 1rem; }
  .nav-link.is-active::after { display: none; }
  .nav-link--soon { display: none; }
  .nav-divider { width: 100%; height: 1px; background: var(--border); margin: 0.25rem 0; }
  .icon-btn { flex: 1; justify-content: center; padding: 0.65rem 0; border-radius: var(--radius-sm); height: 44px; width: auto; gap: 0; }
  .icon-btn::after, .icon-btn::before { display: none; }
  .lang-btn { flex: 1; justify-content: center; padding: 0.65rem 0; border: none; border-radius: var(--radius-sm); margin-left: 0; height: 44px; font-size: 0.875rem; }
  .nav-toggle { display: flex; }
  .sec { padding: 3.5rem 0; }
  .sec-hdr-row { flex-direction: column; align-items: flex-start; }
  .footer-top-inner { grid-template-columns: 1fr; gap: 2.5rem; }
  .footer-cols { grid-template-columns: 1fr 1fr; gap: 2rem; }
  .footer-bottom-inner { flex-direction: column; align-items: flex-start; gap: 0.4rem; }
}

@media print {
  .site-header, .site-footer, .skip-link, .nav-toggle { display: none !important; }
  body { background: #fff; color: #000; }
  .page-main { min-height: auto; }
}
</style>

<script>
const header = document.getElementById('site-header');
let _scrolled = false;
window.addEventListener('scroll', () => {
  const y = window.scrollY;
  if (!_scrolled && y > 60)  { _scrolled = true;  header?.classList.add('is-scrolled'); }
  if (_scrolled  && y < 20)  { _scrolled = false; header?.classList.remove('is-scrolled'); }
}, { passive: true });

const toggle = document.getElementById('nav-toggle') as HTMLButtonElement | null;
const nav    = document.getElementById('main-nav');

const closeNav = () => { nav?.classList.remove('is-open'); toggle?.setAttribute('aria-expanded', 'false'); document.body.style.overflow = ''; };
const openNav  = () => { nav?.classList.add('is-open'); toggle?.setAttribute('aria-expanded', 'true'); if (window.innerWidth <= 720) document.body.style.overflow = 'hidden'; };

toggle?.addEventListener('click', () => nav?.classList.contains('is-open') ? closeNav() : openNav());
nav?.querySelectorAll('.nav-link').forEach(l => l.addEventListener('click', closeNav));
document.addEventListener('click', (e) => { if (nav?.classList.contains('is-open') && !nav.contains(e.target as Node) && !toggle?.contains(e.target as Node)) closeNav(); });
document.addEventListener('keydown', (e) => { if (e.key === 'Escape' && nav?.classList.contains('is-open')) { closeNav(); toggle?.focus(); } });
window.addEventListener('resize', () => { if (window.innerWidth > 720 && nav?.classList.contains('is-open')) closeNav(); }, { passive: true });

const path = window.location.pathname;
document.querySelectorAll<HTMLAnchorElement>('[data-navlink]').forEach(link => {
  const href = link.getAttribute('href') ?? '';
  if (href.length > 1 && path.startsWith(href)) link.classList.add('is-active');
});
</script>