---
const { title, description, lang = 'el', jsonld: pageJsonld = null } = Astro.props;
import MilosIcon from '../components/milosicon.astro';

const siteUrl = (Astro.site?.toString() ?? 'https://milos.guide').replace(/\/$/, '');
const canonicalURL = new URL(Astro.url.pathname, siteUrl);

const currentPath = Astro.url.pathname;
const langSwitchHref = lang === 'el'
  ? currentPath.replace(/^\/el/, '') || '/'
  : `/el${currentPath === '/' ? '' : currentPath}`;

const isEl = lang === 'el';

// --- BreadcrumbList ---
const cleanPath = currentPath.replace(/^\/el/, '').replace(/\/$/, '');
const pathParts = cleanPath.split('/').filter(Boolean);

const segmentLabels: Record<string, { el: string; en: string }> = {
  beaches:        { el: 'Παραλίες',            en: 'Beaches' },
  eat:            { el: 'Φαγητό & Εστιατόρια', en: 'Food & Restaurants' },
  stay:           { el: 'Διαμονή',             en: 'Where to Stay' },
  villages:       { el: 'Χωριά',               en: 'Villages' },
  weather:        { el: 'Καιρός Μήλου',        en: 'Milos Weather' },
  map:            { el: 'Χάρτης Μήλου',        en: 'Milos Map' },
  about:          { el: 'Σχετικά με τη Μήλο',  en: 'About Milos' },
  search:         { el: 'Αναζήτηση',           en: 'Search' },
  contact:        { el: 'Επικοινωνία',         en: 'Contact' },
  'how-to-reach': { el: 'Πώς να φτάσετε',     en: 'How to Reach Milos' },
};

const breadcrumbs: { name: string; url: string }[] = [
  { name: 'Milos.guide', url: siteUrl + (isEl ? '/el' : '/') },
];
let accumulated = isEl ? '/el' : '';
pathParts.forEach((part, i) => {
  accumulated += '/' + part;
  const isLast = i === pathParts.length - 1;
  breadcrumbs.push({
    name: isLast ? title : (segmentLabels[part]?.[isEl ? 'el' : 'en'] ?? part),
    url: siteUrl + accumulated,
  });
});

const isHome = pathParts.length === 0;

// --- Schema graph ---
const schemas: object[] = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    '@id': siteUrl + '/#website',
    name: 'Milos.guide',
    alternateName: isEl ? 'Οδηγός Μήλου' : 'Milos Island Guide',
    url: siteUrl,
    description: isEl
      ? 'Ο πλήρης οδηγός για τη Μήλο — παραλίες, εστιατόρια, χωριά και διαμονή. Χωρίς διαφημίσεις.'
      : 'The complete travel guide to Milos island — beaches, restaurants, villages and accommodation. No ads.',
    inLanguage: isEl ? 'el-GR' : 'en',
    potentialAction: {
      '@type': 'SearchAction',
      target: { '@type': 'EntryPoint', urlTemplate: siteUrl + '/search?q={search_term_string}' },
      'query-input': 'required name=search_term_string',
    },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'Organization',
    '@id': siteUrl + '/#organization',
    name: 'Milos.guide',
    url: siteUrl,
    logo: {
      '@type': 'ImageObject',
      url: siteUrl + '/og-image.jpg',
      width: 1200,
      height: 630,
    },
    description: isEl
      ? 'Ανεξάρτητος, αδιαφήμιστος οδηγός για τη Μήλο.'
      : 'Independent, ad-free travel guide for Milos island.',
  },
  {
    '@context': 'https://schema.org',
    '@type': 'WebPage',
    '@id': canonicalURL.toString() + '#webpage',
    url: canonicalURL.toString(),
    name: title + ' | Milos.guide',
    description: description,
    inLanguage: isEl ? 'el-GR' : 'en',
    isPartOf: { '@type': 'WebSite', '@id': siteUrl + '/#website' },
    about: { '@type': 'TouristDestination', '@id': siteUrl + '/#milos' },
    publisher: { '@type': 'Organization', '@id': siteUrl + '/#organization' },
  },
  ...(breadcrumbs.length > 1 ? [{
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: breadcrumbs.map((crumb, i) => ({
      '@type': 'ListItem',
      position: i + 1,
      name: crumb.name,
      item: crumb.url,
    })),
  }] : []),
  ...(isHome ? [{
    '@context': 'https://schema.org',
    '@type': 'TouristDestination',
    '@id': siteUrl + '/#milos',
    name: isEl ? 'Μήλος' : 'Milos',
    description: isEl
      ? 'Ηφαιστειογενές νησί στις Κυκλάδες με εξωτικές παραλίες, κρυσταλλένια νερά και τον θρυλικό Σαρακήνικο.'
      : 'Volcanic Cycladic island with exotic beaches, crystal-clear waters and the legendary Sarakiniko bay.',
    url: siteUrl + (isEl ? '/el' : '/'),
    image: siteUrl + '/og-image.jpg',
    geo: { '@type': 'GeoCoordinates', latitude: 36.7217, longitude: 24.4389 },
    containedInPlace: {
      '@type': 'AdministrativeArea',
      name: isEl ? 'Κυκλάδες' : 'Cyclades',
      containedInPlace: {
        '@type': 'Country',
        name: isEl ? 'Ελλάδα' : 'Greece',
        sameAs: 'https://www.wikidata.org/wiki/Q41',
      },
    },
    touristType: [
      { '@type': 'Audience', audienceType: isEl ? 'Παραλία' : 'Beach' },
      { '@type': 'Audience', audienceType: isEl ? 'Φύση' : 'Nature' },
      { '@type': 'Audience', audienceType: isEl ? 'Πολιτισμός' : 'Culture' },
      { '@type': 'Audience', audienceType: isEl ? 'Γαστρονομία' : 'Gastronomy' },
    ],
    sameAs: [
      'https://en.wikipedia.org/wiki/Milos',
      'https://www.wikidata.org/wiki/Q170579',
    ],
  }] : []),
  ...(pageJsonld ? (Array.isArray(pageJsonld) ? pageJsonld : [pageJsonld]) : []),
];
---

<!DOCTYPE html>
<html lang={lang}>
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title} | Milos.guide</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonicalURL} />
  <meta name="robots" content="noindex, nofollow" />
  <meta name="author" content="Milos.guide" />
  <link rel="alternate" hreflang="el"        href={new URL(isEl ? currentPath : `/el${currentPath}`, Astro.site ?? 'https://milos.guide')} />
  <link rel="alternate" hreflang="en"        href={new URL(isEl ? currentPath.replace(/^\/el/, '') || '/' : currentPath, Astro.site ?? 'https://milos.guide')} />
  <link rel="alternate" hreflang="x-default" href={new URL(isEl ? currentPath.replace(/^\/el/, '') || '/' : currentPath, Astro.site ?? 'https://milos.guide')} />
  <meta property="og:type"         content="website" />
  <meta property="og:url"          content={canonicalURL} />
  <meta property="og:title"        content={`${title} | Milos.guide`} />
  <meta property="og:description"  content={description} />
  <meta property="og:image"        content="/og-image.jpg" />
  <meta property="og:image:width"  content="1200" />
  <meta property="og:image:height" content="630" />
  <meta property="og:locale"       content={isEl ? 'el_GR' : 'en_US'} />
  <meta property="og:site_name"    content="Milos.guide" />
  <meta name="twitter:card"        content="summary_large_image" />
  <meta name="twitter:title"       content={`${title} | Milos.guide`} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image"       content="/og-image.jpg" />
  {schemas.map(s => (
    <script is:inline type="application/ld+json" set:html={JSON.stringify(s)} />
  ))}
  <link rel="icon"             sizes="16x16" href="/favicon-16x16.png" type="image/png" />
  <link rel="icon"             sizes="32x32" href="/favicon-32x32.png" type="image/png" />
  <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
  <link rel="manifest"         href="/site.webmanifest" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=DM+Serif+Display:ital@0;1&family=DM+Sans:opsz,wght@9..40,300;9..40,400;9..40,500;9..40,600&display=swap" rel="stylesheet" />
  <meta name="theme-color" content="#0d2b4e" />
</head>

<body>
  <a href="#main-content" class="skip-link">
    {isEl ? 'Μετάβαση στο περιεχόμενο' : 'Skip to content'}
  </a>

  <header class="site-header" id="site-header">
    <div class="header-inner container">
      <a href={isEl ? '/el' : '/'} class="logo" aria-label="Milos.guide">
        <span class="logo-serif">milos</span><span class="logo-dot">.</span><span class="logo-guide">guide</span>
      </a>

      <nav class="main-nav" id="main-nav" aria-label={isEl ? 'Κύρια πλοήγηση' : 'Main navigation'}>
        <a href={isEl ? '/el/eat' : '/eat'} class="nav-link" data-navlink>
          <span class="nav-icon" aria-hidden="true">🍽</span>
          <span>{isEl ? 'Φαγητό' : 'Food'}</span>
        </a>
        <a href={isEl ? '/el/stay' : '/stay'} class="nav-link" data-navlink>
          <span class="nav-icon" aria-hidden="true">🏨&#xFE0E;</span>
          <span>{isEl ? 'Διαμονή' : 'Stay'}</span>
        </a>
        <a href={isEl ? '/el/beaches' : '/beaches'} class="nav-link" data-navlink>
          <span class="nav-icon" aria-hidden="true">🏖</span>
          <span>{isEl ? 'Παραλίες' : 'Beaches'}</span>
        </a>
        

        <div class="nav-divider" aria-hidden="true"></div>

        <a href={isEl ? '/el/search' : '/search'} class="icon-btn" aria-label={isEl ? 'Αναζήτηση' : 'Search'} data-tooltip={isEl ? 'Αναζήτηση' : 'Search'} data-navlink>
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
        </a>
        <a href={isEl ? '/el/map' : '/map'} class="icon-btn" aria-label={isEl ? 'Χάρτης' : 'Map'} data-tooltip={isEl ? 'Χάρτης' : 'Map'} data-navlink>
          <MilosIcon />
        </a>
        <a href={isEl ? '/el/weather' : '/weather'} class="icon-btn" aria-label={isEl ? 'Καιρός' : 'Weather'} data-tooltip={isEl ? 'Καιρός' : 'Weather'} data-navlink>
          <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <circle cx="12" cy="12" r="5"/>
            <line x1="12" y1="1" x2="12" y2="3"/><line x1="12" y1="21" x2="12" y2="23"/>
            <line x1="4.22" y1="4.22" x2="5.64" y2="5.64"/><line x1="18.36" y1="18.36" x2="19.78" y2="19.78"/>
            <line x1="1" y1="12" x2="3" y2="12"/><line x1="21" y1="12" x2="23" y2="12"/>
            <line x1="4.22" y1="19.78" x2="5.64" y2="18.36"/><line x1="18.36" y1="5.64" x2="19.78" y2="4.22"/>
          </svg>
        </a>
        <a href={langSwitchHref} class="lang-btn" aria-label={isEl ? 'Switch to English' : 'Αλλαγή σε Ελληνικά'}>
          {isEl ? 'EN' : 'ΕΛ'}
        </a>
      </nav>

      <button class="nav-toggle" id="nav-toggle" aria-label={isEl ? 'Άνοιγμα μενού' : 'Open menu'} aria-expanded="false" aria-controls="main-nav" type="button">
        <span class="hamburger-line"></span>
        <span class="hamburger-line"></span>
        <span class="hamburger-line"></span>
      </button>
    </div>
    <div class="header-strip" aria-hidden="true"></div>
  </header>

  <main class="page-main" id="main-content">
    <slot />
  </main>

  <footer class="site-footer">
    <div class="footer-top">
      <div class="container footer-top-inner">
        <div class="footer-brand">
          <a href={isEl ? '/el' : '/'} class="footer-logo" aria-label="Milos.guide">
            <span class="logo-serif">milos</span><span class="logo-dot">.</span><span class="logo-guide">guide</span>
          </a>
          <p class="footer-tagline">
            {isEl
              ? 'Ο πιο πλήρης οδηγός\nγια τη Μήλο — χωρίς διαφημίσεις.'
              : 'The most complete guide\nto Milos — no ads.'}
          </p>
          <div class="footer-facts">
            <span>🌋 {isEl ? 'Κυκλάδες' : 'Cyclades'}</span>
            <span>🏖 70+ {isEl ? 'παραλίες' : 'beaches'}</span>
            <span>🍽 25+ {isEl ? 'εστιατόρια' : 'restaurants'}</span>
          </div>
        </div>

        <nav class="footer-cols" aria-label={isEl ? 'Footer πλοήγηση' : 'Footer navigation'}>
          <div class="footer-col">
            <p class="footer-col-title">{isEl ? 'Εξερεύνηση' : 'Explore'}</p>
            <a href={isEl ? '/el/beaches' : '/beaches'}>
              <span class="flink-icon" aria-hidden="true">🏖</span>{isEl ? 'Παραλίες' : 'Beaches'}
            </a>
            <a href={isEl ? '/el/eat' : '/eat'}>
              <span class="flink-icon" aria-hidden="true">🍽</span>{isEl ? 'Εστιατόρια' : 'Restaurants'}
            </a>
            <a href={isEl ? '/el/villages' : '/villages'}>
              <span class="flink-icon" aria-hidden="true">🏘</span>{isEl ? 'Χωριά' : 'Villages'}
            </a>
            <a href={isEl ? '/el/stay' : '/stay'}>
              <span class="flink-icon" aria-hidden="true">🏨&#xFE0E;</span>{isEl ? 'Διαμονή' : 'Stay'}
            </a>
            <span class="flink-soon">
              <span class="flink-icon" aria-hidden="true">🚤</span>Boat Tours
              <span class="flink-badge">{isEl ? 'Σύντομα' : 'Soon'}</span>
            </span>
            <span class="flink-soon">
              <span class="flink-icon" aria-hidden="true">🚗</span>{isEl ? 'Ενοικιάσεις' : 'Rentals'}
              <span class="flink-badge">{isEl ? 'Σύντομα' : 'Soon'}</span>
            </span>
          </div>

          <div class="footer-col">
            <p class="footer-col-title">{isEl ? 'Παραλίες' : 'Top Beaches'}</p>
            <a href={isEl ? '/el/beaches/sarakiniko' : '/beaches/sarakiniko'}>{isEl ? 'Σαρακήνικο' : 'Sarakiniko'}</a>
            <a href={isEl ? '/el/beaches/kleftiko'   : '/beaches/kleftiko'}>{isEl ? 'Κλέφτικο' : 'Kleftiko'}</a>
            <a href={isEl ? '/el/beaches/tsigrado'   : '/beaches/tsigrado'}>{isEl ? 'Τσιγκράδο' : 'Tsigrado'}</a>
            <a href={isEl ? '/el/beaches/fyriplaka'  : '/beaches/fyriplaka'}>{isEl ? 'Φυριπλάκα' : 'Fyriplaka'}</a>
            <a href={isEl ? '/el/beaches' : '/beaches'} class="flink-more">{isEl ? 'Όλες →' : 'All →'}</a>
          </div>

          <div class="footer-col">
            <p class="footer-col-title">{isEl ? 'Πληροφορίες' : 'Information'}</p>
            <a href={isEl ? '/el/about'        : '/about'}>{isEl ? 'Η Μήλος' : 'About Milos'}</a>
            <a href={isEl ? '/el/weather'      : '/weather'}>{isEl ? 'Καιρός' : 'Weather'}</a>
            <a href={isEl ? '/el/map'          : '/map'}>{isEl ? 'Χάρτης νησιού' : 'Island map'}</a>
            <a href={isEl ? '/el/how-to-reach' : '/how-to-reach'}>{isEl ? 'Πώς να φτάσετε' : 'How to reach'}</a>
            <a href={isEl ? '/el/contact'      : '/contact'}>{isEl ? 'Επικοινωνία' : 'Contact'}</a>
          </div>
        </nav>
      </div>
    </div>

    <div class="footer-wave" aria-hidden="true">
      <svg viewBox="0 0 1440 40" preserveAspectRatio="none" xmlns="http://www.w3.org/2000/svg">
        <path d="M0,20 C240,40 480,0 720,20 C960,40 1200,0 1440,20 L1440,40 L0,40 Z" fill="rgba(255,255,255,0.04)"/>
      </svg>
    </div>

    <div class="footer-bottom">
      <div class="container footer-bottom-inner">
        <p class="footer-copy">&copy; 2026 Milos.guide</p>
        <div class="footer-lang">
          <a href={langSwitchHref} class="footer-lang-btn">
            {isEl ? '🇬🇧 English' : '🇬🇷 Ελληνικά'}
          </a>
        </div>
        <p class="footer-note">
          {isEl ? 'Φτιαγμένο με αγάπη για τη Μήλο · Χωρίς διαφημίσεις' : 'Made with love for Milos · No ads'}
        </p>
      </div>
    </div>
  </footer>
</body>
</html>

<style is:global>
:root {
  --deep-blue:   #0d2b4e;
  --aegean:      #1a5c8a;
  --sea:         #3a9bc9;
  --sky:         #7dd3f8;
  --sand:        #f5f0e8;
  --sand-dark:   #e8e0cf;
  --white:       #ffffff;
  --ink:         #111827;
  --muted:       #6b7280;
  --border:      rgba(0,0,0,0.08);
  --border-lt:   rgba(255,255,255,0.09);
  --font-sans:   'DM Sans', sans-serif;
  --font-serif:  'DM Serif Display', Georgia, serif;
  --radius-sm:   6px;
  --radius-md:   12px;
  --radius-lg:   20px;
  --radius-full: 100px;
  --header-h:    60px;
  --shadow-sm:   0 1px 3px rgba(0,0,0,0.06), 0 1px 2px rgba(0,0,0,0.04);
  --shadow-md:   0 4px 16px rgba(0,0,0,0.08), 0 2px 6px rgba(0,0,0,0.04);
  --shadow-lg:   0 16px 48px rgba(0,0,0,0.14), 0 4px 12px rgba(0,0,0,0.06);
  --ease:        cubic-bezier(0.4, 0, 0.2, 1);
  --ease-spring: cubic-bezier(0.34, 1.56, 0.64, 1);
  --ease-out:    cubic-bezier(0, 0, 0.2, 1);
}

*, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
html { scroll-behavior: smooth; -webkit-text-size-adjust: 100%; text-size-adjust: 100%; }
body { font-family: var(--font-sans); font-size: 16px; line-height: 1.65; color: var(--ink); background: var(--sand); -webkit-font-smoothing: antialiased; -moz-osx-font-smoothing: grayscale; overflow-x: hidden; }
img, video { max-width: 100%; display: block; }
a { color: inherit; text-decoration: none; }
button { font-family: inherit; cursor: pointer; }
nav ul, nav ol { list-style: none; }
::selection { color: var(--aegean); background-color: var(--sand-dark); }

.skip-link { position: absolute; top: -100px; left: 1rem; z-index: 9999; padding: 0.6rem 1.2rem; background: var(--deep-blue); color: #fff; border-radius: var(--radius-sm); font-size: 0.85rem; font-weight: 600; text-decoration: none; transition: top 0.15s; }
.skip-link:focus { top: 1rem; outline: 3px solid var(--sky); outline-offset: 2px; }
:focus-visible { outline: 2px solid var(--sea); outline-offset: 3px; border-radius: 3px; }

.container { width: 100%; max-width: 1160px; margin: 0 auto; padding: 0 1.5rem; }

.site-header { position: sticky; top: 0; z-index: 200; background: rgba(255,255,255,0.92); backdrop-filter: blur(20px) saturate(180%); -webkit-backdrop-filter: blur(20px) saturate(180%); border-bottom: 1px solid var(--border); transition: box-shadow 0.3s var(--ease), background 0.3s var(--ease); }
.site-header.is-scrolled { box-shadow: var(--shadow-md); background: rgba(255,255,255,0.97); }
.site-header.is-scrolled .header-inner { height: 54px; }
.header-inner { display: flex; align-items: center; height: var(--header-h); gap: 1.5rem; transition: height 0.3s var(--ease); }

.logo { display: flex; align-items: baseline; flex-shrink: 0; transition: opacity 0.15s, transform 0.2s var(--ease-spring); }
.logo:hover { opacity: 0.82; transform: scale(1.02); }
.logo-serif { font-family: var(--font-serif); font-size: 1.5rem; color: var(--deep-blue); letter-spacing: -0.01em; }
.logo-dot   { font-family: var(--font-serif); font-size: 1.5rem; color: var(--sea); }
.logo-guide { font-family: var(--font-sans); font-size: 0.72rem; font-weight: 600; color: var(--aegean); letter-spacing: 0.08em; text-transform: uppercase; align-self: center; margin-left: 1px; }

.main-nav { display: flex; align-items: center; gap: 0.15rem; margin-left: auto; }

.nav-link { display: flex; align-items: center; gap: 0.4rem; padding: 0.4rem 0.8rem; border-radius: var(--radius-sm); font-size: 0.875rem; font-weight: 500; color: var(--ink); white-space: nowrap; position: relative; transition: background 0.15s var(--ease), color 0.15s var(--ease); justify-content: center; }
.nav-link:hover { background: var(--sand); color: var(--aegean); }
.nav-link.is-active { color: var(--aegean); background: rgba(26,92,138,0.08); font-weight: 600; }
.nav-link.is-active::after { content: ''; position: absolute; bottom: 3px; left: 50%; transform: translateX(-50%); width: 18px; height: 2px; background: var(--aegean); border-radius: 2px; }
.nav-link--soon { color: var(--muted); pointer-events: none; opacity: 0.55; }
.nav-icon { font-size: 1rem; line-height: 1; }
.badge-soon { font-size: 0.58rem; font-weight: 700; letter-spacing: 0.05em; text-transform: uppercase; background: var(--sand-dark); color: var(--muted); padding: 2px 5px; border-radius: 4px; }

.nav-divider { width: 1px; height: 18px; background: var(--border); margin: 0 0.25rem; flex-shrink: 0; }

.icon-btn { position: relative; display: flex; align-items: center; justify-content: center; width: 32px; height: 32px; border-radius: var(--radius-sm); color: var(--muted); flex-shrink: 0; transition: background 0.15s var(--ease), color 0.15s var(--ease), transform 0.15s var(--ease-spring); }
.icon-btn:hover { background: var(--sand); color: var(--aegean); transform: translateY(-1px); }
.icon-btn.is-active { color: var(--aegean); background: rgba(26,92,138,0.08); }
