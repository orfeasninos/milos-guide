---
import { publicFileExists } from '../lib/public-files';

interface Props {
  src: string;
  alt: string;
  width: number;
  height: number;
  isLCP?: boolean;
  class?: string;
  sizes?: string;
  objectPosition?: string;
}

const {
  src,
  alt,
  width,
  height,
  isLCP = false,
  class: className,
  sizes = '100vw',
  objectPosition,
} = Astro.props;

const WIDTHS = [800, 1200, 1920];

const isExternal = src.startsWith('http://') || src.startsWith('https://') || src.startsWith('//');

const toVariant = (path: string, ext: string, w: number) =>
  path.replace(/\.(jpe?g|png|gif|webp|avif)(\?.*)?$/i, `-${w}w.${ext}$2`);

const toSingleFormat = (path: string, ext: string) =>
  path.replace(/\.(jpe?g|png|gif|webp|avif)(\?.*)?$/i, `.${ext}$2`);

const buildSrcset = (ext: string): string | null => {
  if (isExternal) return null;
  const entries = WIDTHS
    .map(w => ({ w, path: toVariant(src, ext, w) }))
    .filter(({ path }) => publicFileExists(path));
  return entries.length ? entries.map(({ w, path }) => `${path} ${w}w`).join(', ') : null;
};

const avifSrcset = buildSrcset('avif');
const webpSrcset = buildSrcset('webp');

const singleAvifPath = toSingleFormat(src, 'avif');
const singleWebpPath = toSingleFormat(src, 'webp');
const hasSingleAvif = !isExternal && !avifSrcset && publicFileExists(singleAvifPath);
const hasSingleWebp = !isExternal && !webpSrcset && publicFileExists(singleWebpPath);
---

<picture class={className}>
  {avifSrcset && <source type="image/avif" srcset={avifSrcset} sizes={sizes} />}
  {!avifSrcset && hasSingleAvif && <source type="image/avif" srcset={singleAvifPath} />}
  {webpSrcset && <source type="image/webp" srcset={webpSrcset} sizes={sizes} />}
  {!webpSrcset && hasSingleWebp && <source type="image/webp" srcset={singleWebpPath} />}
  <img
    src={src}
    alt={alt}
    width={width}
    height={height}
    loading={isLCP ? 'eager' : 'lazy'}
    fetchpriority={isLCP ? 'high' : undefined}
    decoding={isLCP ? 'sync' : 'async'}
    style={objectPosition ? `object-position:${objectPosition}` : undefined}
  />
</picture>
