---
// SmartImage: responsive WebP/AVIF srcset + format negotiation + zero CLS + smart LCP loading.
// Looks for pre-converted width variants ({name}-800w, -1200w, -1920w) from convert-images.mjs.
// isLCP=true  → loading="eager", fetchpriority="high", decoding="sync"  (above-fold hero)
// isLCP=false → loading="lazy",  decoding="async"                       (everything else)
//
// No <style> block → Astro propagates the parent's scope hash to <picture>.
// Parent scoped CSS targets <picture> directly; Layout.astro handles `picture > img` base styles.

interface Props {
  src: string;
  alt: string;
  width: number;
  height: number;
  isLCP?: boolean;
  class?: string;
  sizes?: string;
  objectPosition?: string;
}

const {
  src,
  alt,
  width,
  height,
  isLCP = false,
  class: className,
  sizes = '100vw',
  objectPosition,
} = Astro.props;

const WIDTHS = [800, 1200, 1920];

const isExternal = src.startsWith('http://') || src.startsWith('https://') || src.startsWith('//');

const toVariant = (path: string, ext: string, w: number) =>
  path.replace(/\.(jpe?g|png|gif|webp|avif)(\?.*)?$/i, `-${w}w.${ext}$2`);

const knownAvif = import.meta.glob('/public/images/**/*-*w.avif', { eager: false });
const knownWebp = import.meta.glob('/public/images/**/*-*w.webp', { eager: false });

const buildSrcset = (known: Record<string, unknown>, ext: string): string | null => {
  if (isExternal) return null;
  const entries = WIDTHS
    .map(w => ({ w, path: toVariant(src, ext, w) }))
    .filter(({ path }) => `/public${path}` in known);
  return entries.length ? entries.map(({ w, path }) => `${path} ${w}w`).join(', ') : null;
};

const avifSrcset = buildSrcset(knownAvif, 'avif');
const webpSrcset = buildSrcset(knownWebp, 'webp');
---

<picture class={className}>
  {avifSrcset && <source type="image/avif" srcset={avifSrcset} sizes={sizes} />}
  {webpSrcset && <source type="image/webp" srcset={webpSrcset} sizes={sizes} />}
  <img
    src={src}
    alt={alt}
    width={width}
    height={height}
    loading={isLCP ? 'eager' : 'lazy'}
    fetchpriority={isLCP ? 'high' : undefined}
    decoding={isLCP ? 'sync' : 'async'}
    style={objectPosition ? `object-position:${objectPosition}` : undefined}
  />
</picture>
