---
import SmartImage from '../SmartImage.astro';
import { getBeachName, type Beach, type BeachAccess } from '../../lib/beaches';

interface Props { beach: Beach; access: BeachAccess }
const { beach, access } = Astro.props;
---
<!-- HERO -->
<div class="b-hero">
  {beach.image ? (
    <SmartImage
      src={beach.image}
      alt={getBeachName(beach)}
      width={1280}
      height={520}
      isLCP={true}
      class="b-hero-img"
      sizes="100vw"
    />
  ) : (
    <div class="b-hero-ph"></div>
  )}
  <div class="b-hero-overlay">
    <div class="container b-hero-inner">
      <a href="/beaches" class="back-link">← All beaches</a>
      <div class="b-hero-meta">
        <div class="b-hero-chips">
          <span class="b-access-chip">{access.icon} {access.label}</span>
          {beach.accessType === 'road' && beach.easyAccess === false && (
            <span class="b-access-chip" style="background:rgba(180,60,0,.45);">⚠️ Rough road</span>
          )}
        </div>
        <h1 class="b-hero-name">{getBeachName(beach)}</h1>
        {beach.location.area && (
          <p class="b-hero-area">
            <span style="color:var(--sky)">◉</span> {beach.location.area}
          </p>
        )}
      </div>
    </div>
  </div>
</div>

<style>
/* ── HERO ── */
.b-hero {
  position: relative;
  height: 520px;
  overflow: hidden;
  background: var(--deep-blue);
}
:global(.b-hero-img) {
  width: 100%;
  height: 100%;
  object-fit: cover;
  display: block;
}
.b-hero-ph {
  width: 100%;
  height: 100%;
  background: linear-gradient(140deg, #0d2b4e, #1a5c8a, #3a9bc9);
}
.b-hero-overlay {
  position: absolute;
  inset: 0;
  background: linear-gradient(to top, rgba(0,0,0,.75) 0%, rgba(0,0,0,.1) 55%, transparent 100%);
  display: flex;
  flex-direction: column;
  justify-content: flex-end;
}
.b-hero-inner { padding-bottom: 2.5rem; }
.back-link {
  position: absolute;
  top: 1.5rem;
  left: 1.5rem;
  font-size: .75rem;
  font-weight: 600;
  letter-spacing: .05em;
  text-transform: uppercase;
  color: #fff;
  background: rgba(0,0,0,.35);
  backdrop-filter: blur(6px);
  padding: .35rem .85rem;
  border-radius: 100px;
  transition: background .15s;
}
.back-link:hover { background: rgba(0,0,0,.55); }
.b-hero-chips {
  display: flex;
  gap: .45rem;
  flex-wrap: wrap;
  margin-bottom: .55rem;
}
.b-access-chip {
  font-size: .62rem;
  font-weight: 600;
  letter-spacing: .04em;
  text-transform: uppercase;
  padding: 3px 10px;
  border-radius: 100px;
  background: rgba(0,0,0,.35);
  border: 1px solid rgba(255,255,255,.22);
  backdrop-filter: blur(6px);
  color: #fff;
}
.b-hero-name {
  font-family: var(--font-serif);
  font-size: clamp(2.2rem, 6vw, 4rem);
  color: #fff;
  line-height: 1.0;
  margin: 0 0 .4rem;
  text-shadow: 0 2px 16px rgba(0,0,0,.4);
}
.b-hero-area {
  font-size: .78rem;
  font-weight: 600;
  text-transform: uppercase;
  letter-spacing: .08em;
  color: rgba(255,255,255,.72);
  margin: 0;
}
@media (max-width: 768px) {
  .b-hero { height: 360px; }
}
@media (max-width: 480px) {
  .b-hero { height: 280px; }
  .b-hero-name { font-size: 2rem; }
}
</style>
