---
import type { Beach, BeachAccess } from '../../lib/beaches';

interface Props { beach: Beach; access: BeachAccess }
const { beach, access } = Astro.props;
---
<!-- Tips block -->
<div class="tips-block">
  <h2 class="block-title">Useful information</h2>
  <div class="tips-grid">

    <!-- Getting there -->
    <div class="tip">
      <span class="tip-icon">{access.icon}</span>
      <div>
        <p class="tip-title">Getting there</p>
        <p class="tip-body">
          {beach.accessType === 'road' && (beach.easyAccess
            ? 'Paved road all the way — easy to reach by car or motorbike.'
            : 'The last stretch is a rough dirt road. A high-clearance vehicle or motorbike is recommended.')}
          {beach.accessType === 'hike' && 'Requires a hike over rough terrain. Wear sturdy footwear and bring plenty of water.'}
          {beach.accessType === 'boat' && 'Only reachable by sea. Book a daily boat tour from Adamas harbour, or arrive by private boat.'}
        </p>
      </div>
    </div>

    <!-- What to bring -->
    <div class="tip">
      <span class="tip-icon">🎒</span>
      <div>
        <p class="tip-title">What to bring</p>
        <p class="tip-body">
          {beach.facilities.includes('sunbeds')
            ? 'Sunbeds and umbrellas are available on site.'
            : 'No beach facilities — pack your umbrella, towels, snacks, and plenty of water.'}
        </p>
      </div>
    </div>

    <!-- Food nearby -->
    <div class="tip">
      <span class="tip-icon">🍽️</span>
      <div>
        <p class="tip-title">Food & drinks</p>
        <p class="tip-body">
          {beach.nearbyFood
            ? 'Tavernas or cafés are available nearby — no need to pack a full lunch.'
            : 'No food or drinks nearby — bring everything you need before heading down.'}
        </p>
      </div>
    </div>

    <!-- Crowds -->
    <div class="tip">
      <span class="tip-icon">👥</span>
      <div>
        <p class="tip-title">Crowds</p>
        <p class="tip-body">
          {beach.accessType === 'boat'
            ? 'Only accessible by boat — stays naturally uncrowded and pristine year-round.'
            : beach.accessType === 'hike'
              ? 'The trail keeps visitor numbers low — expect peace and quiet even in peak season.'
              : beach.easyAccess
                ? 'Popular in July and August — arrive early in the morning to secure a good spot.'
                : 'The rough road keeps crowds away — usually quiet even in high season.'}
        </p>
      </div>
    </div>

    <!-- Parking (road only) -->
    {beach.accessType === 'road' && (
      <div class="tip">
        <span class="tip-icon">🅿️</span>
        <div>
          <p class="tip-title">Parking</p>
          <p class="tip-body">
            {beach.facilities.includes('parking')
              ? 'Free parking area available near the beach.'
              : 'No dedicated car park — park along the roadside near the access path.'}
          </p>
        </div>
      </div>
    )}

    <!-- Boat tours note -->
    {beach.accessType === 'boat' && (
      <div class="tip">
        <span class="tip-icon">🗺️</span>
        <div>
          <p class="tip-title">Boat tours</p>
          <p class="tip-body">Most organised day tours from Adamas include this beach as a stop. Check departure times at the port.</p>
        </div>
      </div>
    )}

    <!-- Swimming note -->
    <div class="tip">
      <span class="tip-icon">🏊</span>
      <div>
        <p class="tip-title">Swimming</p>
        <p class="tip-body">
          {beach.bestFor?.includes('Swimming')
            ? 'A great spot for a swim — conditions are generally suitable for most swimmers.'
            : 'This beach is not particularly recommended for swimming — it\'s best enjoyed for its scenery and atmosphere.'}
        </p>
      </div>
    </div>

    <!-- Water depth -->
    <div class="tip">
      <span class="tip-icon">📏</span>
      <div>
        <p class="tip-title">Water depth</p>
        <p class="tip-body">
          {beach.swimDepth === 'Shallow' && 'Shallow waters — ideal for children and non-swimmers.'}
          {beach.swimDepth === 'Moderate' && 'Moderate depth — comfortable for most swimmers.'}
          {beach.swimDepth === 'Deep' && 'Deep waters — not suitable for young children; best for confident swimmers.'}
        </p>
      </div>
    </div>

    <!-- Beach surface -->
    <div class="tip">
      <span class="tip-icon">🏖️</span>
      <div>
        <p class="tip-title">Beach surface</p>
        <p class="tip-body">
          {beach.sandType === 'Sand' && 'Soft sandy beach — comfortable for barefoot walking.'}
          {beach.sandType === 'Pebble' && 'Pebbly beach — water shoes are recommended for comfort.'}
          {beach.sandType === 'Volcanic rock' && 'Volcanic rock surface — water shoes are essential.'}
          {beach.sandType === 'Village waterfront' && 'Village waterfront — not a traditional sandy beach, but a charming setting.'}
        </p>
      </div>
    </div>

    <!-- Shade -->
    <div class="tip">
      <span class="tip-icon">⛱️</span>
      <div>
        <p class="tip-title">Shade</p>
        <p class="tip-body">
          {beach.shade
            ? 'Natural shade is available from rocks or cliffs — a welcome relief on hot days.'
            : 'No natural shade — bring your own umbrella or sunshade.'}
        </p>
      </div>
    </div>

  </div>
</div>

<style>
.tips-block { margin-bottom: 1rem; }
.block-title {
  font-size: .65rem;
  font-weight: 700;
  letter-spacing: .12em;
  text-transform: uppercase;
  color: var(--muted);
  margin-bottom: 1rem;
}
.tips-grid {
  display: flex;
  flex-direction: column;
  gap: 0;
  border: 1px solid var(--border);
  border-radius: var(--radius-md);
  overflow: hidden;
}
.tip {
  display: flex;
  align-items: flex-start;
  gap: 1rem;
  padding: 1.1rem 1.25rem;
  border-bottom: 1px solid var(--border);
  background: var(--white);
}
.tip:last-child { border-bottom: none; }
.tip:nth-child(even) { background: var(--sand); }
.tip-icon { font-size: 1.1rem; flex-shrink: 0; margin-top: .1rem; }
.tip-title { font-size: .78rem; font-weight: 600; color: var(--muted); text-transform: uppercase; letter-spacing: .06em; margin-bottom: .2rem; }
.tip-body { font-size: .9rem; color: var(--ink); margin: 0; line-height: 1.5; }
</style>
