---
import beachesRaw from "../../data/beaches.json";

type Beach = (typeof beachesRaw)[number];

const beachesData = beachesRaw as Beach[];

const accessIcon: Record<string, string> = {
  road: "🚗",
  boat: "⛵",
  hike: "🥾",
};

const beachCategories = [
  {
    title: "With kids",
    note: "Shallow water and an easy walk from the car",
    filter: (b: Beach) => b.bestFor.includes("Families"),
  },
  {
    title: "For the photos",
    note: "Go early, before the light flattens out",
    filter: (b: Beach) => b.bestFor.includes("Photography"),
  },
  {
    title: "Quiet ones",
    note: "Rough roads keep the crowds away",
    filter: (b: Beach) => b.bestFor.includes("Solitude"),
  },
  {
    title: "Only by boat",
    note: "On the Kleftiko day trips",
    filter: (b: Beach) => b.accessType === "boat",
  },
].map((cat) => ({
  ...cat,
  beaches: beachesData.filter(cat.filter).slice(0, 3),
}));
---
<!-- ══ BEACHES BY TYPE ══ -->
<section class="sec sec-sand">
  <div class="container">
    <div class="sec-hdr-row">
      <div>
        <span class="label">Beaches</span>
        <h2 class="sec-title">Pick a beach by what you want from it</h2>
      </div>
      <div class="bt-links">
        <a href="/map/" class="see-all" data-umami-event="home-beaches-map">On the map →</a>
        <a href="/beaches/" class="see-all">All {beachesData.length} beaches →</a>
      </div>
    </div>
    <div class="beach-cat-grid">
      {
        beachCategories.map((cat) => (
          <div class="beach-cat">
            <h3 class="beach-cat-title">{cat.title}</h3>
            <p class="beach-cat-note">{cat.note}</p>
            <div class="beach-cat-list">
              {cat.beaches.map((b) => (
                <a href={`/beaches/${b.slug}/`} class="beach-link">
                  <span class="beach-link-icon">
                    {accessIcon[b.accessType] ?? "📍"}
                  </span>
                  {typeof b.name === "object" ? b.name.en : b.name}
                </a>
              ))}
            </div>
          </div>
        ))
      }
    </div>
  </div>
</section>

<style>
  .bt-links {
    display: flex;
    gap: 1.25rem;
    flex-wrap: wrap;
  }
  .beach-cat-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1.5rem;
  }
  .beach-cat {
    border-top: 2px solid var(--deep-blue);
    padding-top: 1.25rem;
  }
  .beach-cat-title {
    font-family: var(--font-serif);
    font-size: 1.1rem;
    font-weight: 400;
    color: var(--deep-blue);
  }
  .beach-cat-note {
    font-size: 0.82rem;
    color: var(--muted);
    margin: 0.2rem 0 0.75rem;
  }
  .beach-cat-list {
    display: flex;
    flex-direction: column;
    gap: 0.1rem;
  }
  .beach-link {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    padding: 0.5rem 0;
    border-bottom: 1px solid var(--border);
    font-size: 0.9rem;
    color: var(--ink);
    transition:
      color 0.15s,
      padding-left 0.15s;
  }
  .beach-link:hover {
    color: var(--aegean);
    padding-left: 0.4rem;
  }
  .beach-link-icon {
    font-size: 0.8rem;
    color: var(--muted);
    flex-shrink: 0;
  }
  @media (max-width: 900px) {
    .beach-cat-grid {
      grid-template-columns: 1fr 1fr;
    }
  }
  @media (max-width: 560px) {
    .beach-cat-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
