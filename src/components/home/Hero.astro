---
import SmartImage from '../SmartImage.astro';
---
<!-- ══ HERO ══ -->
<section class="hero">
  <div class="hero-bg">
    <SmartImage
      src="/images/hero-beach.jpg"
      alt="Milos beach"
      width={1280}
      height={720}
      isLCP={true}
      class="hero-photo"
      sizes="100vw"
      objectPosition="center 55%"
    />
    <div class="hero-photo-overlay"></div>
    <div class="hero-grain" aria-hidden="true"></div>
  </div>

  <div class="hero-content container">
    <div class="hero-eyebrow">
      <svg
        class="eyebrow-pin"
        width="11"
        height="11"
        viewBox="0 0 24 24"
        fill="currentColor"
        aria-hidden="true"
      >
        <path
          d="M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7zm0 9.5c-1.38 0-2.5-1.12-2.5-2.5s1.12-2.5 2.5-2.5 2.5 1.12 2.5 2.5-1.12 2.5-2.5 2.5z"
        ></path>
      </svg>
      <span>Cyclades · Greece</span>
      <span class="eyebrow-sep" aria-hidden="true"></span>
      <span class="eyebrow-tag">Volcanic island</span>
    </div>
    <div class="hero-title">
      <span class="hero-title-main">Milos</span>
      <span class="hero-title-rule" aria-hidden="true"></span>
      <span class="hero-title-sub"
        >The most authentic guide to the island</span
      >
    </div>
    <p class="hero-desc">
      Volcanic landscape, 70+ beaches, hidden sea caves, tavernas with freshly
      caught seafood. Everything you need to experience Milos the right way.
    </p>
    <div class="hero-ctas">
      <a href="/beaches" class="btn-primary">🏖 Beaches</a>
      <a href="/sights" class="btn-secondary">🏛 Sights</a>
      <a href="/map" class="hero-cta-ghost">Map →</a>
    </div>
    <div class="hero-no-ads">
      <span class="hero-no-ads-dot" aria-hidden="true"></span>
      No ads · No sponsored content
    </div>
  </div>

  <div class="hero-stats container">
    <div class="stat-pill">
      <span class="stat-n">70+</span><span class="stat-l">Beaches</span>
    </div>
    <div class="stat-pill">
      <span class="stat-n">151</span><span class="stat-l">km²</span>
    </div>
    <div class="stat-pill">
      <span class="stat-n">125</span><span class="stat-l">km coastline</span>
    </div>
    <div class="stat-pill">
      <span class="stat-n">~5,000</span><span class="stat-l">Residents</span>
    </div>
  </div>

  <div class="hero-waves" aria-hidden="true">
    <svg
      viewBox="0 0 1440 100"
      preserveAspectRatio="none"
      xmlns="http://www.w3.org/2000/svg"
    >
      <path d="M0,40 C360,90 1080,0 1440,50 L1440,100 L0,100 Z" fill="#f5f0e8"
      ></path>
    </svg>
  </div>
  <div class="scroll-hint" aria-hidden="true">
    <svg
      width="28"
      height="28"
      viewBox="0 0 28 28"
      fill="none"
      xmlns="http://www.w3.org/2000/svg"
    >
      <polyline
        points="6,10 14,19 22,10"
        stroke="rgba(255,255,255,0.6)"
        stroke-width="2.2"
        stroke-linecap="round"
        stroke-linejoin="round"></polyline>
    </svg>
  </div>
</section>

<style>
  .hero {
    position: relative;
    min-height: 92vh;
    display: flex;
    flex-direction: column;
    justify-content: center;
    overflow: hidden;
  }
  .hero-bg {
    position: absolute;
    inset: 0;
    z-index: 0;
    background: #061526;
  }
  :global(.hero-photo) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
  .hero-photo-overlay {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(
        to right,
        rgba(4, 14, 30, 0.93) 0%,
        rgba(5, 18, 38, 0.8) 30%,
        rgba(5, 18, 38, 0.32) 65%,
        rgba(5, 18, 38, 0.1) 100%
      ),
      linear-gradient(to top, rgba(4, 14, 30, 0.8) 0%, transparent 45%),
      linear-gradient(to bottom, rgba(4, 14, 30, 0.35) 0%, transparent 22%);
  }
  .hero-grain {
    position: absolute;
    inset: 0;
    pointer-events: none;
    z-index: 1;
    opacity: 0.04;
    background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 256 256' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.85' numOctaves='4' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)'/%3E%3C/svg%3E");
    background-size: 256px 256px;
  }
  .hero-content {
    position: relative;
    z-index: 2;
    padding: 4.5rem 0 2rem;
  }
  /* Eyebrow */
  .hero-eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    font-size: 0.68rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.58);
    margin-bottom: 1.6rem;
    animation: fadeUp 0.7s ease both;
    background: rgba(255, 255, 255, 0.07);
    border: 1px solid rgba(255, 255, 255, 0.13);
    padding: 0.32rem 0.85rem 0.32rem 0.55rem;
    border-radius: var(--radius-full);
    backdrop-filter: blur(10px);
  }
  .eyebrow-pin {
    color: var(--sea);
    flex-shrink: 0;
  }
  .eyebrow-sep {
    display: inline-block;
    width: 1px;
    height: 10px;
    background: rgba(255, 255, 255, 0.22);
    margin: 0 0.1rem;
  }
  .eyebrow-tag {
    color: var(--sky);
    opacity: 0.75;
  }
  /* Title */
  .hero-title {
    margin-bottom: 1.6rem;
    animation: fadeUp 0.7s ease 0.1s both;
  }
  .hero-title-main {
    display: block;
    font-family: var(--font-serif);
    font-size: clamp(4.5rem, 12vw, 9.5rem);
    color: #fff;
    line-height: 0.88;
    letter-spacing: -0.025em;
    text-shadow:
      0 2px 40px rgba(0, 0, 0, 0.35),
      0 0 100px rgba(58, 155, 201, 0.12);
  }
  .hero-title-rule {
    display: block;
    width: 56px;
    height: 2px;
    background: linear-gradient(
      90deg,
      var(--sea) 0%,
      rgba(58, 155, 201, 0.2) 100%
    );
    border-radius: 2px;
    margin: 0.9rem 0 0.7rem;
  }
  .hero-title-sub {
    display: block;
    font-size: clamp(0.9rem, 2vw, 1.12rem);
    font-weight: 400;
    color: rgba(255, 255, 255, 0.58);
    letter-spacing: 0.025em;
  }
  /* Description */
  .hero-desc {
    max-width: 490px;
    font-size: 1.02rem;
    line-height: 1.76;
    color: rgba(255, 255, 255, 0.66);
    margin-bottom: 2rem;
    animation: fadeUp 0.7s ease 0.2s both;
  }
  /* CTAs */
  .hero-ctas {
    display: flex;
    gap: 0.85rem;
    flex-wrap: wrap;
    align-items: center;
    animation: fadeUp 0.7s ease 0.3s both;
  }
  .hero-cta-ghost {
    font-size: 0.875rem;
    font-weight: 600;
    color: rgba(255, 255, 255, 0.48);
    border-bottom: 1px solid rgba(255, 255, 255, 0.18);
    padding-bottom: 1px;
    margin-left: 0.2rem;
    transition:
      color 0.15s,
      border-color 0.15s;
  }
  .hero-cta-ghost:hover {
    color: rgba(255, 255, 255, 0.85);
    border-color: rgba(255, 255, 255, 0.45);
  }
  /* No-ads badge */
  .hero-no-ads {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    margin-top: 1.6rem;
    font-size: 0.64rem;
    font-weight: 600;
    letter-spacing: 0.11em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.25);
    animation: fadeUp 0.7s ease 0.38s both;
  }
  .hero-no-ads-dot {
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background: var(--sea);
    opacity: 0.6;
    flex-shrink: 0;
  }
  /* Stats */
  .hero-stats {
    position: relative;
    z-index: 2;
    display: flex;
    gap: 0.75rem;
    flex-wrap: wrap;
    padding-top: 2.5rem;
    padding-bottom: 5.5rem;
    animation: fadeUp 0.7s ease 0.45s both;
  }
  .stat-pill {
    display: flex;
    flex-direction: column;
    gap: 0.1rem;
    padding: 0.75rem 1.3rem;
    background: rgba(255, 255, 255, 0.07);
    border: 1px solid rgba(255, 255, 255, 0.12);
    border-top-color: rgba(58, 155, 201, 0.35);
    border-radius: var(--radius-md);
    backdrop-filter: blur(14px);
    transition:
      background 0.2s,
      border-color 0.2s;
  }
  .stat-pill:hover {
    background: rgba(255, 255, 255, 0.11);
  }
  .stat-n {
    font-family: var(--font-serif);
    font-size: 1.7rem;
    color: #fff;
    line-height: 1;
  }
  .stat-l {
    font-size: 0.65rem;
    font-weight: 500;
    color: rgba(255, 255, 255, 0.4);
    text-transform: uppercase;
    letter-spacing: 0.07em;
  }
  .hero-waves {
    position: absolute;
    bottom: -1px;
    left: 0;
    right: 0;
    height: 100px;
    z-index: 1;
  }
  .hero-waves svg {
    width: 100%;
    height: 100%;
    display: block;
  }
  .scroll-hint {
    position: absolute;
    bottom: 5rem;
    left: 50%;
    transform: translateX(-50%);
    z-index: 2;
    display: flex;
    align-items: center;
    justify-content: center;
    animation: scrollBounce 1.8s ease-in-out infinite;
  }
  @media (max-width: 480px) {
    .hero-ctas {
      flex-direction: column;
    }
  }
  @keyframes scrollBounce {
    0%,
    100% {
      transform: translateX(-50%) translateY(0);
      opacity: 0.55;
    }
    50% {
      transform: translateX(-50%) translateY(8px);
      opacity: 1;
    }
  }
  @keyframes fadeUp {
    from {
      opacity: 0;
      transform: translateY(22px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }
</style>
