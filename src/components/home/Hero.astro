---
import SmartImage from '../SmartImage.astro';
import { months } from '../../lib/climate';

// Month in Milos time at build. The deploy cron rebuilds four times a day, so this rolls
// over to the new month within hours. Averages, not a live reading: a cached "now" could
// be six hours old by the time someone sees it.
const monthSlug = new Date().toLocaleString('en', { timeZone: 'Europe/Athens', month: 'long' }).toLowerCase();
const month = months.find(m => m.slug === monthSlug);
---
<!-- ══ HERO ══ -->
<!-- Kept shorter than a full screen on purpose, so the live wind box starts above the
     fold and gives people a reason to scroll. -->
<section class="hero">
  <SmartImage
    src="/images/hero-beach.jpg"
    alt="Turquoise water and pale volcanic rock on the coast of Milos"
    width={1280}
    height={720}
    isLCP={true}
    class="hero-photo"
    sizes="100vw"
    objectPosition="center 55%"
  />
  <div class="hero-shade" aria-hidden="true"></div>

  <div class="hero-content container">
    <p class="hero-kicker">Milos, Cyclades</p>
    <!-- "Milos guide" in the H1 is the brand query, so keep the two words together. -->
    <h1 class="hero-title">Milos guide</h1>
    <p class="hero-desc">
      Milos has more than 70 beaches, and on a windy day half of them are too rough to
      swim. Check which ones are calm right now, then plan the rest: where to stay,
      what to rent, where to eat.
    </p>
    <div class="hero-ctas">
      <a href="#today" class="btn-primary" data-umami-event="home-hero-today">Where to swim today ↓</a>
      <a href="#first-time" class="btn-secondary" data-umami-event="home-hero-first-time">First time in Milos?</a>
      <a href="/map/" class="hero-link" data-umami-event="home-hero-map">Beach map →</a>
    </div>
    {month && (
      <a href={`/weather/${month.slug}/`} class="hero-month" data-umami-event="home-hero-month">
        <span class="hero-month-name">A typical {month.name}</span>
        <span>{month.hi}° by day</span>
        <span>sea {month.sea}°</span>
        <span>{month.rainDays} rainy {month.rainDays === 1 ? 'day' : 'days'}</span>
      </a>
    )}
  </div>
</section>

<style>
  .hero {
    position: relative;
    min-height: min(78vh, 720px);
    display: flex;
    align-items: flex-end;
    overflow: hidden;
    background: #061526;
  }
  :global(.hero-photo) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
  .hero-shade {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(to top, rgba(4, 14, 30, 0.88) 0%, rgba(4, 14, 30, 0.35) 55%, rgba(4, 14, 30, 0.15) 100%),
      linear-gradient(to right, rgba(4, 14, 30, 0.55) 0%, transparent 60%);
  }
  .hero-content {
    position: relative;
    padding-top: 6rem;
    padding-bottom: 3.5rem;
  }
  .hero-kicker {
    font-size: 0.8rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--sky);
    margin-bottom: 0.75rem;
  }
  .hero-title {
    font-family: var(--font-serif);
    /* DM Serif Display has no bold. */
    font-weight: 400;
    font-size: clamp(3.2rem, 9vw, 6.5rem);
    line-height: 0.95;
    letter-spacing: -0.02em;
    color: #fff;
    margin-bottom: 1.25rem;
    text-shadow: 0 2px 30px rgba(0, 0, 0, 0.3);
  }
  .hero-desc {
    max-width: 34rem;
    font-size: 1.1rem;
    line-height: 1.6;
    color: rgba(255, 255, 255, 0.86);
    margin-bottom: 1.75rem;
  }
  .hero-ctas {
    display: flex;
    gap: 0.75rem;
    flex-wrap: wrap;
    align-items: center;
  }
  .hero-link {
    font-size: 0.9rem;
    font-weight: 600;
    color: rgba(255, 255, 255, 0.8);
    padding: 0.5rem 0.25rem;
  }
  .hero-link:hover {
    color: #fff;
  }
  .hero-month {
    display: inline-flex;
    flex-wrap: wrap;
    gap: 0.35rem 0.9rem;
    margin-top: 2rem;
    font-size: 0.85rem;
    color: rgba(255, 255, 255, 0.75);
  }
  .hero-month-name {
    font-weight: 700;
    color: #fff;
  }
  .hero-month:hover span {
    color: #fff;
  }
  @media (max-width: 480px) {
    .hero-desc {
      font-size: 1rem;
    }
    .hero-ctas a {
      flex: 1 1 100%;
      justify-content: center;
    }
  }
</style>
