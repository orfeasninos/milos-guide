---
import { areaNotes, stays } from '../../lib/stays';
import { RADICAL_STORAGE_URL } from '../../lib/radicalstorage';
import { bookingSearch } from '../../lib/booking';
import { areaVillageSlug } from '../../lib/restaurants';
import restaurantsData from '../../data/restaurants.json';

// Same three areas and notes as /stays/, each with its own Booking.com search so the
// CJ report shows which homepage area people clicked.
const areas = Object.entries(areaNotes).map(([area, note]) => ({
  area,
  note,
  village: areaVillageSlug(area),
  url: bookingSearch(area, `home-stay-${area.toLowerCase()}`),
  // The guide's own listings in that area, best rated first. These link to our stay
  // pages (which carry their own Booking links) rather than straight out.
  picks: stays
    .filter(s => s.location.area === area)
    .sort((a, b) => (b.rating ?? 0) - (a.rating ?? 0))
    .slice(0, 2),
}));
---
<!-- ══ PLAN THE TRIP ══ -->
<section class="sec sec-white">
  <div class="container">
    <div class="sec-hdr-row">
      <div>
        <span class="label">Before you book</span>
        <h2 class="sec-title">Where to stay</h2>
        <p class="sec-sub">Three bases, and the island is small enough that any of them works with a car.</p>
      </div>
      <a href="/stays/" class="see-all">Hotels, studios & villas →</a>
    </div>

    <div class="stay-areas">
      {areas.map(a => (
        <div class="stay-area">
          <h3 class="stay-name">
            {a.village ? <a href={`/villages/${a.village}/`}>{a.area}</a> : a.area}
          </h3>
          <p class="stay-note">{a.note}</p>
          {a.picks.length > 0 && (
            <ul class="stay-picks">
              {a.picks.map(p => (
                <li>
                  <a href={`/stays/${p.slug}/`} data-umami-event="home-stay-pick" data-umami-event-stay={p.slug}>{p.name.en}</a>
                  {p.rating && <span class="stay-rating">★ {p.rating}</span>}
                </li>
              ))}
            </ul>
          )}
          <a
            href={a.url}
            target="_blank"
            rel="noopener sponsored"
            class="stay-cta"
            data-umami-event="booking-home-area"
            data-umami-event-area={a.area.toLowerCase()}
          >See places in {a.area} ↗</a>
        </div>
      ))}
    </div>
    

    <div class="plan-more">
      <a href="/car-rental/" class="plan-card" data-umami-event="home-plan-car">
        <span class="plan-q">Do I need a car?</span>
        <span class="plan-a">Almost certainly. The bus misses most of the good beaches. Car, ATV or scooter compared.</span>
      </a>
      <a href="/how-to-reach/" class="plan-card" data-umami-event="home-plan-reach">
        <span class="plan-q">Ferry or plane?</span>
        <span class="plan-a">Ferries from Piraeus take 3.5 to 7 hours, the flight from Athens about 40 minutes. Routes and tips.</span>
      </a>
      <a href="/restaurants/" class="plan-card" data-umami-event="home-plan-food">
        <span class="plan-q">Where to eat?</span>
        <span class="plan-a">{restaurantsData.length} tavernas and cafés, from fish by the harbour in Pollonia to dinner in Plaka.</span>
      </a>
      <a
        href={RADICAL_STORAGE_URL}
        target="_blank"
        rel="noopener sponsored"
        class="plan-card"
        data-umami-event="radicalstorage"
        data-umami-event-placement="home"
      >
        <span class="plan-q plan-q--out">Late ferry home?</span>
        <span class="plan-a">Most rooms want you out by 11, many ferries leave in the afternoon or evening. Drop your bags and keep swimming.</span>
      </a>
    </div>
    <p class="aff-note">Booking.com and luggage storage links are affiliate links: we may earn a commission, at no extra cost to you.</p>
  </div>
</section>

<style>
  .stay-areas {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1rem;
  }
  .stay-area {
    background: var(--sand);
    border-radius: var(--radius-md);
    padding: 1.5rem;
    display: flex;
    flex-direction: column;
  }
  .stay-name {
    font-family: var(--font-serif);
    font-weight: 400;
    font-size: 1.4rem;
    color: var(--deep-blue);
    margin-bottom: 0.5rem;
  }
  .stay-name a:hover {
    color: var(--aegean);
  }
  .stay-note {
    font-size: 0.9rem;
    line-height: 1.6;
    color: #374151;
    margin-bottom: 1rem;
    flex: 1;
  }
  .stay-picks {
    list-style: none;
    margin-bottom: 1.25rem;
    font-size: 0.85rem;
  }
  .stay-picks li {
    display: flex;
    justify-content: space-between;
    gap: 0.5rem;
    padding: 0.4rem 0;
    border-top: 1px solid var(--border);
  }
  .stay-picks a {
    font-weight: 600;
    color: var(--ink);
  }
  .stay-picks a:hover {
    color: var(--aegean);
  }
  .stay-rating {
    color: var(--muted);
    white-space: nowrap;
  }
  .stay-cta {
    align-self: flex-start;
    font-size: 0.88rem;
    font-weight: 600;
    color: #fff;
    background: var(--deep-blue);
    padding: 0.6rem 1.1rem;
    border-radius: var(--radius-sm);
    transition: background 0.15s;
  }
  .stay-cta:hover {
    background: var(--aegean);
  }
  .aff-note {
    margin-top: 0.75rem;
    font-size: 0.75rem;
    color: var(--muted);
  }
  .plan-more {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1.5rem;
    margin-top: 3rem;
  }
  .plan-card {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
    padding: 1.25rem 0 0;
    border-top: 1px solid rgba(0, 0, 0, 0.15);
    color: inherit;
  }
  .plan-q {
    font-family: var(--font-serif);
    font-size: 1.25rem;
    color: var(--ink);
    transition: color 0.15s;
  }
  .plan-q::after {
    content: ' →';
    color: var(--sea);
  }
  .plan-q--out::after {
    content: ' ↗';
  }
  .plan-card:hover .plan-q {
    color: var(--aegean);
  }
  .plan-a {
    font-size: 0.88rem;
    line-height: 1.6;
    color: var(--muted);
  }
  @media (max-width: 900px) {
    .stay-areas {
      grid-template-columns: 1fr;
    }
    .plan-more {
      grid-template-columns: 1fr 1fr;
    }
  }
  @media (max-width: 560px) {
    .plan-more {
      grid-template-columns: 1fr;
    }
  }
</style>
