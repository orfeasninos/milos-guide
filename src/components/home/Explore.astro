---
import beachesData from '../../data/beaches.json';
import sightsData from '../../data/sights.json';
import villagesData from '../../data/villages.json';
---
<!-- ══ EXPLORE ══ -->
<section class="sec sec-sand" style="padding-top:3.5rem">
  <div class="container">
    <div class="explore-head">
      <span class="label" style="margin:0">Explore</span>
      <span class="explore-head-title"
        >What do you want to discover in Milos?</span
      >
    </div>
    <div class="cat-list">
      <a href="/beaches" class="cat-row">
        <span class="cat-num">1</span>
        <div class="cat-info">
          <span class="cat-name">Beaches</span>
          <span class="cat-desc"
            >From the volcanic Sarakiniko to hidden sea caves — {
              beachesData.length
            }+ shores for every taste</span
          >
        </div>
        <span class="cat-count">{beachesData.length} beaches</span>
        <span class="cat-arrow">→</span>
      </a>

      <a href="/villages" class="cat-row">
        <span class="cat-num">2</span>
        <div class="cat-info">
          <span class="cat-name">Villages</span>
          <span class="cat-desc"
            >Plaka, Klima, Tripiti, Pollonia — the island beyond the beaches</span
          >
        </div>
        <span class="cat-count">{villagesData.length} villages</span>
        <span class="cat-arrow">→</span>
      </a>

      <a href="/sights" class="cat-row">
        <span class="cat-num">3</span>
        <div class="cat-info">
          <span class="cat-name">Sights</span>
          <span class="cat-desc"
            >Catacombs, ancient theater, Kastro, museums — 2,500 years of
            history on a volcanic island</span
          >
        </div>
        <span class="cat-count">{sightsData.length} sights</span>
        <span class="cat-arrow">→</span>
      </a>

      <a href="/how-to-reach" class="cat-row">
        <span class="cat-num">4</span>
        <div class="cat-info">
          <span class="cat-name">Getting here</span>
          <span class="cat-desc"
            >Ferries from Piraeus, flights, how to get around the island</span
          >
        </div>
        <span class="cat-count">All routes</span>
        <span class="cat-arrow">→</span>
      </a>
    </div>
  </div>
</section>

<style>
  .explore-head {
    display: flex;
    align-items: baseline;
    gap: 1.5rem;
    margin-bottom: 3.5rem;
    border-bottom: 1px solid rgba(0, 0, 0, 0.1);
    padding-bottom: 1.25rem;
  }
  .explore-head-title {
    font-family: var(--font-serif);
    font-size: clamp(1.1rem, 2vw, 1.35rem);
    color: var(--ink);
    font-weight: 400;
  }
  .cat-list {
    display: flex;
    flex-direction: column;
  }
  .cat-row {
    display: grid;
    grid-template-columns: 80px 1fr auto auto;
    align-items: center;
    gap: 2rem;
    padding: 1.75rem 0;
    border-bottom: 1px solid rgba(0, 0, 0, 0.08);
    color: inherit;
    position: relative;
    transition: padding-left 0.3s ease;
  }
  .cat-row::before {
    content: "";
    position: absolute;
    left: 0;
    top: 0;
    bottom: 0;
    width: 0;
    background: var(--deep-blue);
    transition: width 0.3s ease;
    border-radius: 0 2px 2px 0;
  }
  .cat-row:hover {
    padding-left: 1rem;
  }
  .cat-row:hover::before {
    width: 3px;
  }
  .cat-num {
    font-family: var(--font-serif);
    font-size: clamp(2.5rem, 5vw, 3.8rem);
    color: rgba(0, 0, 0, 0.1);
    line-height: 1;
    transition: color 0.3s;
    user-select: none;
  }
  .cat-row:hover .cat-num {
    color: var(--deep-blue);
  }
  .cat-info {
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
  }
  .cat-name {
    font-family: var(--font-serif);
    font-size: clamp(1.5rem, 3vw, 2.2rem);
    color: var(--ink);
    line-height: 1.1;
    transition: color 0.3s;
  }
  .cat-row:hover .cat-name {
    color: var(--deep-blue);
  }
  .cat-desc {
    font-size: 0.875rem;
    color: var(--muted);
    line-height: 1.55;
    max-width: 430px;
  }
  .cat-count {
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--muted);
    white-space: nowrap;
  }
  .cat-arrow {
    font-size: 1.4rem;
    color: rgba(0, 0, 0, 0.15);
    transition:
      color 0.3s,
      transform 0.3s;
  }
  .cat-row:hover .cat-arrow {
    color: var(--deep-blue);
    transform: translateX(6px);
  }
  @media (max-width: 768px) {
    .cat-row {
      grid-template-columns: 50px 1fr auto;
      gap: 1rem;
    }
    .cat-arrow {
      display: none;
    }
    .cat-num {
      font-size: 2rem;
    }
    .cat-name {
      font-size: 1.4rem;
    }
    .cat-desc {
      display: none;
    }
  }
</style>
