---
import Layout from '../layouts/Layout.astro';
import tavernsRaw from '../data/taverns.json';
import beachesRaw from '../data/beaches.json';
import accommodationsData from '../data/accommodations.json';

type Tavern = typeof tavernsRaw[number] & { localPhoto?: string | null };
type Beach  = typeof beachesRaw[number] & { localPhoto?: string | null };

const tavernsData = tavernsRaw as Tavern[];
const beachesData = beachesRaw as Beach[];

const featuredTaverns = [...tavernsData]
  .filter(t => t.isFeatured)
  .sort((a, b) => b.rating - a.rating)
  .slice(0, 3);

const getName    = (t: Tavern) => typeof t.name === 'object' ? (t.name as any).el : t.name as string;
const getCuisine = (t: Tavern) => typeof t.cuisine === 'object' && !Array.isArray(t.cuisine) ? (t.cuisine as any).el : (t.cuisine as any)?.[0] ?? '';
---

<Layout
  lang="en"
  title="The Complete Guide to Milos"
  description="Beaches, restaurants, villages, boat tours — the most complete guide to Milos, Greece. No ads."
>

<!-- ══ HERO ══ -->
<section class="hero">
  <div class="hero-bg">
    <img src="/images/hero-beach.jpg" alt="Milos beach" class="hero-photo" fetchpriority="high" />
    <div class="hero-photo-overlay"></div>
  </div>

  <div class="hero-content container">
    <div class="hero-eyebrow">
      <span class="eyedot"></span>
      <span>Cyclades · Greece · 151 km²</span>
    </div>
    <div class="hero-title">
      <span class="hero-title-main">Milos</span>
      <span class="hero-title-sub">The most authentic guide to the island</span>
    </div>
    <p class="hero-desc">
      Volcanic landscape, 70+ beaches, hidden sea caves, tavernas with freshly caught seafood.
      Everything you need to experience Milos the right way — no ads.
    </p>
    <div class="hero-ctas">
      <a href="/beaches" class="btn-primary">🏖 Beaches</a>
      <a href="/eat"     class="btn-secondary">🍽 Food</a>
    </div>
  </div>

  <div class="hero-stats container">
    <div class="stat-pill"><span class="stat-n">70+</span><span class="stat-l">Beaches</span></div>
    <div class="stat-pill"><span class="stat-n">151</span><span class="stat-l">km²</span></div>
    <div class="stat-pill"><span class="stat-n">125</span><span class="stat-l">km coastline</span></div>
    <div class="stat-pill"><span class="stat-n">~5,000</span><span class="stat-l">Residents</span></div>
  </div>

  <div class="hero-waves" aria-hidden="true">
    <svg viewBox="0 0 1440 100" preserveAspectRatio="none" xmlns="http://www.w3.org/2000/svg">
      <path d="M0,40 C360,90 1080,0 1440,50 L1440,100 L0,100 Z" fill="#f5f0e8"/>
    </svg>
  </div>
  <div class="scroll-hint" aria-hidden="true">
    <span>scroll</span><div class="scroll-line"></div>
  </div>
</section>


<!-- ══ EXPLORE ══ -->
<section class="sec sec-sand" style="padding-top:3.5rem">
  <div class="container">
    <div class="explore-head">
      <span class="label" style="margin:0">Explore</span>
      <span class="explore-head-title">What do you want to discover in Milos?</span>
    </div>
    <div class="cat-list">
      
      
      <a href="/eat" class="cat-row">
        <span class="cat-num">1</span>
        <div class="cat-info">
          <span class="cat-name">Food</span>
          <span class="cat-desc">Tavernas with freshly caught fish, wood-fired grills, white wine by the sea</span>
        </div>
        <span class="cat-count">{tavernsData.length} restaurants</span>
        <span class="cat-arrow">→</span>
      </a>

            <a href="/stay" class="cat-row">
        <span class="cat-num">2</span>
        <div class="cat-info">
          <span class="cat-name">Stay</span>
          <span class="cat-desc">From traditional houses to modern hotels — find your perfect base for exploring Milos</span>
        </div>
        <span class="cat-count">{accommodationsData.length} options</span>
        <span class="cat-arrow">→</span>
      </a>

      <a href="/beaches" class="cat-row">
        <span class="cat-num">3</span>
        <div class="cat-info">
          <span class="cat-name">Beaches</span>
          <span class="cat-desc">From the volcanic Sarakiniko to hidden sea caves — {beachesData.length}+ shores for every taste</span>
        </div>
        <span class="cat-count">{beachesData.length} beaches</span>
        <span class="cat-arrow">→</span>
      </a>

      <a href="/villages" class="cat-row">
        <span class="cat-num">4</span>
        <div class="cat-info">
          <span class="cat-name">Villages</span>
          <span class="cat-desc">Plaka, Klima, Tripiti, Pollonia — the island beyond the beaches</span>
        </div>
        <span class="cat-count">8 villages</span>
        <span class="cat-arrow">→</span>
      </a>

      <a href="/" class="cat-row">
        <span class="cat-num">5</span>
        <div class="cat-info">
          <span class="cat-name"></span>
          <span class="cat-desc"></span>
        </div>
        <span class="cat-count"></span>
        <span class="cat-arrow">→</span>
      </a>
    </div>
  </div>
</section>


<!-- ══ NUMBERS ══ -->
<section class="sec sec-dark">
  <div class="container">
    <div class="sec-hdr-row" style="margin-bottom:3rem">
      <div>
        <span class="label label-lt">Milos in numbers</span>
        <h2 class="sec-title sec-title-lt">An island in figures</h2>
      </div>
    </div>
    <div class="numbers-grid">
      <div class="num-item"><div class="num-label">Beaches</div><div class="num-val">70+</div><div class="num-desc">One of the most beach-rich islands in the Cyclades</div></div>
      <div class="num-item"><div class="num-label">Coastline</div><div class="num-val">125 km</div><div class="num-desc">Dramatically shaped by millions of years of volcanic activity</div></div>
      <div class="num-item"><div class="num-label">Area</div><div class="num-val">151 km²</div><div class="num-desc">The 7th largest island in the Cyclades</div></div>
      <div class="num-item"><div class="num-label">From Piraeus</div><div class="num-val">86 nm</div><div class="num-desc">High-speed ~3.5 hrs, regular ferry ~7 hrs</div></div>
      <div class="num-item"><div class="num-label">Harbour</div><div class="num-val">Top 5</div><div class="num-desc">One of the largest natural harbours in the Mediterranean</div></div>
      <div class="num-item"><div class="num-label">Volcanic arc</div><div class="num-val">3M yrs</div><div class="num-desc">Geological history that shaped every rock on the island</div></div>
    </div>
  </div>
</section>


<!-- ══ QUICK FACTS ══ -->
<section class="sec sec-white">
  <div class="container">
    <div class="sec-hdr-row">
      <div>
        <span class="label">At a glance</span>
        <h2 class="sec-title">Quick Facts</h2>
      </div>
    </div>
    <div class="facts-grid">
      <div class="fact-item"><span class="fact-key">Region</span><span class="fact-val">Cyclades</span></div>
      <div class="fact-item"><span class="fact-key">Capital</span><span class="fact-val">Plaka</span></div>
      <div class="fact-item"><span class="fact-key">Port</span><span class="fact-val">Adamas</span></div>
      <div class="fact-item"><span class="fact-key">Population</span><span class="fact-val">~5,000</span></div>
      <div class="fact-item"><span class="fact-key">Beaches</span><span class="fact-val">70+</span></div>
      <div class="fact-item"><span class="fact-key">Area</span><span class="fact-val">151 km²</span></div>
      <div class="fact-item"><span class="fact-key">Highest peak</span><span class="fact-val">Prophet Elias</span></div>
      <div class="fact-item"><span class="fact-key">Famous find</span><span class="fact-val">Venus de Milo</span></div>
    </div>
  </div>
</section>


<!-- ══ WHY DIFFERENT ══ -->
<section class="sec sec-sand">
  <div class="container">
    <div class="sec-hdr-row">
      <div>
        <span class="label">Why Milos is different</span>
        <h2 class="sec-title">What you won't find<br/>anywhere else in the Aegean</h2>
      </div>
    </div>
    <div class="why-grid">
      <div class="why-item">
        <div class="why-num">01</div>
        <div class="why-title">Volcanic origin</div>
        <p class="why-text">Milos belongs to the Aegean Volcanic Arc and its landscape has been shaped by millions of years of volcanic activity. This explains the white rock formations of Sarakiniko, the warm waters at Paleochori, and the volcanic rock found in every corner of the island.</p>
      </div>
      <div class="why-item">
        <div class="why-num">02</div>
        <div class="why-title">Obsidian and ancient trade</div>
        <p class="why-text">Since the Neolithic period, Milos was an important trading hub due to its obsidian — a volcanic rock used for tools and weapons across the entire Mediterranean. Pieces of Milean obsidian have been found as far away as Egypt.</p>
      </div>
      <div class="why-item">
        <div class="why-num">03</div>
        <div class="why-title">The Venus that is no longer here</div>
        <p class="why-text">In 1820, a farmer in Milos discovered the statue that now graces the Louvre. The famous Venus de Milo was sculpted around 130 BC and had been hidden for centuries beneath the island's soil.</p>
      </div>
      <div class="why-item">
        <div class="why-num">04</div>
        <div class="why-title">Natural harbour of a volcanic caldera</div>
        <p class="why-text">The bay of Milos is essentially a submerged volcanic caldera — one of the largest natural harbours in the Mediterranean. Historically it served as shelter for naval fleets from antiquity through World War II.</p>
      </div>
    </div>
  </div>
</section>


<!-- ══ FEATURED TAVERNS ══ -->
{featuredTaverns.length > 0 && (
  <section class="sec sec-white">
    <div class="container">
      <div class="sec-hdr-row">
        <div>
          <span class="label">Food</span>
          <h2 class="sec-title">Featured restaurants</h2>
        </div>
        <a href="/eat" class="see-all">All restaurants →</a>
      </div>
      <div class="tav-grid">
        {featuredTaverns.map(tavern => (
          <a href={`/eat/${tavern.slug}`} class="tav-card">
            {tavern.localPhoto ? (
              <img src={tavern.localPhoto} alt={typeof tavern.name === 'object' ? tavern.name.en : tavern.name} class="tav-img" loading="lazy"/>
            ) : (
              <div class="tav-ph">🍽</div>
            )}
            <div class="tav-body">
              <div class="tav-top">
                <span class="tav-badge">⭐ Featured</span>
                <span class="tav-price">{tavern.priceRange}</span>
              </div>
              <h3 class="tav-name">{typeof tavern.name === 'object' ? tavern.name.en : tavern.name}</h3>
              <p class="tav-loc">◉ {tavern.location.area}</p>
              <div class="tav-foot">
                <span class="tav-rating">⭐ {tavern.rating} / 5</span>
                <span class="tav-cuisine">{typeof tavern.cuisine === 'object' ? tavern.cuisine.en : tavern.cuisine?.[0]}</span>
              </div>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>
)}


<!-- ══ BEACHES BY TYPE ══ -->
<section class="sec sec-white">
  <div class="container">
    <div class="sec-hdr-row">
      <div>
        <span class="label">Beaches</span>
        <h2 class="sec-title">Find your beach</h2>
      </div>
      <a href="/beaches" class="see-all">All beaches →</a>
    </div>
    <div class="beach-cat-grid">
      <div class="beach-cat">
        <div class="beach-cat-title">👨‍👩‍👧 For families</div>
        <div class="beach-cat-list">
          <a href="/beaches/paleochori" class="beach-link"><span class="beach-link-icon">🚗</span>Paleochori</a>
          <a href="/beaches/provatas"   class="beach-link"><span class="beach-link-icon">🚗</span>Provatas</a>
          <a href="/beaches/fyriplaka"  class="beach-link"><span class="beach-link-icon">🚗</span>Fyriplaka</a>
        </div>
      </div>
      <div class="beach-cat">
        <div class="beach-cat-title">📸 For photos</div>
        <div class="beach-cat-list">
          <a href="/beaches/sarakiniko" class="beach-link"><span class="beach-link-icon">🚗</span>Sarakiniko</a>
          <a href="/beaches/kleftiko"   class="beach-link"><span class="beach-link-icon">⛵</span>Kleftiko</a>
          <a href="/beaches/tsigrado"   class="beach-link"><span class="beach-link-icon">🥾</span>Tsigrado</a>
        </div>
      </div>
      <div class="beach-cat">
        <div class="beach-cat-title">🔇 For peace & quiet</div>
        <div class="beach-cat-list">
          <a href="/beaches/triades"   class="beach-link"><span class="beach-link-icon">🚗</span>Triades</a>
          <a href="/beaches/gerontas"  class="beach-link"><span class="beach-link-icon">🚗</span>Gerontas</a>
          <a href="/beaches/ammoudaki" class="beach-link"><span class="beach-link-icon">🥾</span>Ammoudaki</a>
        </div>
      </div>
      <div class="beach-cat">
        <div class="beach-cat-title">⛵ Boat access only</div>
        <div class="beach-cat-list">
          <a href="/beaches/kleftiko"   class="beach-link"><span class="beach-link-icon">⛵</span>Kleftiko</a>
          <a href="/beaches/sikia-cave" class="beach-link"><span class="beach-link-icon">⛵</span>Sykia Cave</a>
          <a href="/beaches/ammoudaki"  class="beach-link"><span class="beach-link-icon">⛵</span>Ammoudaki</a>
        </div>
      </div>
    </div>
  </div>
</section>


<!-- ══ VILLAGES ══ -->
<section class="sec sec-sand">
  <div class="container">
    <div class="sec-hdr-row">
      <div>
        <span class="label">Villages</span>
        <h2 class="sec-title">Milos beyond the beaches</h2>
      </div>
      <a href="/villages" class="see-all">All villages →</a>
    </div>
    <div class="villages-grid">
      <a href="/villages/plaka"       class="village-card"><span class="village-name">Plaka</span><span class="village-note">The capital, perched on a rock with panoramic views</span></a>
      <a href="/villages/tripiti"     class="village-card"><span class="village-name">Tripiti</span><span class="village-note">Catacombs, ancient theatre, atmospheric village</span></a>
      <a href="/villages/pollonia"    class="village-card"><span class="village-name">Pollonia</span><span class="village-note">North coast, fish tavernas and ferries to Kimolos</span></a>
      <a href="/villages/klima"       class="village-card"><span class="village-name">Klima</span><span class="village-note">The famous syrmata — fishing storehouses over the sea</span></a>
      <a href="/villages/mandrakia"   class="village-card"><span class="village-name">Mandrakia</span><span class="village-note">A small harbour with colourful syrmata</span></a>
      <a href="/villages/firopotamos" class="village-card"><span class="village-name">Firopotamos</span><span class="village-note">Quiet, authentic, far from the tourist trail</span></a>
    </div>
  </div>
</section>


<!-- ══ KNOWN PLACES ══ -->
<section class="sec sec-white">
  <div class="container">
    <div class="sec-hdr-row">
      <div>
        <span class="label">Landmarks & highlights</span>
        <h2 class="sec-title">The most iconic spots</h2>
      </div>
    </div>
    <div class="places-strip">
      <a href="/beaches/sarakiniko"   class="place-chip"><span class="place-chip-name">Sarakiniko</span><span class="place-chip-type">🏖 Beach</span></a>
      <a href="/beaches/kleftiko"     class="place-chip"><span class="place-chip-name">Kleftiko</span><span class="place-chip-type">⛵ Sea cave</span></a>
      <a href="/villages/plaka"       class="place-chip"><span class="place-chip-name">Plaka</span><span class="place-chip-type">🏘 Village</span></a>
      <a href="/villages/pollonia"    class="place-chip"><span class="place-chip-name">Pollonia</span><span class="place-chip-type">🍽 Food & sea</span></a>
      <a href="/villages/klima"       class="place-chip"><span class="place-chip-name">Klima</span><span class="place-chip-type">🏠 Syrmata</span></a>
      <a href="/villages/firopotamos" class="place-chip"><span class="place-chip-name">Firopotamos</span><span class="place-chip-type">📷 Photogenic</span></a>
    </div>
  </div>
</section>


<!-- ══ WHEN TO VISIT ══ -->
<section class="sec sec-sand">
  <div class="container">
    <div class="sec-hdr-row">
      <div>
        <span class="label">When to visit</span>
        <h2 class="sec-title">Every month has<br/>its own character</h2>
      </div>
    </div>
    <div class="months-grid">
      <div class="month-item">
        <div class="month-name">May</div>
        <span class="month-tag">Peaceful</span>
        <p class="month-desc">Few crowds, wildflowers in bloom, ideal for exploring. Sea still fresh.</p>
      </div>
      <div class="month-item">
        <div class="month-name">June</div>
        <span class="month-tag">Ideal</span>
        <p class="month-desc">The best balance. Warm sea, few crowds, everything open.</p>
      </div>
      <div class="month-item month-item--best">
        <div class="month-name">September</div>
        <span class="month-tag">Best month</span>
        <p class="month-desc">Perhaps the perfect month. Warm sea, fewer crowds, lower prices.</p>
      </div>
      <div class="month-item month-item--warn">
        <div class="month-name">August</div>
        <span class="month-tag">Busy</span>
        <p class="month-desc">Meltemi winds affect which beaches are suitable each day. Very crowded.</p>
      </div>
      <div class="month-item">
        <div class="month-name">July</div>
        <span class="month-tag">Peak season</span>
        <p class="month-desc">Lively atmosphere, but book everything well in advance.</p>
      </div>
    </div>
    <p class="meltemia-note">⚠️ <strong>Meltemi winds:</strong> The northern winds directly affect which beaches are good each day — southern beaches (Paleochori, Fyriplaka) are sheltered, while northern ones can have waves.</p>
  </div>
</section>

</Layout>

<style>
.hero { position:relative; min-height:90vh; display:flex; flex-direction:column; justify-content:center; overflow:hidden; }
.hero-bg { position:absolute; inset:0; z-index:0; background:#0a2040; }
.hero-photo { position:absolute; inset:0; width:100%; height:100%; object-fit:cover; object-position:center 55%; display:block; }
.hero-photo-overlay {
  position:absolute; inset:0;
  background:
    linear-gradient(to right, rgba(5,18,38,.88) 0%, rgba(5,18,38,.75) 35%, rgba(5,18,38,.35) 65%, rgba(5,18,38,.15) 100%),
    linear-gradient(to top, rgba(5,18,38,.65) 0%, transparent 40%);
}
.hero-content { position:relative; z-index:2; padding:4rem 0 2rem; }
.hero-eyebrow { display:flex; align-items:center; gap:.6rem; font-size:.72rem; font-weight:600; letter-spacing:.13em; text-transform:uppercase; color:rgba(255,255,255,.48); margin-bottom:1.25rem; animation:fadeUp .7s ease both; }
.eyedot { width:6px; height:6px; border-radius:50%; background:var(--sea); animation:blink 2.5s infinite; }
@keyframes blink { 0%,100%{opacity:1;transform:scale(1)}50%{opacity:.4;transform:scale(.65)} }
.hero-title { margin-bottom:1.5rem; animation:fadeUp .7s ease .1s both; }
.hero-title-main { display:block; font-family:var(--font-serif); font-size:clamp(4rem,11vw,8.5rem); color:#fff; line-height:.92; letter-spacing:-.02em; }
.hero-title-sub { display:block; font-size:clamp(.9rem,2vw,1.1rem); font-weight:400; color:rgba(255,255,255,.55); letter-spacing:.02em; margin-top:.55rem; }
.hero-desc { max-width:510px; font-size:1.05rem; line-height:1.72; color:rgba(255,255,255,.7); margin-bottom:2.25rem; animation:fadeUp .7s ease .2s both; }
.hero-ctas { display:flex; gap:.85rem; flex-wrap:wrap; animation:fadeUp .7s ease .3s both; }
.hero-stats { position:relative; z-index:2; display:flex; gap:.85rem; flex-wrap:wrap; padding-top:2.5rem; padding-bottom:5rem; animation:fadeUp .7s ease .4s both; }
.stat-pill { display:flex; flex-direction:column; gap:.12rem; padding:.7rem 1.2rem; background:rgba(255,255,255,.08); border:1px solid rgba(255,255,255,.13); border-radius:var(--radius-md); backdrop-filter:blur(10px); }
.stat-n { font-family:var(--font-serif); font-size:1.65rem; color:#fff; line-height:1; }
.stat-l { font-size:.68rem; font-weight:500; color:rgba(255,255,255,.45); text-transform:uppercase; letter-spacing:.06em; }
.hero-waves { position:absolute; bottom:-1px; left:0; right:0; height:100px; z-index:1; }
.hero-waves svg { width:100%; height:100%; display:block; }
.scroll-hint { position:absolute; bottom:2rem; right:2.5rem; z-index:2; display:flex; flex-direction:column; align-items:center; gap:.5rem; animation:fadeUp 1s ease .9s both; }
.scroll-hint span { font-size:.58rem; font-weight:600; letter-spacing:.13em; text-transform:uppercase; color:rgba(255,255,255,.28); writing-mode:vertical-rl; }
.scroll-line { width:1px; height:52px; background:linear-gradient(to bottom,rgba(255,255,255,.28),transparent); animation:scrollAnim 2s ease-in-out infinite; }
@keyframes scrollAnim { 0%{transform:scaleY(0);transform-origin:top;opacity:1}100%{transform:scaleY(1);transform-origin:top;opacity:0} }
@keyframes fadeUp { from{opacity:0;transform:translateY(20px)}to{opacity:1;transform:translateY(0)} }
.explore-head { display:flex; align-items:baseline; gap:1.5rem; margin-bottom:3.5rem; border-bottom:1px solid rgba(0,0,0,.1); padding-bottom:1.25rem; }
.explore-head-title { font-family:var(--font-serif); font-size:clamp(1.1rem,2vw,1.35rem); color:var(--ink); font-weight:400; }
.cat-list { display:flex; flex-direction:column; }
.cat-row { display:grid; grid-template-columns:80px 1fr auto auto; align-items:center; gap:2rem; padding:1.75rem 0; border-bottom:1px solid rgba(0,0,0,.08); color:inherit; position:relative; transition:padding-left .3s ease; }
.cat-row::before { content:''; position:absolute; left:0; top:0; bottom:0; width:0; background:var(--deep-blue); transition:width .3s ease; border-radius:0 2px 2px 0; }
.cat-row:hover { padding-left:1rem; }
.cat-row:hover::before { width:3px; }
.cat-num { font-family:var(--font-serif); font-size:clamp(2.5rem,5vw,3.8rem); color:rgba(0,0,0,.1); line-height:1; transition:color .3s; user-select:none; }
.cat-row:hover .cat-num { color:var(--deep-blue); }
.cat-info { display:flex; flex-direction:column; gap:.3rem; }
.cat-name { font-family:var(--font-serif); font-size:clamp(1.5rem,3vw,2.2rem); color:var(--ink); line-height:1.1; transition:color .3s; }
.cat-row:hover .cat-name { color:var(--deep-blue); }
.cat-desc { font-size:.875rem; color:var(--muted); line-height:1.55; max-width:430px; }
