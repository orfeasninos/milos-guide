---
import Layout from "../layouts/Layout.astro";
import WindBeaches from "../components/WindBeaches.astro";
import Hero from "../components/home/Hero.astro";
import Explore from "../components/home/Explore.astro";
import QuickFacts from "../components/home/QuickFacts.astro";
import WhyDifferent from "../components/home/WhyDifferent.astro";
import BeachTypes from "../components/home/BeachTypes.astro";
import Villages from "../components/home/Villages.astro";
import KnownPlaces from "../components/home/KnownPlaces.astro";
import WhenToVisit from "../components/home/WhenToVisit.astro";
---

<Layout
  lang="en"
  title="The Complete Guide to Milos"
  description="Beaches, restaurants, villages, boat tours — the most complete guide to Milos, Greece. No ads."
  preloadImageSrcset="/images/hero-beach-800w.avif 800w, /images/hero-beach-1200w.avif 1200w, /images/hero-beach-1920w.avif 1920w"
  preloadImageSizes="100vw"
>
  <Hero />
  <Explore />

  <!-- ══ WIND HELPER ══ -->
  <section class="sec sec-sand" style="padding-top:0">
    <div class="container">
      <WindBeaches />
    </div>
  </section>

  <QuickFacts />
  <WhyDifferent />
  <BeachTypes />
  <Villages />
  <KnownPlaces />
  <WhenToVisit />
</Layout>
