---
import Layout from '../layouts/Layout.astro';
import SmartImage from '../components/SmartImage.astro';
import beachesRaw from '../data/beaches.json';
import { getArea, areaLabel, getBeachName } from '../lib/beaches';
import { beachPhoto } from '../lib/public-files';
import { readWeatherCache } from '../lib/weather-cache';
import { heroValues, heroClass, wmoIcon, formatTime, forecastSummary, weekHtml } from '../lib/weather-format.js';
import ClimateTable from '../components/weather/ClimateTable.astro';
import { months, shelteredFromNorth } from '../lib/climate';
import '../styles/weather.css';

// Prerender the deploy's cached reading so the HTML carries real numbers (crawlers, first
// paint); the client script replaces it with the live one. Without a cache: placeholders.
const cache = readWeatherCache();
const cacheToday = cache?.weather.current.time.slice(0, 10) ?? '';
const hv: Record<string, string> = cache ? heroValues(cache.weather, cache.marine, cache.air) : {};
const heroCls = cache ? heroClass(cache.weather.current.weather_code) : '';
const heroIcon = cache ? wmoIcon(cache.weather.current.weather_code, Number(cache.weather.current.time.slice(11, 13))) : '';
const summary = cache ? forecastSummary(cache.weather, cache.marine, cacheToday) : '';
const week = cache ? weekHtml(cache.weather, cacheToday) : '';

const byName = Object.fromEntries(months.map(m => [m.slug, m]));
const { july: jul, august: aug, february: feb, january: jan, september: sep, december: dec } = byName;
const sheltered = shelteredFromNorth();
const shelteredLinks = sheltered.map(b => `<a href="/beaches/${b.slug}/">${b.name}</a>`).join(', ');

// Answers stay in sync with climate.json; the same text feeds the FAQPage schema.
const faq = [
  {
    q: 'Is Milos windy?',
    a: `In July and August, often. The meltemi, a dry north wind, blows on about ${jul.northWindDays} days a month at 4 Beaufort or more, sometimes for several days in a row. May and June are the calmest months. In winter, strong northerlies and southerly gales come with passing storms.`,
  },
  {
    q: 'Which beaches are best when the meltemi blows?',
    a: `Beaches facing south are sheltered from a north wind: ${sheltered.map(b => b.name).join(', ')}. North-facing beaches such as Sarakiniko, Papafragas and Firopotamos get the waves. The beach picks above are ranked live against today's wind.`,
    html: `Beaches facing south are sheltered from a north wind: ${shelteredLinks}. North-facing beaches such as <a href="/beaches/sarakiniko/">Sarakiniko</a>, Papafragas and Firopotamos get the waves. The beach picks above are ranked live against today's wind.`,
  },
  {
    q: 'What is the sea temperature in Milos?',
    a: `It peaks at about ${aug.sea}°C in August and stays at ${sep.sea}°C in September. The coldest water is in February, around ${feb.sea}°C. Most people find the sea comfortable from mid-June to October.`,
  },
  {
    q: 'Does it rain in Milos?',
    a: `Hardly at all in summer: June to August average about one rain day a month. Rain returns from October, and December and January are the wettest months with ${dec.rainDays}–${jan.rainDays} rain days each.`,
  },
  {
    q: 'When is the best time to visit Milos for the weather?',
    a: `June and September. Both are hot with a warm sea, less wind than July and August, and fewer crowds. May and October suit walkers and sightseers, with a cooler sea.`,
  },
];
const faqJsonld = {
  '@type': 'FAQPage',
  mainEntity: faq.map(f => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
};

// Every beach is rendered; the client ranks them by shelter from the live wind
// (same `faces` logic as the WindBeaches widget) and shows the top picks.
const accessIcon: Record<string, string> = { road: '🚗', hike: '🥾', boat: '⛵' };

const BEACHES_DATA = beachesRaw.map(b => ({
  slug:   b.slug,
  name:   getBeachName(b),
  img:    beachPhoto(b),
  faces:  b.faces,
  access: b.accessType,
  area:   areaLabel[getArea(b.coordinates?.lat ?? 0, b.coordinates?.lng ?? 0)],
}));
---

<Layout
  lang="en"
  title="Weather in Milos Island: Today, Wind & 7-Day Forecast"
  description="Weather in Milos today: live wind, sea temperature, waves and UV, a 7-day forecast, which beaches are sheltered from the wind, and the climate by month."
  jsonld={faqJsonld}
>

<section class={`weather-hero ${heroCls}`} id="weather-hero">
  <div class="container">
    <h1 class="hero-label">Milos weather today · Live conditions</h1>
    <div class="hero-body">
      <div class="hero-left">
        <div class="hero-top">
          <div class="hero-icon" id="hero-icon" set:html={heroIcon}></div>
          <div class="hero-temp" id="hero-temp">{hv['hero-temp'] ?? '–'}</div>
        </div>
        <p class="hero-condition" id="hero-condition">{hv['hero-condition'] ?? 'Loading…'}</p>
        <p class="hero-feels" id="hero-feels">{hv['hero-feels'] ?? ' '}</p>
      </div>
      <div class="hero-stats">
        <div class="hs-item">
          <span class="hs-lbl">Wind</span>
          <span class="hs-val" id="hs-wind">{hv['hs-wind'] ?? '–'}</span>
        </div>
        <div class="hs-item">
          <span class="hs-lbl">Sea temp</span>
          <span class="hs-val" id="hs-sea">{hv['hs-sea'] ?? '–'}</span>
        </div>
        <div class="hs-item">
          <span class="hs-lbl">Waves</span>
          <span class="hs-val" id="hs-waves">{hv['hs-waves'] ?? '–'}</span>
        </div>
        <div class="hs-item">
          <span class="hs-lbl">UV index</span>
          <span class="hs-val" id="hs-uv">{hv['hs-uv'] ?? '–'}</span>
        </div>
        <div class="hs-item">
          <span class="hs-lbl">Humidity</span>
          <span class="hs-val" id="hs-humidity">{hv['hs-humidity'] ?? '–'}</span>
        </div>
        <div class="hs-item">
          <span class="hs-lbl">Air quality</span>
          <span class="hs-val" id="hs-aqi">{hv['hs-aqi'] ?? '–'}</span>
        </div>
      </div>
    </div>
    <p class="hero-summary" id="hero-summary">{summary}</p>
    <p class="hero-updated" id="hero-updated">{cache && `Forecast from ${formatTime(cache.weather.current.time)} (Milos time)`}</p>
  </div>
</section>

<section class="sec sec-sand weather-sec">
  <div class="container">

    <div class="w-loading" id="w-loading">
      <div class="w-spinner"></div>
      <p>Fetching current conditions… Please wait.</p>
    </div>

    <div class="w-error" id="w-error" style="display:none">
      <div class="w-error-icon">⚠️</div>
      <p>Could not load weather data. Please try again later.</p>
      <button class="w-retry-btn" id="w-retry-btn">Try again</button>
    </div>

    <div class="w-content" id="w-content">

      <div class="w-stale-banner" id="w-stale-banner" style="display:none">
        ⚠️ Live data unavailable — showing last known conditions from <span id="w-stale-time">–</span>
      </div>

      <!-- Stats grid -->
      <div class="w-stats-grid">

        <div class="w-stat w-stat--wind">
          <p class="w-stat-label">Wind</p>
          <div class="w-stat-body">
            <svg class="wind-compass" viewBox="0 0 48 48" aria-hidden="true">
              <circle cx="24" cy="24" r="21" fill="none" stroke="currentColor" stroke-width="0.75" opacity="0.15"/>
              <circle cx="24" cy="3.5" r="1.2" fill="currentColor" opacity="0.25"/>
              <circle cx="44.5" cy="24" r="1.2" fill="currentColor" opacity="0.25"/>
              <circle cx="24" cy="44.5" r="1.2" fill="currentColor" opacity="0.25"/>
              <circle cx="3.5" cy="24" r="1.2" fill="currentColor" opacity="0.25"/>
              <text x="24" y="10.5" text-anchor="middle" font-size="5" fill="currentColor" opacity="0.45" font-family="DM Sans Variable, DM Sans, sans-serif" font-weight="600">N</text>
              <text x="39" y="25.5" text-anchor="middle" font-size="5" fill="currentColor" opacity="0.3" font-family="DM Sans Variable, DM Sans, sans-serif">E</text>
              <text x="24" y="41" text-anchor="middle" font-size="5" fill="currentColor" opacity="0.3" font-family="DM Sans Variable, DM Sans, sans-serif">S</text>
              <text x="9" y="25.5" text-anchor="middle" font-size="5" fill="currentColor" opacity="0.3" font-family="DM Sans Variable, DM Sans, sans-serif">W</text>
              <!-- Blue tip points where the wind blows to (meteo.gr convention) -->
              <g id="compass-needle-g" style="opacity:0; transform-origin:24px 24px; transition: transform 0.6s cubic-bezier(0.34,1.56,0.64,1), opacity 0.3s;">
                <polygon points="24,10 21.5,24 24,21 26.5,24" fill="var(--aegean)"/>
                <polygon points="24,38 21.5,24 24,27 26.5,24" fill="currentColor" opacity="0.35"/>
                <circle cx="24" cy="24" r="2.5" fill="var(--white)" stroke="var(--aegean)" stroke-width="1"/>
              </g>
            </svg>
            <div class="w-stat-vals">
              <div class="w-stat-val" id="w-wind-speed">–</div>
              <p class="w-stat-sub" id="w-wind-dir">–</p>
              <span class="w-badge" id="w-wind-tag">–</span>
            </div>
          </div>
        </div>

        <div class="w-stat w-stat--sea">
          <p class="w-stat-label">Sea & Waves</p>
          <div class="w-stat-val" id="w-sea-temp">–</div>
          <p class="w-stat-sub">Sea temperature</p>
          <div class="w-wave-header">
            <span class="w-stat-sub">Wave height</span>
            <span class="w-stat-sub">0 – 3 m</span>
          </div>
          <div class="w-wave-track">
            <div class="w-wave-fill" id="w-wave-fill"></div>
          </div>
          <div class="w-sub-row">
            <span class="w-stat-sub" id="w-wave-val">–</span>
            <span class="w-badge" id="w-wave-tag">–</span>
          </div>
        </div>

        <div class="w-stat w-stat--uv">
          <p class="w-stat-label">UV Index</p>
          <div class="w-stat-val" id="w-uv">–</div>
          <div class="uv-track" title="UV index scale 0–11+">
            <div class="uv-gradient"></div>
            <div class="uv-marker" id="uv-marker"></div>
          </div>
          <p class="w-stat-sub" id="w-uv-level">–</p>
          <span class="w-badge" id="w-uv-tag">–</span>
        </div>

        <div class="w-stat w-stat--humidity">
          <p class="w-stat-label">Humidity</p>
          <div class="w-stat-val" id="w-humidity">–</div>
          <p class="w-stat-sub" id="w-humidity-sub">–</p>
        </div>

        <div class="w-stat w-stat--range">
          <p class="w-stat-label">Today's range</p>
          <div class="w-minmax">
            <div class="w-mm-block w-mm-high">
              <span class="w-mm-arrow">↑</span>
              <span class="w-mm-val" id="w-temp-max">–</span>
            </div>
            <div class="w-mm-sep"></div>
            <div class="w-mm-block w-mm-low">
              <span class="w-mm-arrow">↓</span>
              <span class="w-mm-val" id="w-temp-min">–</span>
            </div>
          </div>
          <div class="w-sun-row">
            <span class="w-sun-item">🌅 <span id="w-sunrise">–</span></span>
            <span class="w-sun-item">🌇 <span id="w-sunset">–</span></span>
          </div>
        </div>

        <div class="w-stat w-stat--air">
          <p class="w-stat-label">Air quality</p>
          <div class="w-stat-val" id="w-aqi">–</div>
          <div class="uv-track" title="European Air Quality Index 0–100+">
            <div class="aqi-gradient"></div>
            <div class="uv-marker" id="aqi-marker"></div>
          </div>
          <p class="w-stat-sub" id="w-aqi-sub">–</p>
          <dl class="w-rows">
            <div><dt>PM2.5</dt><dd id="w-pm25">–</dd></div>
            <div><dt>PM10</dt><dd id="w-pm10">–</dd></div>
            <div><dt>Ozone</dt><dd id="w-ozone">–</dd></div>
            <div><dt>Dust</dt><dd id="w-dust">–</dd></div>
          </dl>
          <span class="w-badge" id="w-aqi-tag">–</span>
        </div>

        <div class="w-stat w-stat--pollen">
          <p class="w-stat-label">Pollen</p>
          <dl class="w-rows">
            <div><dt>🫒 Olive</dt><dd id="w-pollen-olive">–</dd></div>
            <div><dt>🌾 Grass</dt><dd id="w-pollen-grass">–</dd></div>
            <div><dt>🌿 Ragweed</dt><dd id="w-pollen-ragweed">–</dd></div>
          </dl>
          <p class="w-stat-sub">Olive pollen peaks April – June across the Cyclades.</p>
          <span class="w-badge" id="w-pollen-tag">–</span>
        </div>

        <div class="w-stat w-stat--more">
          <p class="w-stat-label">More conditions</p>
          <dl class="w-rows">
            <div><dt>Wind gusts</dt><dd id="w-gusts">–</dd></div>
            <div><dt>Visibility</dt><dd id="w-visibility">–</dd></div>
            <div><dt>Cloud cover</dt><dd id="w-clouds">–</dd></div>
            <div><dt>Pressure</dt><dd id="w-pressure">–</dd></div>
            <div><dt>Dew point</dt><dd id="w-dewpoint">–</dd></div>
          </dl>
        </div>

      </div>

      <!-- Beach recommendation -->
      <div class="w-rec" id="w-rec">
        <div class="w-rec-header">
          <span class="w-rec-emoji" id="w-rec-emoji">🏖</span>
          <div>
            <p class="w-rec-label">Beach recommendation for today</p>
            <h2 class="w-rec-title" id="w-rec-title">–</h2>
          </div>
        </div>
        <p class="w-rec-desc" id="w-rec-desc">–</p>
        <div class="w-beaches-grid" id="w-beaches-grid">
          {BEACHES_DATA.map(beach => (
            <a
              href={`/beaches/${beach.slug}/`}
              class="w-beach-card"
              data-slug={beach.slug}
              data-faces={beach.faces}
              data-access={beach.access}
              data-umami-event="weather-beach"
              data-umami-event-beach={beach.slug}
              hidden
            >
              <div class="w-beach-img">
                {beach.img ? (
                  <SmartImage
                    src={beach.img}
                    alt={`${beach.name} beach, Milos`}
                    width={280}
                    height={160}
                    sizes="(max-width: 520px) 50vw, 280px"
                  />
                ) : (
                  <div class="w-beach-ph" aria-hidden="true"><span>{beach.name.charAt(0)}</span></div>
                )}
                <div class="w-beach-img-overlay"></div>
                <span class="w-beach-pill" data-pill></span>
              </div>
              <div class="w-beach-info">
                <p class="w-beach-name">{beach.name}</p>
                <p class="w-beach-meta">{accessIcon[beach.access] ?? '📍'} {beach.area}</p>
              </div>
            </a>
          ))}
        </div>
        <p class="w-rec-avoid" id="w-rec-avoid" hidden></p>
      </div>

      <!-- 12-hour forecast -->
      <div class="w-block">
        <p class="w-section-title">Next 12 hours</p>
        <div class="w-hourly-scroll">
          <div class="w-hourly" id="w-hourly"></div>
        </div>
      </div>

      <!-- 7-day forecast -->
      <div class="w-block">
        <p class="w-section-title">7-day outlook</p>
        <div class="w-week-scroll">
          <div class="w-week" id="w-week" set:html={week}></div>
        </div>
      </div>

    </div>
  </div>
</section>

<!-- Static guide: evergreen content for "milos weather" searches, which the live widgets alone don't give crawlers -->
<section class="sec w-guide">
  <div class="container">

    <div class="w-guide-block" id="climate">
      <span class="label">Climate</span>
      <h2 class="sec-title">Milos weather by month</h2>
      <p class="w-guide-lead">
        Milos has a dry Mediterranean climate: hot, rainless summers cooled by the north wind,
        and mild, wet, windy winters. Pick a month for what to expect, which beaches work and what to pack.
      </p>
      <ClimateTable />
    </div>

    <div class="w-guide-block" id="meltemi">
      <span class="label">Wind</span>
      <h2 class="sec-title">The meltemi and which beaches to pick</h2>
      <div class="w-guide-cols">
        <div class="w-guide-text">
          <p>
            The <strong>meltemi</strong> is the dry north wind of the Aegean summer. On Milos it blows on about
            {jul.northWindDays} days in July and {aug.northWindDays} in August, usually at 4–6 Beaufort and sometimes
            stronger, often for three or more days at a stretch. It keeps the heat down, but it decides your beach day.
          </p>
          <p>
            Wind is reported by the direction it comes <em>from</em>. A north wind piles waves onto north-facing
            beaches like Sarakiniko, Papafragas and Firopotamos, while the south coast stays flat. Boat tours to
            Kleftiko are often cancelled or rerouted when it blows hard.
          </p>
          <p>
            Every beach page on this site shows how exposed that beach is to today's wind, and the picks at the
            top of this page are ranked against the live reading.
          </p>
        </div>
        <div class="w-guide-card">
          <p class="w-guide-card-title">Sheltered in a north wind</p>
          <ul class="w-guide-list">
            {sheltered.map(b => <li><a href={`/beaches/${b.slug}/`}>{b.name}</a></li>)}
          </ul>
          <a href="/beaches/" class="w-guide-more">All Milos beaches →</a>
        </div>
      </div>
    </div>

    <div class="w-guide-block" id="faq">
      <span class="label">FAQ</span>
      <h2 class="sec-title">Milos weather questions</h2>
      <div class="w-faq">
        {faq.map(f => (
          <details class="w-faq-item">
            <summary>{f.q}</summary>
            <p set:html={f.html ?? f.a}></p>
          </details>
        ))}
      </div>
    </div>

  </div>
</section>


<script>
  import '../scripts/weather.js';
</script>

<script>
  import { exposure, shelterScore, compass, exposureLabel, rememberWind, CALM_KMH, BOAT_TOUR_LIMIT_KMH, type Wind } from '../lib/wind';
  import { POPULAR_BEACHES } from '../lib/beaches';

  type Reading = Wind & { waveH: number };

  const LIMIT = 6;
  const popularity = (slug: string) => {
    const i = POPULAR_BEACHES.indexOf(slug);
    return i === -1 ? 99 : i;
  };
  const $ = (id: string) => document.getElementById(id)!;

  function render(reading: Reading) {
    const { speed, direction, waveH } = reading;
    if (reading.source === 'live') rememberWind({ speed, direction, time: reading.time, source: 'live' });
    const wind = { speed, direction };
    const dir = compass(direction);
    const kmh = Math.round(speed);
    const calm = speed < CALM_KMH;
    const boatOk = speed < BOAT_TOUR_LIMIT_KMH && waveH < 1.5;

    const cards = Array.from(document.querySelectorAll<HTMLElement>('#w-beaches-grid .w-beach-card'));
    const ranked = cards
      .map(el => {
        const faces = Number(el.dataset.faces);
        return { el, slug: el.dataset.slug!, access: el.dataset.access!, name: el.querySelector('.w-beach-name')!.textContent!,
                 score: shelterScore(faces, wind), exp: exposure(faces, wind) };
      })
      .sort((a, b) => (b.score - a.score) || (popularity(a.slug) - popularity(b.slug)));

    const picks = ranked
      .filter(b => b.access !== 'boat')
      .sort((a, b) => calm ? popularity(a.slug) - popularity(b.slug) : 0)
      .slice(0, LIMIT);

    // Reorder the grid so the picks appear in rank order.
    const grid = $('w-beaches-grid');
    cards.forEach(el => { el.hidden = true; });
    picks.forEach(b => {
      const pill = b.el.querySelector<HTMLElement>('[data-pill]')!;
      pill.className = `w-beach-pill w-beach-pill--${b.exp}`;
      pill.textContent = exposureLabel[b.exp];
      b.el.hidden = false;
      grid.appendChild(b.el);
    });

    const [emoji, title, desc] = calm
      ? ['🏖', 'All beaches are great today',
         `Light wind (${kmh} km/h) everywhere — every beach on the island is swimmable. Go for the exposed north coast (Sarakiniko, Papafragas) while it lasts.`]
      : speed > 40
      ? ['⚠️', `Strong ${dir} wind — stick to sheltered beaches`,
         `${kmh} km/h from the ${dir}. Beaches facing ${dir} take the waves; these ones are tucked away from it.`]
      : ['🌊', `${dir} wind — these beaches are sheltered`,
         `${kmh} km/h from the ${dir}, so beaches facing ${dir} get the waves. These ones are tucked away from it.`];
    $('w-rec-emoji').textContent = emoji;
    $('w-rec-title').textContent = title;
    $('w-rec-desc').textContent = desc + (boatOk
      ? ' Good day for a boat trip to Kleftiko.'
      : ' Boat tours to Kleftiko are often cancelled or rerouted in this wind — check with your operator.');

    const avoid = calm ? [] : ranked
      .filter(b => b.exp === 'exposed' && popularity(b.slug) < 99)
      .sort((a, b) => popularity(a.slug) - popularity(b.slug))
      .slice(0, 3);
    const avoidEl = $('w-rec-avoid');
    avoidEl.hidden = !avoid.length;
    avoidEl.innerHTML = avoid.length
      ? `<strong>Skip today:</strong> ${avoid.map(b => `<a href="/beaches/${b.slug}/">${b.name}</a>`).join(', ')} — facing straight into the wind.`
      : '';
  }

  window.addEventListener('mg:weather', e => render((e as CustomEvent<Reading>).detail));
  const early = (window as any).__mgWeather as Reading | undefined;
  if (early) render(early);
</script>
</Layout>
