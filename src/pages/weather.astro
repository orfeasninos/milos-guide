}
.w-beaches-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 0.75rem;
  min-height: 340px;
}
.w-beach-card {
  border-radius: var(--radius-md);
  overflow: hidden;
  text-decoration: none;
  color: #fff;
  display: flex;
  flex-direction: column;
  background: rgba(255,255,255,0.06);
  border: 1px solid rgba(255,255,255,0.12);
  transition: transform 0.2s var(--ease), box-shadow 0.2s var(--ease);
}
.w-beach-img {
  position: relative;
  height: 115px;
  overflow: hidden;
  flex-shrink: 0;
}
.w-beach-img img {
  width: 100%; height: 100%;
  object-fit: cover;
  transition: transform 0.5s ease;
  display: block;
}
.w-beach-card:hover .w-beach-img img { transform: scale(1.07); }
.w-beach-img-overlay {
  position: absolute;
  inset: 0;
  background: linear-gradient(to bottom, transparent 35%, rgba(0,0,0,0.52) 100%);
}
.w-beach-info { padding: 0.65rem 0.9rem 0.75rem; }
.w-beach-name { font-family: var(--font-serif); font-size: 0.95rem; margin-bottom: 0.18rem; color: #fff; }
.w-beach-meta { font-size: 0.67rem; color: rgba(255,255,255,0.45); }

/* ── Hourly forecast ──────────────────────────────── */
.w-block { margin-bottom: 1.75rem; }
.w-section-title {
  font-size: 0.62rem;
  font-weight: 700;
  letter-spacing: 0.14em;
  text-transform: uppercase;
  color: var(--muted);
  margin-bottom: 0.85rem;
}
.w-hourly-scroll {
  overflow-x: auto;
  scrollbar-width: none;
  margin: 0 -1.5rem;
  padding: 0 1.5rem;
}
.w-hourly-scroll::-webkit-scrollbar { display: none; }
.w-hourly {
  display: flex;
  gap: 0.6rem;
  padding-bottom: 0.5rem;
  min-width: max-content;
  min-height: 132px;
}
.w-fc-item {
  flex-shrink: 0;
  width: 84px;
  padding: 1rem 0.5rem 0.85rem;
  background: var(--white);
  border: 1px solid var(--border);
  border-radius: var(--radius-md);
  text-align: center;
  display: flex;
  flex-direction: column;
  gap: 0.3rem;
  align-items: center;
  transition: transform 0.18s var(--ease), box-shadow 0.18s var(--ease);
  box-shadow: var(--shadow-sm);
}
.w-fc-item:hover { box-shadow: var(--shadow-md); }
.w-fc-item.is-now {
  background: var(--deep-blue);
  border-color: var(--deep-blue);
  box-shadow: 0 6px 20px rgba(13,43,78,0.35);
}
.w-fc-time { font-size: 0.65rem; color: var(--muted); font-weight: 700; letter-spacing: 0.05em; text-transform: uppercase; }
.w-fc-item.is-now .w-fc-time { color: rgba(255,255,255,0.5); }
.w-fc-icon { font-size: 1.65rem; line-height: 1; margin: 0.15rem 0; }
.w-fc-temp { font-size: 1rem; font-weight: 800; color: var(--deep-blue); }
.w-fc-item.is-now .w-fc-temp { color: #fff; }
.w-fc-wind { font-size: 0.6rem; color: var(--muted); }
.w-fc-item.is-now .w-fc-wind { color: rgba(255,255,255,0.42); }
.w-fc-rain-track {
  width: 75%;
  height: 4px;
  background: rgba(58,155,201,0.12);
  border-radius: 99px;
  overflow: hidden;
  margin: 0.05rem 0;
}
.w-fc-rain-fill {
  height: 100%;
  background: linear-gradient(90deg, var(--sea), var(--sky));
  border-radius: 99px;
  transition: width 0.6s var(--ease);
}
.w-fc-item.is-now .w-fc-rain-track { background: rgba(125,211,248,0.18); }
.w-fc-item.is-now .w-fc-rain-fill  { background: linear-gradient(90deg, rgba(58,155,201,0.7), var(--sky)); }
.w-fc-rain { font-size: 0.6rem; color: var(--sea); font-weight: 700; letter-spacing: 0.02em; }
.w-fc-item.is-now .w-fc-rain { color: var(--sky); }
.w-fc-rain-placeholder { height: 0.8rem; display: block; }

/* ── 7-day forecast ───────────────────────────────── */
.w-week-scroll {
  overflow-x: auto;
  scrollbar-width: none;
  margin: 0 -1.5rem;
  padding: 0 1.5rem;
}
.w-week-scroll::-webkit-scrollbar { display: none; }
.w-week {
  display: grid;
  grid-template-columns: repeat(7, minmax(100px, 1fr));
  gap: 0.65rem;
  min-width: 700px;
  min-height: 185px;
}
.w-day {
  background: var(--white);
  border: 1px solid var(--border);
  border-radius: var(--radius-md);
  padding: 1.15rem 0.5rem 1rem;
  text-align: center;
  display: flex;
  flex-direction: column;
  gap: 0.32rem;
  align-items: center;
  transition: transform 0.18s var(--ease), box-shadow 0.18s var(--ease);
  box-shadow: var(--shadow-sm);
}
.w-day:hover {box-shadow: var(--shadow-md); }
.w-day.is-today {
  background: var(--deep-blue);
  border-color: var(--deep-blue);
  box-shadow: 0 6px 20px rgba(13,43,78,0.35);
}
.w-day-name {
  font-size: 0.6rem;
  font-weight: 800;
  text-transform: uppercase;
  letter-spacing: 0.12em;
  color: var(--muted);
}
.w-day.is-today .w-day-name { color: rgba(255,255,255,0.5); }
.w-day-icon { font-size: 1.9rem; line-height: 1; margin: 0.2rem 0; }
.w-day-cond {
  font-size: 0.58rem;
  color: var(--muted);
  line-height: 1.3;
  min-height: 1.6em;
}
.w-day.is-today .w-day-cond { color: rgba(255,255,255,0.38); }
.w-day-high { font-size: 1.05rem; font-weight: 800; color: var(--deep-blue); }
.w-day.is-today .w-day-high { color: #fff; }
.w-day-range-track {
  width: 70%;
  height: 5px;
  background: var(--sand-dark);
  border-radius: 99px;
  position: relative;
  overflow: hidden;
  margin: 0.05rem 0;
}
.w-day.is-today .w-day-range-track { background: rgba(255,255,255,0.15); }
.w-day-range-fill {
  position: absolute;
  top: 0; bottom: 0;
  background: linear-gradient(90deg, #38b2d4, #e8901a);
  border-radius: 99px;
  min-width: 15%;
}
.w-day.is-today .w-day-range-fill { background: linear-gradient(90deg, rgba(125,211,248,0.65), rgba(255,255,255,0.9)); }
.w-day-low { font-size: 0.8rem; color: var(--muted); }
.w-day.is-today .w-day-low { color: rgba(255,255,255,0.4); }
.w-day-rain {
  font-size: 0.62rem;
  font-weight: 700;
  color: var(--sea);
  display: flex;
  align-items: center;
  gap: 0.2rem;
  margin-top: 0.05rem;
}
.w-day.is-today .w-day-rain { color: var(--sky); }
.w-day-rain-ph { height: 0.88rem; display: block; }

/* ── Responsive ───────────────────────────────────── */
@media (max-width: 860px) {
  .w-stats-grid { grid-template-columns: repeat(2, 1fr); }
  .w-stat--range { grid-column: span 2; }
}
@media (max-width: 520px) {
  .w-beaches-grid { grid-template-columns: repeat(2, 1fr); }
}
@media (max-width: 600px) {
  .hero-body { flex-direction: column; align-items: flex-start; }
  .hero-stats { width: 100%; grid-template-columns: repeat(3, 1fr); padding: 1rem 1.25rem; gap: 0.75rem 1rem; }
  .w-stats-grid { grid-template-columns: 1fr 1fr; }
  .w-stat--range { grid-column: span 2; }
  .w-stat--wind .w-stat-body { flex-direction: column; gap: 0.75rem; }
  .wind-compass { width: 54px; height: 54px; }
  .w-minmax { justify-content: flex-start; gap: 0; }
}
@media (max-width: 480px) {
  .hero-stats { grid-template-columns: repeat(2, 1fr); }
  .w-stats-grid { grid-template-columns: 1fr 1fr; }
}
</style>

<script is:inline define:vars={{ LAT, LNG }}>

const WMO_TEXT = {
  0:'Clear sky',1:'Mainly clear',2:'Partly cloudy',3:'Overcast',
  45:'Foggy',48:'Foggy',
  51:'Light drizzle',53:'Drizzle',55:'Heavy drizzle',
  61:'Light rain',63:'Rain',65:'Heavy rain',
  71:'Light snow',73:'Snow',75:'Heavy snow',
  80:'Showers',81:'Heavy showers',82:'Violent showers',
  95:'Thunderstorm',96:'Thunderstorm',99:'Thunderstorm',
};

function el(id) { return document.getElementById(id); }

function windDir(deg) {
  const dirs = ['N','NE','E','SE','S','SW','W','NW'];
  return dirs[Math.round(deg / 45) % 8];
}
function windCat(deg) {
  const d = ((deg % 360) + 360) % 360;
  if (d >= 315 || d < 45)  return 'north';
  if (d >= 45  && d < 135) return 'east';
  if (d >= 135 && d < 225) return 'south';
  return 'west';
}
function beaufort(kmh) {
  if (kmh < 1)   return '0Bft - Calm';
  if (kmh < 6)   return '1Bft - Light air';
  if (kmh < 12)  return '2Bft - Light breeze';
  if (kmh < 20)  return '3Bft - Gentle breeze';
  if (kmh < 29)  return '4Bft - Moderate breeze';
  if (kmh < 39)  return '5Bft - Fresh breeze'; 
  if (kmh < 50)  return '6Bft - Strong breeze';
  if (kmh < 62)  return '7Bft - High wind';    
  if (kmh < 75)  return '8Bft - Gale';         
  if (kmh < 89)  return '9Bft - Strong gale';  
  if (kmh < 103) return '10Bft - Storm';        
  if (kmh < 118) return '11Bft - Violent storm';
  return '12Bft - Hurricane force';
}
function uvLevel(uv) {
  if (uv <= 2)  return ['Low', 'No protection needed'];
  if (uv <= 5)  return ['Moderate', 'Wear SPF 30+'];
  if (uv <= 7)  return ['High', 'SPF 50+ recommended'];
  if (uv <= 10) return ['Very high', 'Limit time in sun'];
  return ['Extreme', 'Avoid direct sun'];
}
function waveDesc(h) {
  if (h < 0.3) return ['Calm', 'Perfect for swimming'];
  if (h < 0.8) return ['Slight', 'Good conditions'];
  if (h < 1.5) return ['Moderate', 'Caution advised'];
  return ['Rough', 'Avoid open beaches'];
}
function humidityDesc(h) {
  if (h < 30)  return 'Dry';
  if (h < 60)  return 'Comfortable';
  if (h < 75)  return 'Humid';
  return 'Very humid';
}
function heroClass(code) {
  if (code === 0 || code === 1) return 'is-sunny';
  if (code === 2) return 'is-partly';
  if (code === 3) return 'is-cloudy';
  if (code >= 51 && code <= 82) return 'is-rain';
  if (code >= 95) return 'is-storm';
  return '';
}
function formatHour(h) {
  if (h === 0)  return '12 am';
  if (h < 12)   return `${h} am`;
  if (h === 12) return '12 pm';
  return `${h - 12} pm`;
}
function formatTime(dtStr) {
  const d = new Date(dtStr);
  return d.toLocaleTimeString('en-US', { hour: 'numeric', minute: '2-digit', hour12: true });
}
function dayLabel(dtStr, idx) {
  if (idx === 0) return 'Today';
  if (idx === 1) return 'Tomorrow';
  return new Date(dtStr).toLocaleDateString('en-US', { weekday: 'short' });
}

function recommendation(windKmh, windDeg, waveH) {
  const cat = windCat(windDeg);
  if (windKmh < 15 && waveH < 0.5) return {
    emoji:'🏖', title:'All beaches are great today',
    desc:'Calm winds and flat seas — perfect conditions across the island. Great day for boat tours to Kleftiko.',
    filter:'any',
  };
  if (windKmh > 40) return {
    emoji:'⚠️', title:'Strong winds — choose sheltered beaches',
    desc:`${windDir(windDeg)} winds at ${Math.round(windKmh)} km/h. Stick to protected beaches on the leeward coast. Avoid boat tours today.`,
    filter: cat,
  };
  if (cat === 'north') return {
    emoji:'🌊', title:'North winds — head to the south coast',
    desc:'The wind is blowing from the north. Paleochori, Fyriplaka and Provatas are sheltered and calm.',
    filter:'north',
  };
  if (cat === 'south') return {
    emoji:'💨', title:'South winds — north coast is better',
    desc:'Winds from the south today. Head to Triades, Firopotamos or Plathiena on the north coast.',
    filter:'south',
  };
  return {
    emoji:'🏖', title:'Good conditions today',
    desc:'Moderate winds — most beaches are accessible. Check wind direction before heading to exposed beaches.',
    filter:'any',
  };
}

// ── Meteocons weather icons ────────────────────────────
const CDN = '/icons/weather';
const WMO_DAY = {
  0:'clear-day', 1:'clear-day',
  2:'partly-cloudy-day',
  3:'overcast',
  45:'fog-day', 48:'fog-day',
  51:'drizzle', 53:'drizzle', 55:'overcast-drizzle',
  61:'rain', 63:'rain', 65:'overcast-rain',
  71:'partly-cloudy-day-snow', 73:'snow', 75:'overcast-snow',
  80:'partly-cloudy-day-rain', 81:'overcast-rain', 82:'overcast-rain',
  95:'thunderstorms', 96:'thunderstorms-rain', 99:'thunderstorms-rain',
};
const WMO_NIGHT = {
  0:'clear-night', 1:'clear-night',
  2:'partly-cloudy-night',
  3:'overcast-night',
  45:'fog-night', 48:'fog-night',
  51:'drizzle', 53:'drizzle', 55:'overcast-drizzle',
  61:'rain', 63:'rain', 65:'overcast-rain',
  71:'partly-cloudy-night-snow', 73:'snow', 75:'overcast-snow',
  80:'partly-cloudy-night-rain', 81:'overcast-night-rain', 82:'overcast-night-rain',
  95:'thunderstorms', 96:'thunderstorms-rain', 99:'thunderstorms-rain',
};
function _wmoIcon(code, hour) {
  const isNight = hour !== undefined && (hour >= 20 || hour < 6);
  const map = isNight ? WMO_NIGHT : WMO_DAY;
  const name = map[code] ?? (isNight ? 'clear-night' : 'partly-cloudy-day');
  return `<img src="${CDN}/${name}.svg" width="48" height="48" alt="" style="display:inline-block;vertical-align:middle;flex-shrink:0" loading="lazy">`;
}

let _loading = false;
async function loadWeather() {
  if (_loading) return;
  _loading = true;
  el('w-loading').style.display = 'flex';
  el('w-error').style.display   = 'none';
  el('w-content').classList.remove('is-ready');
  el('w-stale-banner').style.display = 'none';

  let w, m, cachedAt = null;

  try {
    const weatherUrl = [
      `https://api.open-meteo.com/v1/forecast`,
      `?latitude=${LAT}&longitude=${LNG}`,
      `&current=temperature_2m,apparent_temperature,weather_code,wind_speed_10m,wind_direction_10m,uv_index,relative_humidity_2m`,
      `&hourly=temperature_2m,weather_code,wind_speed_10m,precipitation_probability`,
      `&daily=temperature_2m_max,temperature_2m_min,weather_code,precipitation_probability_max,sunrise,sunset`,
      `&timezone=Europe%2FAthens&forecast_days=7&models=ecmwf_ifs025`,
    ].join('');
    const marineUrl = [
      `https://marine-api.open-meteo.com/v1/marine`,
      `?latitude=${LAT}&longitude=${LNG}`,
      `&current=wave_height,sea_surface_temperature`,
      `&timezone=Europe%2FAthens&forecast_days=1`,
    ].join('');

    const timeout = AbortSignal.timeout(12000);
    const [wRes, mRes] = await Promise.all([
      fetch(weatherUrl, { signal: timeout }),
      fetch(marineUrl,  { signal: timeout }),
    ]);
    w = await wRes.json();
    if (w.error) throw new Error(w.reason ?? 'Weather API error');
    m = mRes.ok ? await mRes.json() : { current: null };
  } catch (liveErr) {
    console.warn('Live fetch failed, trying cache:', liveErr.message);
    try {
      const cacheRes = await fetch('/weather-cache.json');
      if (!cacheRes.ok) throw new Error('No cache');
      const cached = await cacheRes.json();
      w = cached.weather;
      m = cached.marine ?? { current: null };
      cachedAt = cached.cachedAt;
    } catch {
      el('w-loading').style.display = 'none';
      el('w-error').style.display   = 'block';
      _loading = false;
      return;
    }
  }

  try {
    const c = w.current;
    const waveH   = m.current?.wave_height ?? 0;
    const seaTemp = m.current?.sea_surface_temperature ?? null;

    // ── Hero
    const heroEl = document.getElementById('weather-hero');
    heroEl.classList.add(heroClass(c.weather_code));
    el('hero-icon').innerHTML         = _wmoIcon(c.weather_code);
    el('hero-temp').textContent      = `${Math.round(c.temperature_2m)}°`;
    el('hero-condition').textContent = WMO_TEXT[c.weather_code] ?? 'Unknown';
    el('hero-feels').textContent     = `Feels like ${Math.round(c.apparent_temperature)}°C`;
    el('hs-wind').textContent        = `${Math.round(c.wind_speed_10m)} km/h ${windDir(c.wind_direction_10m)}`;
    el('hs-sea').textContent         = seaTemp ? `${Math.round(seaTemp)}°C` : '–';
    el('hs-waves').textContent       = `${waveH.toFixed(1)} m`;
    el('hs-uv').textContent          = `${Math.round(c.uv_index)} — ${uvLevel(c.uv_index)[0]}`;
    el('hs-humidity').textContent    = `${Math.round(c.relative_humidity_2m)}%`;
    const now = new Date();
    el('hero-updated').textContent   = `Updated at ${now.toLocaleTimeString('en-US', { hour: 'numeric', minute: '2-digit', hour12: true })}`;

    // ── Wind card
    el('compass-needle-g').style.transform = `rotate(${c.wind_direction_10m}deg)`;
    el('w-wind-speed').textContent = `${Math.round(c.wind_speed_10m)} km/h`;
    el('w-wind-dir').textContent   = `${windDir(c.wind_direction_10m)} wind`;
    el('w-wind-tag').textContent   = beaufort(c.wind_speed_10m);

    // ── Sea & Waves card
    el('w-sea-temp').textContent  = seaTemp ? `${Math.round(seaTemp)}°C` : '–';
    const wavePct = Math.min(waveH / 3, 1) * 100;
    el('w-wave-fill').style.width = `${wavePct}%`;
    el('w-wave-val').textContent  = `${waveH.toFixed(1)} m`;
    const [waveTag] = waveDesc(waveH);
    el('w-wave-tag').textContent  = waveTag;

    // ── UV card
    const uvVal = Math.round(c.uv_index);
    const [uvLvl, uvTip] = uvLevel(c.uv_index);
    el('w-uv').textContent       = uvVal;
    el('w-uv-level').textContent = uvTip;
    el('w-uv-tag').textContent   = uvLvl;
    const uvPct = Math.min(c.uv_index / 11, 1) * 100;
    el('uv-marker').style.left   = `${uvPct}%`;

    // ── Humidity card
    el('w-humidity').textContent    = `${Math.round(c.relative_humidity_2m)}%`;
    el('w-humidity-sub').textContent = humidityDesc(c.relative_humidity_2m);

    // ── Range + Sun card
    el('w-temp-max').textContent = `${Math.round(w.daily.temperature_2m_max[0])}°C`;
    el('w-temp-min').textContent = `${Math.round(w.daily.temperature_2m_min[0])}°C`;
    el('w-sunrise').textContent  = formatTime(w.daily.sunrise[0]);
    el('w-sunset').textContent   = formatTime(w.daily.sunset[0]);

    // ── Beach recommendation
    const rec = recommendation(c.wind_speed_10m, c.wind_direction_10m, waveH);
    el('w-rec-emoji').textContent = rec.emoji;
    el('w-rec-title').textContent = rec.title;
    el('w-rec-desc').textContent  = rec.desc;
    const allCards = Array.from(document.querySelectorAll('#w-beaches-grid .w-beach-card'));
    // Hide every card first — w-content is still opacity:0 so no flash
    allCards.forEach(card => { card.style.display = 'none'; });
    const priority = allCards.filter(
      card => rec.filter === 'any' || card.dataset.shelter === rec.filter || card.dataset.shelter === 'any'
    );
    const pool = priority.length >= 6
      ? priority
      : [...priority, ...allCards.filter(card => !priority.includes(card))];
    pool.slice(0, 6).forEach(card => { card.style.display = 'flex'; });

    // ── 12-hour hourly
    const times = w.hourly.time;
    const temps = w.hourly.temperature_2m;
    const codes = w.hourly.weather_code;
    const winds = w.hourly.wind_speed_10m;
    const pops  = w.hourly.precipitation_probability;
    const currentHour = now.getHours();
    let startIdx = times.findIndex(t => new Date(t).getHours() >= currentHour);
    if (startIdx < 0) startIdx = 0;

    function hourBg(h) {
      if (h >= 6  && h < 9)  return 'linear-gradient(135deg,#ffedd5 0%,#fed7aa 100%)';
      if (h >= 9  && h < 13) return 'linear-gradient(135deg,#fef9c3 0%,#fde68a 100%)';
      if (h >= 13 && h < 17) return 'linear-gradient(135deg,#dbeafe 0%,#bfdbfe 100%)';
      if (h >= 17 && h < 20) return 'linear-gradient(135deg,#ffe4e6 0%,#fecaca 100%)';
      return 'linear-gradient(135deg,#ede9fe 0%,#c7d2fe 100%)';
    }

    el('w-hourly').innerHTML = times.slice(startIdx, startIdx + 12).map((t, i) => {
      const idx = startIdx + i;
      const h = new Date(t).getHours();
      const isNow = i === 0;
      const rainPct = pops?.[idx] ?? 0;
      const bgStyle = isNow ? '' : `style="background:${hourBg(h)};border-color:transparent"`;
      return `<div class="w-fc-item${isNow ? ' is-now' : ''}" ${bgStyle}>
        <span class="w-fc-time">${isNow ? 'Now' : formatHour(h)}</span>
        <span class="w-fc-icon">${_wmoIcon(codes[idx], h)}</span>
        <span class="w-fc-temp">${Math.round(temps[idx])}°</span>
        <span class="w-fc-wind">${Math.round(winds[idx])} km/h</span>
        ${rainPct >= 15 ? `<span class="w-fc-rain">💧 ${rainPct}%</span>` : '<span class="w-fc-rain-placeholder"></span>'}
      </div>`;
    }).join('');

    // ── 7-day outlook
    const dayPalette = [
      'linear-gradient(135deg,#dbeafe 0%,#bfdbfe 100%)',
      'linear-gradient(135deg,#dcfce7 0%,#bbf7d0 100%)',
      'linear-gradient(135deg,#fef9c3 0%,#fde68a 100%)',
      'linear-gradient(135deg,#ffedd5 0%,#fed7aa 100%)',
      'linear-gradient(135deg,#fce7f3 0%,#fbcfe8 100%)',
      'linear-gradient(135deg,#ede9fe 0%,#ddd6fe 100%)',
      'linear-gradient(135deg,#ccfbf1 0%,#99f6e4 100%)',
    ];
    el('w-week').innerHTML = w.daily.time.map((d, i) => {
      const isToday  = i === 0;
      const dayMax   = Math.round(w.daily.temperature_2m_max[i]);
      const dayMin   = Math.round(w.daily.temperature_2m_min[i]);
      const rainPct  = w.daily.precipitation_probability_max[i] ?? 0;
      const condFull = WMO_TEXT[w.daily.weather_code[i]] ?? '';
      const condShort = condFull.split(' ').slice(0, 2).join(' ');
      const dayBgStyle = isToday ? '' : `style="background:${dayPalette[i % dayPalette.length]};border-color:transparent"`;
      return `
      <div class="w-day${isToday ? ' is-today' : ''}" ${dayBgStyle}>
        <span class="w-day-name">${dayLabel(d, i)}</span>
        <span class="w-day-icon">${_wmoIcon(w.daily.weather_code[i])}</span>
        <span class="w-day-cond">${condShort}</span>
        <span class="w-day-high">${dayMax}°</span>
        <span class="w-day-low">${dayMin}°</span>
        ${rainPct >= 10
          ? `<span class="w-day-rain">💧 ${rainPct}%</span>`
          : '<span class="w-day-rain-ph"></span>'}
      </div>`;
    }).join('');

    // ── Show stale banner if using cache
    if (cachedAt) {
      const d = new Date(cachedAt);
      el('w-stale-time').textContent = d.toLocaleString('en-US', {
        month: 'short', day: 'numeric', hour: 'numeric', minute: '2-digit', hour12: true,
      });
      el('w-stale-banner').style.display = 'block';
    }

    // ── Show content
    el('w-loading').style.display = 'none';
    requestAnimationFrame(() => el('w-content').classList.add('is-ready'));
  } catch (err) {
    console.error(err);
    el('w-loading').style.display = 'none';
    el('w-error').style.display   = 'block';
  } finally {
    _loading = false;
  }
}

document.getElementById('w-retry-btn').addEventListener('click', loadWeather);
loadWeather();
</script>