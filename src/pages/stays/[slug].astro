---
import Layout from '../../layouts/Layout.astro';
import SmartImage from '../../components/SmartImage.astro';
import accommodationsRaw from '../../data/stays.json';
import cjData from '../../data/cj-hotels.json';

type Accommodation = typeof accommodationsRaw[number] & { localPhoto?: string | null };
const accommodationsData = accommodationsRaw as Accommodation[];

export function getStaticPaths() {
  return accommodationsRaw.map((a) => ({
    params: { slug: a.slug },
    props:  { accommodation: a },
  }));
}

const { accommodation: a } = Astro.props;

const getName = (acc: any): string => typeof acc.name === 'object' ? acc.name.en : acc.name;
const getDesc = (acc: any): string => typeof acc.description === 'object' ? acc.description.en : acc.description;

const typeLabels: Record<string, { label: string; icon: string }> = {
  hotel:      { label: 'Hotel',      icon: '🏨' },
  studio:     { label: 'Studios',    icon: '🏠' },
  villa:      { label: 'Villa',      icon: '🏡' },
  guesthouse: { label: 'Guesthouse', icon: '🛖' },
};
const typeInfo = typeLabels[a.type] ?? { label: a.type, icon: '🏠' };

// ── Booking.com affiliate ─────────────────────────────────────────────────
const BOOKING_AID = import.meta.env.BOOKING_AID || '';
const hotelName   = getName(a);

function bookingUrl(query: string): string {
  const base = `https://www.booking.com/searchresults.html?ss=${encodeURIComponent(query)}&lang=en-gb`;
  return BOOKING_AID ? `${base}&aid=${BOOKING_AID}` : `${base}&utm_source=milos.guide`;
}

const primaryBookingUrl = bookingUrl(`${hotelName} Milos Greece`);

// ── CJ Affiliate data (activated after joining hotel programs on CJ) ───────
const cjProduct  = ((cjData as any).travelProducts ?? [] as any[]).find((p: any) => {
  const t = (p.title ?? '').toLowerCase();
  const n = hotelName.toLowerCase();
  return t.includes(n.slice(0, 12)) || n.includes(t.slice(0, 12));
});

// Related: same area, not this one, up to 3
const related = accommodationsData
  .filter(r => r.slug !== a.slug && r.location.area === a.location.area)
  .sort((x, y) => y.rating - x.rating)
  .slice(0, 3);

const _siteUrl = 'https://milos.guide';
const schemaTypeMap: Record<string, string> = {
  hotel:      'Hotel',
  studio:     'LodgingBusiness',
  villa:      'LodgingBusiness',
  guesthouse: 'BedAndBreakfast',
};
const staysJsonld = {
  '@context': 'https://schema.org',
  '@type': schemaTypeMap[a.type] ?? 'LodgingBusiness',
  name: getName(a),
  description: getDesc(a),
  url: `${_siteUrl}/stays/${a.slug}`,
  ...(a.localPhoto ? { image: (a.localPhoto as string).startsWith('http') ? a.localPhoto : _siteUrl + a.localPhoto } : {}),
  ...(a.coordinates?.lat ? {
    geo: { '@type': 'GeoCoordinates', latitude: a.coordinates.lat, longitude: a.coordinates.lng },
  } : {}),
  address: {
    '@type': 'PostalAddress',
    addressLocality: a.location.area ?? 'Milos',
    streetAddress: a.location.address ?? '',
    addressRegion: 'South Aegean',
    addressCountry: 'GR',
  },
  ...(a.phone ? { telephone: a.phone } : {}),
  ...(a.website ? { sameAs: a.website } : {}),
  ...((a as any).googleMapsUri ? { hasMap: (a as any).googleMapsUri } : {}),
  ...(a.amenities?.length ? {
    amenityFeature: a.amenities.map((f: string) => ({ '@type': 'LocationFeatureSpecification', name: f, value: true })),
  } : {}),
  containedInPlace: { '@type': 'TouristDestination', '@id': `${_siteUrl}/#milos`, name: 'Milos' },
};
---

<Layout
  lang="en"
  title={`${getName(a)} — ${typeInfo.label} in Milos`}
  description={`${getName(a)} in ${a.location.area}, Milos. ${typeInfo.label} · Rating ${a.rating}/5.`}
  jsonld={staysJsonld}
>

<!-- HERO -->
<div class="a-hero">
  {a.localPhoto ? (
    <SmartImage src={a.localPhoto} alt={getName(a)} width={1280} height={500} isLCP={true} class="a-hero-img" sizes="100vw" />
  ) : (
    <div class="a-hero-ph"></div>
  )}
  <div class="a-hero-overlay">
    <div class="container a-hero-inner">
      <a href="/stays" class="back-link">← All accommodation</a>
      <div class="a-hero-meta">
        <span class="a-type-badge">{typeInfo.icon} {typeInfo.label}</span>
        <h1 class="a-hero-name">{getName(a)}</h1>
        <p class="a-hero-area">
          <span style="color:var(--sky)">◉</span> {a.location.area}
        </p>
      </div>
    </div>
  </div>
</div>

<!-- CONTENT -->
<div class="container a-layout">

  <main class="a-main">

    <!-- Quick bar -->
    <div class="quick-bar">
      {a.rating > 0 && (
        <div class="qb-item">
          <span class="qb-icon">★</span>
          <span class="qb-val">{a.rating}</span>
          <span class="qb-label">/ 5</span>
        </div>
      )}
      <div class="qb-item">
        <span class="qb-icon">{typeInfo.icon}</span>
        <span class="qb-val">{typeInfo.label}</span>
      </div>
      {a.location.area && (
        <div class="qb-item">
          <span class="qb-icon">📍</span>
          <span class="qb-val">{a.location.area}</span>
        </div>
      )}
      {a.priceLevel && (
        <div class="qb-item">
          <span class="qb-val">{a.priceLevel}</span>
          <span class="qb-label">price range</span>
        </div>
      )}
    </div>

    <!-- Description -->
    <p class="a-desc">{getDesc(a)}</p>

    <!-- Why stay here -->
    <div class="why-block">
      <h2 class="block-title">Why stay here</h2>
      <div class="why-grid">
        <div class="why-item">
          <span class="why-icon">📍</span>
          <div>
            <p class="why-title">Location</p>
            <p class="why-body">{a.location.area} — {a.location.address?.split(',').slice(0,2).join(',') || a.location.area + ', Milos'}</p>
          </div>
        </div>
        {a.rating > 0 && (
          <div class="why-item">
            <span class="why-icon">⭐</span>
            <div>
              <p class="why-title">Guest rating</p>
              <p class="why-body">{a.rating} out of 5 on Google</p>
            </div>
          </div>
        )}
        <div class="why-item">
          <span class="why-icon">{typeInfo.icon}</span>
          <div>
            <p class="why-title">Type</p>
            <p class="why-body">{typeInfo.label} in {a.location.area}</p>
          </div>
        </div>
        {a.phone && (
          <div class="why-item">
            <span class="why-icon">📞</span>
            <div>
              <p class="why-title">Contact</p>
              <p class="why-body"><a href={`tel:${a.phone}`} class="why-link">{a.phone}</a></p>
            </div>
          </div>
        )}
      </div>
    </div>

    <!-- Map -->
    {a.coordinates?.lat && a.coordinates?.lng && (
      <div class="map-block">
        <h2 class="block-title">Location</h2>
        <div class="map-embed-wrap">
          <iframe
            title={`Map of ${getName(a)}`}
            width="100%"
            height="300"
            style="border:0; border-radius: var(--radius-md); display: block;"
            loading="lazy"
            allowfullscreen
            referrerpolicy="no-referrer-when-downgrade"
            src={`https://www.google.com/maps?q=${a.coordinates.lat},${a.coordinates.lng}&z=15&output=embed`}
          ></iframe>
        </div>
        {a.googleMapsUri && (
          <a href={a.googleMapsUri} target="_blank" rel="noopener noreferrer" class="map-open-link">
            Open in Google Maps ↗
          </a>
        )}
      </div>
    )}

    <!-- Amenities -->
    {a.amenities?.length > 0 && (
      <div class="amenities-block">
        <h2 class="block-title">Amenities</h2>
        <div class="amenities-grid">
          {a.amenities.map((item: string) => (
            <div class="amenity-item">
              <span class="amenity-check">✓</span>
              <span>{item}</span>
            </div>
          ))}
        </div>
      </div>
    )}

  </main>

  <!-- SIDEBAR -->
  <aside class="a-sidebar">

    {a.rating > 0 && (
      <div class="s-card">
        <p class="s-card-label">Rating</p>
        <div class="s-rating">
          <span class="s-rating-num">{a.rating}</span>
          <div class="s-rating-right">
            <span class="s-rating-stars">{'★'.repeat(Math.round(a.rating))}{'☆'.repeat(5 - Math.round(a.rating))}</span>
            <span class="s-rating-sub">out of 5</span>
          </div>
        </div>
      </div>
    )}

    <div class="s-card">
      <p class="s-card-label">Details</p>
      <ul class="s-info-list">
        <li class="s-info-row">
          <span class="s-info-key">Type</span>
          <span class="s-info-val">{typeInfo.icon} {typeInfo.label}</span>
        </li>
        {a.location.area && (
          <li class="s-info-row">
            <span class="s-info-key">Area</span>
            <span class="s-info-val">{a.location.area}</span>
          </li>
        )}
        {a.phone && (
          <li class="s-info-row">
            <span class="s-info-key">Phone</span>
            <a href={`tel:${a.phone}`} class="s-info-link">{a.phone}</a>
          </li>
        )}
        {a.location.address && (
          <li class="s-info-row">
            <span class="s-info-key">Address</span>
            <span class="s-info-val s-info-addr">{a.location.address}</span>
          </li>
        )}
      </ul>
    </div>

    <!-- Booking.com primary CTA -->
    <div class="s-book-card">
      <div class="s-book-header">
        <svg class="s-book-logo" viewBox="0 0 100 24" fill="none" xmlns="http://www.w3.org/2000/svg" aria-label="Booking.com">
          <text x="0" y="20" font-family="sans-serif" font-weight="700" font-size="18" fill="#003580">Booking</text>
          <text x="67" y="20" font-family="sans-serif" font-weight="700" font-size="18" fill="#003580">.</text>
          <text x="73" y="20" font-family="sans-serif" font-weight="700" font-size="18" fill="#e31e24">com</text>
        </svg>
        <span class="s-book-badge">Free cancellation</span>
      </div>
      <p class="s-book-desc">Search for available dates and best prices for {hotelName}.</p>
      <a
        href={primaryBookingUrl}
        target="_blank"
        rel="noopener sponsored"
        class="s-book-btn"
      >
        Check availability →
      </a>
      <p class="s-book-note">You'll be redirected to Booking.com</p>
    </div>

    <!-- CJ deal (shown when hotel programs are joined & fetched) -->
    {cjProduct && (
      <div class="s-card s-deal-card">
        <p class="s-card-label">Available deal</p>
        <p class="s-deal-name">{cjProduct.title}</p>
        {cjProduct.price?.amount && (
          <p class="s-deal-price">
            {cjProduct.salePrice?.amount && cjProduct.salePrice.amount !== cjProduct.price.amount && (
              <span class="s-deal-was">{cjProduct.salePrice.amount} {cjProduct.salePrice.currency}</span>
            )}
            <span class="s-deal-now">{cjProduct.price.amount} {cjProduct.price.currency}</span>
          </p>
        )}
        <a href={cjProduct.link} target="_blank" rel="noopener sponsored" class="s-btn s-btn--deal">
          Book this deal ↗
        </a>
        <p class="s-deal-via">via {cjProduct.advertiserName}</p>
      </div>
    )}

    <div class="s-ctas">
      {a.googleMapsUri && (
        <a href={a.googleMapsUri} target="_blank" rel="noopener noreferrer" class="s-btn s-btn--maps">
          <span>📍</span> Google Maps ↗
        </a>
      )}
      {a.website && (
        <a href={a.website} target="_blank" rel="noopener noreferrer" class="s-btn s-btn--web">
          <span>🌐</span> Website ↗
        </a>
      )}
    </div>

  </aside>

</div>

<!-- RELATED -->
{related.length > 0 && (
  <section class="sec sec-sand related-sec">
    <div class="container">
      <div class="sec-hdr-row">
        <div>
          <span class="label">Same area</span>
          <h2 class="sec-title">More in {a.location.area}</h2>
        </div>
        <a href="/stays" class="see-all">All accommodation →</a>
      </div>
      <div class="related-grid">
        {related.map(r => (
          <a href={`/stays/${r.slug}`} class="rel-card">
            <div class="rel-img-wrap">
              {r.localPhoto ? (
                <SmartImage src={r.localPhoto} alt={getName(r)} width={400} height={300} class="rel-img" sizes="(max-width: 768px) 100vw, 33vw" />
              ) : (
                <div class="rel-ph"></div>
              )}
            </div>
            <div class="rel-body">
              <p class="rel-type">{typeLabels[r.type]?.icon} {typeLabels[r.type]?.label}</p>
              <h3 class="rel-name">{getName(r)}</h3>
              {r.rating > 0 && <p class="rel-rating">★ {r.rating}</p>}
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>
)}

</Layout>

<style>
/* HERO */
.a-hero { position: relative; height: 500px; overflow: hidden; background: var(--deep-blue); }
:global(.a-hero-img) { width: 100%; height: 100%; object-fit: cover; display: block; }
.a-hero-ph { width: 100%; height: 100%; background: linear-gradient(140deg, #0d2b4e, #1a5c8a); }
.a-hero-overlay {
  position: absolute; inset: 0;
  background: linear-gradient(to top, rgba(0,0,0,.72) 0%, rgba(0,0,0,.1) 55%, transparent 100%);
  display: flex; flex-direction: column; justify-content: flex-end;
}
.a-hero-inner { padding-bottom: 2.5rem; }
.back-link {
  position: absolute; top: 1.5rem; left: 1.5rem;
  font-size: .75rem; font-weight: 600; letter-spacing: .05em; text-transform: uppercase;
  color: #fff; background: rgba(0,0,0,.35); backdrop-filter: blur(6px);
  padding: .35rem .85rem; border-radius: 100px; transition: background .15s;
}
.back-link:hover { background: rgba(0,0,0,.55); }
.a-type-badge {
  display: inline-block; font-size: .6rem; font-weight: 700; letter-spacing: .07em;
  text-transform: uppercase; background: rgba(255,255,255,.15); border: 1px solid rgba(255,255,255,.2);
  color: #fff; padding: 3px 10px; border-radius: 100px; margin-bottom: .5rem; backdrop-filter: blur(6px);
}
.a-hero-name {
  font-family: var(--font-serif); font-size: clamp(2rem, 5vw, 3.5rem);
  color: #fff; line-height: 1.05; margin: 0 0 .4rem;
  text-shadow: 0 2px 12px rgba(0,0,0,.3);
}
.a-hero-area { font-size: .8rem; font-weight: 600; text-transform: uppercase; letter-spacing: .08em; color: rgba(255,255,255,.75); margin: 0; }

/* LAYOUT */
.a-layout { display: grid; grid-template-columns: 1fr 300px; gap: 3rem; padding-top: 2.5rem; padding-bottom: 4rem; align-items: start; }

/* QUICK BAR */
.quick-bar { display: flex; align-items: center; background: var(--white); border: 1px solid var(--border); border-radius: var(--radius-md); overflow: hidden; margin-bottom: 2rem; }
.qb-item { display: flex; align-items: center; gap: .4rem; padding: .9rem 1.25rem; border-right: 1px solid var(--border); flex-shrink: 0; }
.qb-item:last-child { border-right: none; }
.qb-icon { font-size: .9rem; }
.qb-val { font-size: .95rem; font-weight: 600; color: var(--ink); }
.qb-label { font-size: .72rem; color: var(--muted); }

/* MAIN */
.a-desc { font-size: 1.05rem; line-height: 1.8; color: var(--ink); margin-bottom: 2rem; }
.amenities-block { margin-bottom: 2rem; }
.block-title { font-size: .65rem; font-weight: 700; letter-spacing: .12em; text-transform: uppercase; color: var(--muted); margin-bottom: 1rem; }
.amenities-grid { display: grid; grid-template-columns: 1fr 1fr; gap: .5rem; }
.amenity-item { display: flex; align-items: center; gap: .6rem; font-size: .875rem; color: var(--ink); padding: .6rem .85rem; background: var(--white); border: 1px solid var(--border); border-radius: var(--radius-sm); }
.amenity-check { color: var(--sea); font-weight: 700; flex-shrink: 0; }

/* SIDEBAR */
.a-sidebar { display: flex; flex-direction: column; gap: 1rem; position: sticky; top: calc(var(--header-h) + 1.5rem); }

/* Booking.com card */
.s-book-card {
  background: #fff;
  border: 2px solid #003580;
  border-radius: var(--radius-md);
  padding: 1.25rem;
  display: flex;
  flex-direction: column;
  gap: .7rem;
}
.s-book-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: .5rem;
}
.s-book-logo { width: 100px; height: 24px; flex-shrink: 0; }
.s-book-badge {
  font-size: .6rem;
  font-weight: 700;
  letter-spacing: .05em;
  text-transform: uppercase;
  color: #0e7a3e;
  background: #d1fae5;
  border-radius: 100px;
  padding: 2px 8px;
  white-space: nowrap;
}
.s-book-desc {
  font-size: .82rem;
  color: var(--muted);
  line-height: 1.5;
  margin: 0;
}
.s-book-btn {
  display: block;
  background: #003580;
  color: #fff;
  text-align: center;
  padding: .85rem 1rem;
  border-radius: var(--radius-md);
  font-family: var(--font-sans);
  font-size: .95rem;
  font-weight: 700;
  transition: background .15s, transform .15s;
  letter-spacing: .01em;
}
.s-book-btn:hover { background: #002050; transform: translateY(-1px); }
.s-book-note {
  font-size: .65rem;
  color: var(--muted);
  text-align: center;
  margin: 0;
}
.s-card { background: var(--white); border: 1px solid var(--border); border-radius: var(--radius-md); padding: 1.25rem; }
.s-card-label { font-size: .62rem; font-weight: 700; letter-spacing: .12em; text-transform: uppercase; color: var(--muted); margin-bottom: .85rem; }
.s-rating { display: flex; align-items: center; gap: .85rem; }
.s-rating-num { font-family: var(--font-serif); font-size: 2.8rem; color: var(--ink); line-height: 1; }
.s-rating-right { display: flex; flex-direction: column; gap: .15rem; }
.s-rating-stars { font-size: .9rem; color: #d97706; letter-spacing: .1em; }
.s-rating-sub { font-size: .72rem; color: var(--muted); }
.s-info-list { list-style: none; padding: 0; margin: 0; display: flex; flex-direction: column; gap: .6rem; }
.s-info-row { display: flex; justify-content: space-between; align-items: flex-start; font-size: .875rem; gap: .5rem; }
.s-info-key { font-weight: 600; color: var(--muted); flex-shrink: 0; }
.s-info-val { color: var(--ink); text-align: right; }
.s-info-addr { font-size: .78rem; color: var(--muted); text-align: right; line-height: 1.4; }
.s-info-link { color: var(--aegean); font-weight: 500; }
.s-ctas { display: flex; flex-direction: column; gap: .6rem; }
.s-btn { display: flex; align-items: center; justify-content: center; gap: .5rem; padding: .8rem 1rem; border-radius: var(--radius-md); font-family: var(--font-sans); font-size: .875rem; font-weight: 600; transition: transform .15s, opacity .15s; }
.s-btn:hover { transform: translateY(-1px); opacity: .9; }
.s-btn--maps    { background: var(--deep-blue); color: #fff; box-shadow: var(--shadow-sm); }
.s-btn--web     { background: var(--white); color: var(--ink); border: 1px solid var(--border); }
.s-btn--booking { background: #003580; color: #fff; box-shadow: var(--shadow-sm); }
.s-btn--deal    { background: #0e7a3e; color: #fff; box-shadow: var(--shadow-sm); }

/* Deal card */
.s-deal-card { border-color: #0e7a3e33; }
.s-deal-name { font-size: .875rem; color: var(--ink); line-height: 1.4; margin-bottom: .6rem; }
.s-deal-price { display: flex; align-items: baseline; gap: .5rem; margin-bottom: .8rem; }
.s-deal-was { font-size: .8rem; color: var(--muted); text-decoration: line-through; }
.s-deal-now { font-size: 1.4rem; font-weight: 700; font-family: var(--font-serif); color: #0e7a3e; }
.s-deal-via { font-size: .68rem; color: var(--muted); text-align: center; margin-top: .4rem; }

/* RELATED */
.related-sec { margin-top: 0; }
.related-grid { display: grid; grid-template-columns: repeat(3,1fr); gap: 1rem; }
.rel-card { display: flex; flex-direction: column; background: var(--white); border: 1px solid var(--border); border-radius: var(--radius-md); overflow: hidden; transition: transform .2s, box-shadow .2s; }
.rel-card:hover { transform: translateY(-3px); box-shadow: var(--shadow-md); }
.rel-img-wrap { height: 140px; overflow: hidden; background: var(--sand); flex-shrink: 0; }
:global(.rel-img) { width: 100%; height: 100%; object-fit: cover; display: block; transition: transform .4s; }
.rel-card:hover :global(.rel-img) { transform: scale(1.05); }
.rel-ph { width: 100%; height: 100%; background: linear-gradient(140deg, #0d2b4e, #1a5c8a); }
.rel-body { padding: .9rem 1rem 1rem; display: flex; flex-direction: column; gap: .2rem; }
.rel-type { font-size: .65rem; font-weight: 600; letter-spacing: .08em; text-transform: uppercase; color: var(--sea); }
.rel-name { font-family: var(--font-serif); font-size: 1rem; color: var(--ink); line-height: 1.25; }
.rel-rating { font-size: .78rem; color: #d97706; font-weight: 600; margin-top: .15rem; }

/* WHY STAY */
.why-block { margin-bottom: 2rem; }
.why-grid {
  display: flex;
  flex-direction: column;
  gap: 0;
  border: 1px solid var(--border);
  border-radius: var(--radius-md);
  overflow: hidden;
}
.why-item {
  display: flex;
  align-items: flex-start;
  gap: 1rem;
  padding: 1rem 1.25rem;
  border-bottom: 1px solid var(--border);
  background: var(--white);
}
.why-item:last-child { border-bottom: none; }
.why-item:nth-child(even) { background: var(--sand); }
.why-icon { font-size: 1.1rem; flex-shrink: 0; margin-top: 0.1rem; }
.why-title { font-size: .78rem; font-weight: 600; color: var(--muted); text-transform: uppercase; letter-spacing: .06em; margin-bottom: .2rem; }
.why-body { font-size: .9rem; color: var(--ink); margin: 0; line-height: 1.5; }
.why-link { color: var(--aegean); }
.why-link:hover { text-decoration: underline; }

/* MAP */
