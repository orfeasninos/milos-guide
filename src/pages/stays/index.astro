---
import Layout from '../../layouts/Layout.astro';
import SmartImage from '../../components/SmartImage.astro';
import { stayPhoto } from '../../lib/public-files';
import { bookingSearch } from '../../lib/booking';
import { areaVillageSlug } from '../../lib/restaurants';
import { stays, stayTypes, stayType, areaNotes } from '../../lib/stays';

const list = stays.map(s => ({
  ...s,
  area: s.location.area,
  kind: stayType(s),
  photo: stayPhoto(s),
}));

const types = Object.keys(stayTypes).filter(t => list.some(s => s.type === t));

// Busiest areas first.
const areaCounts = list.reduce<Record<string, number>>((acc, s) => {
  acc[s.area] = (acc[s.area] ?? 0) + 1;
  return acc;
}, {});
const areas = Object.keys(areaCounts).sort((a, b) => areaCounts[b] - areaCounts[a] || a.localeCompare(b));

const areaGuide = Object.entries(areaNotes).map(([area, note]) => ({
  area,
  note,
  village: areaVillageSlug(area),
  url: bookingSearch(area, `stays-area-${area.toLowerCase()}`),
}));

const _siteUrl = 'https://milos.guide';
const staysJsonld = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: 'Where to stay in Milos',
  description: `Where to stay in Milos: ${list.length} hotels, studios and villas in Adamas, Pollonia, Plaka and beyond.`,
  url: `${_siteUrl}/stays/`,
  numberOfItems: list.length,
  itemListElement: list.map((s, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    name: s.name.en,
    url: `${_siteUrl}/stays/${s.slug}/`,
  })),
};
---

<Layout
  lang="en"
  title="Where to Stay in Milos"
  description={`Where to stay in Milos: Adamas, Pollonia or Plaka? A short guide to each area plus ${list.length} hotels, studios and villas, with links to live prices.`}
  jsonld={staysJsonld}
>

<!-- PAGE HERO -->
<section class="page-hero">
  <div class="container">
    <p class="page-label">Stay</p>
    <h1 class="page-title">Where to stay in Milos</h1>
    <p class="page-desc">
      Pick the area first, then the place. Adamas for convenience, Pollonia for calm, Plaka for sunsets.{' '}
      {list.length} hotels, studios and villas across the island.
    </p>
  </div>
</section>

<!-- AREA GUIDE -->
<section class="area-sec">
  <div class="container">
    <div class="area-hdr">
      <span class="label">Choose your base</span>
      <h2 class="area-title">The three main areas</h2>
    </div>
    <div class="area-grid">
      {areaGuide.map(a => (
        <div class="area-card">
          <h3 class="area-name">
            {a.village ? <a href={`/villages/${a.village}/`}>{a.area}</a> : a.area}
          </h3>
          <p class="area-note">{a.note}</p>
          <a
            href={a.url}
            target="_blank"
            rel="sponsored noopener"
            class="area-cta"
            data-umami-event="booking-area"
            data-umami-event-area={a.area}
          >
            Stays in {a.area} ↗
          </a>
        </div>
      ))}
    </div>
    <p class="aff-note">Links to Booking.com are affiliate links: if you book through them we may earn a commission, at no extra cost to you.</p>
  </div>
</section>

<!-- FILTERS -->
<div class="filters-bar">
  <div class="container">
    <div class="filters-inner filters-inner--top">
      <div class="filter-chips" id="type-chips">
        <button class="chip chip--active" data-type="all">All</button>
        {types.map(t => (
          <button class="chip" data-type={t}>{stayTypes[t].icon} {stayTypes[t].plural}</button>
        ))}
      </div>
    </div>
    <div class="filters-inner filters-inner--bottom">
      <div class="filter-chips" id="area-chips">
        <button class="chip chip--active" data-area="all">All areas</button>
        {areas.map(a => (
          <button class="chip" data-area={a}>{a} <span class="chip-count">{areaCounts[a]}</span></button>
        ))}
      </div>
      <span class="results-count" id="results-count">{list.length} places</span>
    </div>
  </div>
</div>

<!-- GRID -->
<section class="sec sec-sand">
  <div class="container">
    <div class="stay-grid" id="stay-grid">
      {list.map(s => (
        <a href={`/stays/${s.slug}/`} class="sc" data-area={s.area} data-type={s.type}>
          {s.photo && (
            <SmartImage src={s.photo} alt={s.name.en} width={640} height={360} class="sc-img" sizes="(max-width: 768px) 100vw, 33vw" />
          )}
          <span class="sc-area">{s.kind.icon} {s.kind.label} · {s.area}</span>
          <h2 class="sc-name">{s.name.en}</h2>
          <p class="sc-desc">{s.description.en}</p>
        </a>
      ))}
    </div>

    <div class="empty-state" id="empty-state" style="display:none">
      <p class="empty-text">No places found with these filters.</p>
      <button class="btn-dark" id="reset-filters">Show all</button>
    </div>
  </div>
</section>

<!-- INFO STRIP -->
<section class="sec sec-white">
  <div class="container">
    <div class="info-grid">
      <div class="info-card">
        <h3 class="info-title">Book early for summer</h3>
        <p class="info-text">Milos has far fewer beds than Santorini or Mykonos. For July and August, book two to four months ahead, especially in Pollonia and Plaka.</p>
      </div>
      <div class="info-card">
        <h3 class="info-title">Car or no car</h3>
        <p class="info-text">Without a car, stay in Adamas: buses and boat trips leave from the port. With a car, any base works, since nowhere on the island is more than 30 minutes away.</p>
      </div>
      <div class="info-card">
        <h3 class="info-title">Shoulder season</h3>
        <p class="info-text">June and September bring warm seas, quieter beaches and noticeably lower prices. Most places open from April or May to October.</p>
      </div>
    </div>
  </div>
</section>


<script>
const grid    = document.getElementById('stay-grid');
const empty   = document.getElementById('empty-state');
const counter = document.getElementById('results-count');

let activeArea = 'all';
let activeType = 'all';

function applyFilters() {
  const cards = grid?.querySelectorAll<HTMLElement>('.sc') ?? [];
  let visible = 0;
  cards.forEach(card => {
    const show = (activeArea === 'all' || card.dataset.area === activeArea)
              && (activeType === 'all' || card.dataset.type === activeType);
    card.style.display = show ? '' : 'none';
    if (show) visible++;
  });
  if (counter) counter.textContent = `${visible} place${visible !== 1 ? 's' : ''}`;
  if (empty)   empty.style.display = visible === 0 ? 'block' : 'none';
  if (grid)    grid.style.display  = visible === 0 ? 'none'  : '';
}

function setArea(area: string) {
  activeArea = area;
  document.querySelectorAll<HTMLButtonElement>('#area-chips .chip').forEach(c =>
    c.classList.toggle('chip--active', c.dataset.area === area));
  applyFilters();
}

function setType(type: string) {
  activeType = type;
  document.querySelectorAll<HTMLButtonElement>('#type-chips .chip').forEach(c =>
    c.classList.toggle('chip--active', c.dataset.type === type));
  applyFilters();
}

document.querySelectorAll<HTMLButtonElement>('#area-chips .chip').forEach(chip => {
  chip.addEventListener('click', () => setArea(chip.dataset.area ?? 'all'));
});
document.querySelectorAll<HTMLButtonElement>('#type-chips .chip').forEach(chip => {
  chip.addEventListener('click', () => setType(chip.dataset.type ?? 'all'));
});

document.getElementById('reset-filters')?.addEventListener('click', () => { setType('all'); setArea('all'); });

// Stay pages link to /stays/?area=Pollonia
const initial = new URLSearchParams(location.search).get('area');
if (initial && document.querySelector(`#area-chips .chip[data-area="${CSS.escape(initial)}"]`)) setArea(initial);
</script>
</Layout>


<style>
/* ── PAGE HERO ── */
.page-hero {
  background: var(--white);
  padding: 3rem 0 2.5rem;
  border-bottom: 1px solid var(--border);
}
.page-label {
  font-size: 0.68rem;
  font-weight: 600;
  letter-spacing: 0.14em;
  text-transform: uppercase;
  color: var(--sea);
  margin-bottom: 0.4rem;
}
.page-title {
  font-family: var(--font-serif);
  font-size: clamp(2rem, 5vw, 3.2rem);
  color: var(--deep-blue);
  line-height: 1.1;
  margin-bottom: 0.75rem;
}
.page-desc {
  font-size: 1rem;
  color: var(--muted);
  max-width: 540px;
  line-height: 1.7;
}

/* ── AREA GUIDE ── */
.area-sec {
  padding: 3rem 0 2.5rem;
  background: var(--white);
  border-bottom: 1px solid var(--border);
}
.area-hdr { margin-bottom: 1.25rem; }
.area-title {
  font-family: var(--font-serif);
  font-size: 1.5rem;
  color: var(--deep-blue);
  margin: 0.2rem 0 0;
}
.area-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 1rem;
}
.area-card {
  display: flex;
  flex-direction: column;
  gap: 0.6rem;
  padding: 1.5rem 1.4rem;
  border-radius: var(--radius-lg);
  background: linear-gradient(140deg, #0d2b4e, #1a5c8a 70%, #2a7faa);
  color: #fff;
}
.area-name {
  font-family: var(--font-serif);
  font-size: 1.45rem;
  line-height: 1.15;
  margin: 0;
}
.area-name a { color: #fff; border-bottom: 1px solid rgba(255,255,255,.35); }
.area-name a:hover { border-bottom-color: #fff; }
.area-note {
  font-size: 0.85rem;
  line-height: 1.6;
  color: rgba(255,255,255,.75);
  margin: 0;
  flex: 1;
}
.area-cta {
  align-self: flex-start;
  margin-top: 0.4rem;
  padding: 0.55rem 1rem;
  border-radius: var(--radius-md);
  background: #fff;
  color: var(--deep-blue);
  font-size: 0.82rem;
  font-weight: 600;
  transition: transform .15s, opacity .15s;
}
.area-cta:hover { transform: translateY(-1px); opacity: .92; color: var(--deep-blue); }
.aff-note { font-size: 0.72rem; color: var(--muted); margin-top: 1rem; }

/* ── FILTERS ── */
.filters-bar {
  position: sticky;
  top: calc(var(--header-h) - 5px);
  z-index: 100;
  background: rgba(255,255,255,0.95);
  backdrop-filter: blur(12px);
  -webkit-backdrop-filter: blur(12px);
  border-bottom: 1px solid var(--border);
}
.filters-inner {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 1rem;
  padding-top: 0.6rem;
  padding-bottom: 0.6rem;
}
.filters-inner--top { padding-bottom: 0.4rem; }
.filters-inner--bottom { padding-top: 0; }
.filter-chips { display: flex; gap: 0.35rem; flex-wrap: wrap; }
.chip {
  padding: 0.28rem 0.75rem;
  border-radius: 100px;
  border: 1px solid var(--border);
  background: transparent;
  font-family: var(--font-sans);
  font-size: 0.78rem;
  font-weight: 500;
  color: var(--muted);
  cursor: pointer;
  transition: background 0.15s, color 0.15s, border-color 0.15s;
  white-space: nowrap;
}
.chip:hover { background: var(--sand); color: var(--ink); border-color: var(--sand-dark); }
.chip--active { background: var(--deep-blue); color: #fff; border-color: var(--deep-blue); }
.chip-count { opacity: 0.6; font-size: 0.7rem; margin-left: 0.15rem; }
.results-count { font-size: 0.78rem; color: var(--muted); white-space: nowrap; flex-shrink: 0; }

/* ── GRID ── */
.stay-grid {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
  gap: 1rem;
}

/* ── CARD ── */
.sc {
  display: flex;
  flex-direction: column;
  gap: 0.5rem;
  padding: 1.25rem 1.4rem;
  background: var(--white);
  border: 1px solid var(--border);
  border-radius: var(--radius-lg);
  color: inherit;
  transition: transform 0.22s var(--ease), box-shadow 0.22s var(--ease), border-color 0.22s;
}
.sc:hover { transform: translateY(-3px); box-shadow: var(--shadow-md); border-color: var(--sand-dark); color: inherit; }
:global(.sc-img) {
  display: block;
  margin: -1.25rem -1.4rem 0.25rem;
  aspect-ratio: 16 / 9;
  border-radius: var(--radius-lg) var(--radius-lg) 0 0;
  overflow: hidden;
}
.sc-area {
  font-size: 0.62rem;
  font-weight: 700;
  letter-spacing: 0.08em;
  text-transform: uppercase;
  color: var(--sea);
}
.sc-name {
  font-family: var(--font-serif);
  font-size: 1.3rem;
  line-height: 1.2;
  color: var(--ink);
  margin: 0;
  transition: color 0.15s;
}
.sc:hover .sc-name { color: var(--deep-blue); }
.sc-desc {
  font-size: 0.85rem;
  line-height: 1.6;
  color: var(--muted);
  margin: 0;
  flex: 1;
}

/* ── EMPTY ── */
.empty-state { text-align: center; padding: 5rem 0; }
.empty-text { font-size: 1rem; color: var(--muted); margin-bottom: 1.5rem; }

/* ── INFO STRIP ── */
.info-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 1.5rem;
}
.info-card {
  padding: 1.5rem;
  border: 1px solid var(--border);
  border-radius: var(--radius-md);
  background: var(--sand);
}
.info-title {
  font-family: var(--font-serif);
  font-size: 1.15rem;
  color: var(--deep-blue);
  margin-bottom: 0.5rem;
}
.info-text { font-size: 0.875rem; line-height: 1.7; color: var(--muted); }

/* ── RESPONSIVE ── */
@media (max-width: 900px) {
  .area-grid { grid-template-columns: 1fr; }
  .info-grid { grid-template-columns: 1fr; }
}
@media (max-width: 768px) {
  .filters-inner { flex-direction: column; align-items: flex-start; gap: 0.4rem; }
  .filter-chips { flex-wrap: nowrap; overflow-x: auto; max-width: 100%; scrollbar-width: none; }
  .filter-chips::-webkit-scrollbar { display: none; }
}
@media (max-width: 480px) {
  .stay-grid { grid-template-columns: 1fr; }
}
</style>
