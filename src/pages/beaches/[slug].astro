---
import Layout from '../../layouts/Layout.astro';
import SmartImage from '../../components/SmartImage.astro';
import Hero from '../../components/beach/Hero.astro';
import WindCheck from '../../components/beach/WindCheck.astro';
import Tips from '../../components/beach/Tips.astro';
import Sidebar from '../../components/beach/Sidebar.astro';
import Nearby from '../../components/beach/Nearby.astro';
import PartnerNearby from '../../components/PartnerNearby.astro';
import { nearbyPartners } from '../../lib/restaurants';
import beachesRaw from '../../data/beaches.json';
import { getBeachName, type Beach, type BeachAccess } from '../../lib/beaches';
import { beachPhoto } from '../../lib/public-files';
import { metaDescription } from '../../lib/seo';

const beachesData = (beachesRaw as Beach[]).map(b => ({ ...b, image: beachPhoto(b) }));

export function getStaticPaths() {
  return (beachesRaw as Beach[]).map((beach) => ({
    params: { slug: beach.slug },
    props:  { beach: { ...beach, image: beachPhoto(beach) } },
  }));
}

export interface Props { beach: Beach }
const { beach } = Astro.props;

const accessMap: Record<string, BeachAccess> = {
  road: { icon: '🚗', label: 'Accessible by car',  color: '#3b6d11' },
  hike: { icon: '🥾', label: 'Hiking trail',        color: '#854f0b' },
  boat: { icon: '⛵', label: 'Boat access only',    color: '#185fa5' },
};

const getBeachDesc = (b: any): string =>
  typeof b.description === 'object' ? b.description.en : b.description;

// The beach's own text plus facilities. No access label: the descriptions already say
// "only by boat" etc., so it read twice.
const facilitiesText = beach.facilities.length ? ` Facilities: ${beach.facilities.join(', ')}.` : '';

const access: BeachAccess = accessMap[beach.accessType] ?? { icon: '📍', label: beach.accessType, color: '#6b7280' };
const mapsUrl = beach.placeId ? `https://www.google.com/maps/place/?q=place_id:${beach.placeId}` : null;

const facilityIcons: Record<string, string> = {
  'sunbeds':   '🌂',
  'snack bar': '🥗',
  'parking':   '🅿️',
};

// Nearby: sort by geographic distance using coordinates
function distKm(lat1: number, lng1: number, lat2: number, lng2: number) {
  const R = 6371;
  const dLat = (lat2 - lat1) * Math.PI / 180;
  const dLng = (lng2 - lng1) * Math.PI / 180;
  const a = Math.sin(dLat/2)**2 + Math.cos(lat1*Math.PI/180) * Math.cos(lat2*Math.PI/180) * Math.sin(dLng/2)**2;
  return R * 2 * Math.atan2(Math.sqrt(a), Math.sqrt(1-a));
}

const related = beachesData
  .filter(b => b.slug !== beach.slug && b.coordinates?.lat && b.coordinates?.lng)
  .map(b => ({
    ...b,
    dist: (beach.coordinates?.lat && beach.coordinates?.lng)
      ? distKm(beach.coordinates.lat, beach.coordinates.lng, b.coordinates!.lat, b.coordinates!.lng)
      : 999,
  }))
  .sort((a, b) => a.dist - b.dist)
  .slice(0, 4);

const windAlternatives = beachesData
  .filter(b => b.slug !== beach.slug && b.accessType !== 'boat' && b.coordinates?.lat && beach.coordinates?.lat)
  .map(b => ({
    slug: b.slug,
    name: getBeachName(b),
    faces: b.faces,
    dist: distKm(beach.coordinates!.lat, beach.coordinates!.lng, b.coordinates!.lat, b.coordinates!.lng),
  }))
  .sort((a, b) => a.dist - b.dist)
  .slice(0, 12);

// The main photo is already in the hero, so only show a gallery when there are extra images.
const galleryImages: string[] = beach.gallery?.slice(0, 4) ?? [];

const _siteUrl = 'https://milos.guide';
const beachJsonld = {
  '@context': 'https://schema.org',
  '@type': 'TouristAttraction',
  name: getBeachName(beach),
  description: getBeachDesc(beach),
  url: `${_siteUrl}/beaches/${beach.slug}/`,
  ...(beach.image ? { image: beach.image.startsWith('http') ? beach.image : _siteUrl + beach.image } : {}),
  ...(beach.coordinates?.lat ? {
    geo: { '@type': 'GeoCoordinates', latitude: beach.coordinates.lat, longitude: beach.coordinates.lng },
  } : {}),
  address: {
    '@type': 'PostalAddress',
    addressLocality: (beach as any).location?.area ?? 'Milos',
    addressRegion: 'South Aegean',
    addressCountry: 'GR',
  },
  ...(beach.facilities?.length ? {
    amenityFeature: beach.facilities.map((f: string) => ({ '@type': 'LocationFeatureSpecification', name: f, value: true })),
  } : {}),
  isAccessibleForFree: true,
  ...(mapsUrl ? { hasMap: mapsUrl } : {}),
  containedInPlace: { '@type': 'TouristDestination', '@id': `${_siteUrl}/#milos`, name: 'Milos' },
};
---

<Layout
  lang="en"
  title={`${getBeachName(beach)} — Beach in Milos`}
  description={metaDescription(getBeachDesc(beach) + facilitiesText)}
  jsonld={beachJsonld}
>
<Hero beach={beach} access={access} />

<!-- CONTENT -->
<div class="container b-layout">

  <!-- MAIN -->
  <article class="b-main">

    <!-- Quick bar -->
    <div class="quick-bar">
      <div class="qb-item">
        <span class="qb-icon">{access.icon}</span>
        <div>
          <span class="qb-val">{access.label}</span>
        </div>
      </div>
      {beach.accessType === 'road' && (
        <div class="qb-item">
          <span class="qb-icon">{beach.easyAccess ? '✅' : '⚠️'}</span>
          <div>
            <span class="qb-val">{beach.easyAccess ? 'Easy road' : 'Rough road'}</span>
          </div>
        </div>
      )}
      {beach.facilities.map(f => (
        <div class="qb-item">
          <span class="qb-icon">{facilityIcons[f] ?? '✓'}</span>
          <span class="qb-val">{f}</span>
        </div>
      ))}
    </div>

    <WindCheck beach={beach} alternatives={windAlternatives} />

    <!-- Description -->
    <p class="b-desc">{getBeachDesc(beach)}</p>

    <!-- Gallery -->
    {galleryImages.length > 0 && (
      <div class="gallery-grid">
        <div class="gallery-main">
          <SmartImage src={galleryImages[0]} alt={`${getBeachName(beach)} 1`} width={640} height={380} class="gallery-img" sizes="(max-width: 768px) 50vw, 33vw" />
        </div>
        {galleryImages.slice(1).map((src, i) => (
          <div class="gallery-thumb">
            <SmartImage src={src} alt={`${getBeachName(beach)} ${i + 2}`} width={320} height={126} class="gallery-img" sizes="(max-width: 768px) 25vw, 16vw" />
          </div>
        ))}
      </div>
    )}

    <Tips beach={beach} access={access} />

    {beach.coordinates?.lat && (
      <PartnerNearby places={nearbyPartners(beach.coordinates)} placement={`beach-${beach.slug}`} logos />
    )}

  </article>

  <Sidebar beach={beach} access={access} mapsUrl={mapsUrl} />

</div>

<Nearby related={related} />

</Layout>

<style>
/* ── LAYOUT ── */
.b-layout {
  display: grid;
  grid-template-columns: 1fr 300px;
  gap: 3rem;
  padding-top: 2.5rem;
  padding-bottom: 4rem;
  align-items: start;
}
/* ── QUICK BAR ── */
.quick-bar {
  display: flex;
  align-items: stretch;
  background: var(--white);
  border: 1px solid var(--border);
  border-radius: var(--radius-md);
  overflow: hidden;
  margin-bottom: 2rem;
}
.qb-item {
  display: flex;
  align-items: center;
  gap: .5rem;
  padding: .9rem 1.25rem;
  border-right: 1px solid var(--border);
  flex-shrink: 0;
}
.qb-item:last-child { border-right: none; }
.qb-icon { font-size: 1rem; flex-shrink: 0; }
.qb-val { font-size: .9rem; font-weight: 600; color: var(--ink); }
/* ── MAIN ── */
.b-desc {
  font-size: 1.05rem;
  line-height: 1.8;
  color: var(--ink);
  margin-bottom: 2rem;
}
/* ── GALLERY ── */
.gallery-grid {
  display: grid;
  grid-template-columns: 2fr 1fr;
  grid-template-rows: repeat(3, 1fr);
  gap: 4px;
  height: 380px;
  border-radius: var(--radius-md);
  overflow: hidden;
  margin-bottom: 2rem;
}
.gallery-main {
  grid-row: 1 / 4;
}
:global(.gallery-img) {
  width: 100%;
  height: 100%;
  object-fit: cover;
  display: block;
  transition: transform .35s;
}
.gallery-main:hover :global(.gallery-img),
.gallery-thumb:hover :global(.gallery-img) { transform: scale(1.04); }
.gallery-main,
.gallery-thumb { overflow: hidden; background: var(--sand-dark); }
@media (max-width: 600px) {
  .gallery-grid { grid-template-columns: 1fr 1fr; grid-template-rows: repeat(2, 1fr); height: 260px; }
  .gallery-main { grid-row: auto; }
}
@media (max-width: 768px) {
  .b-layout { grid-template-columns: 1fr; gap: 2rem; }
  .quick-bar { flex-wrap: wrap; }
  .qb-item { border-bottom: 1px solid var(--border); flex: 1 1 calc(50% - 1px); }
}
</style>
