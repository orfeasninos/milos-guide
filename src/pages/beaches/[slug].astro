---
import Layout from '../../layouts/Layout.astro';
import beachesRaw from '../../data/beaches.json';

interface Beach {
  slug: string;
  name: string | { el: string; en: string };
  description: string | { el: string; en: string };
  location: { area: string; address: string };
  placeId: string | null;
  localPhoto: string | null;
  website: string | null;
  coordinates?: { lat: number; lng: number };
  rating: number;
  accessType: string;
  facilities: string[];
  sandType?: string;
  shade?: boolean;
  bestFor?: string[];
  swimDepth?: string;
}

const beachesData = beachesRaw as Beach[];

export function getStaticPaths() {
  return (beachesRaw as Beach[]).map((beach) => ({
    params: { slug: beach.slug },
    props:  { beach },
  }));
}

export interface Props { beach: Beach }
const { beach } = Astro.props;
const base = import.meta.env.BASE_URL;

const accessMap: Record<string, { icon: string; label: string; color: string }> = {
  road: { icon: '🚗', label: 'Accessible by car',  color: '#3b6d11' },
  hike: { icon: '🥾', label: 'Hiking trail',        color: '#854f0b' },
  boat: { icon: '⛵', label: 'Boat access only',    color: '#185fa5' },
};

const getBeachName = (b: any): string =>
  typeof b.name === 'object' ? b.name.en : b.name;
const getBeachDesc = (b: any): string =>
  typeof b.description === 'object' ? b.description.en : b.description;

const access = accessMap[beach.accessType] ?? { icon: '📍', label: beach.accessType, color: '#6b7280' };
const mapsUrl = beach.placeId ? `https://www.google.com/maps/place/?q=place_id:${beach.placeId}` : null;

const facilityIcons: Record<string, string> = {
  'sunbeds':   '🌂',
  'snack bar': '🥗',
  'parking':   '🅿️',
};

// Nearby: sort by geographic distance using coordinates
function distKm(lat1: number, lng1: number, lat2: number, lng2: number) {
  const R = 6371;
  const dLat = (lat2 - lat1) * Math.PI / 180;
  const dLng = (lng2 - lng1) * Math.PI / 180;
  const a = Math.sin(dLat/2)**2 + Math.cos(lat1*Math.PI/180) * Math.cos(lat2*Math.PI/180) * Math.sin(dLng/2)**2;
  return R * 2 * Math.atan2(Math.sqrt(a), Math.sqrt(1-a));
}

const related = beachesData
  .filter(b => b.slug !== beach.slug && b.coordinates?.lat && b.coordinates?.lng)
  .map(b => ({
    ...b,
    dist: (beach.coordinates?.lat && beach.coordinates?.lng)
      ? distKm(beach.coordinates.lat, beach.coordinates.lng, b.coordinates!.lat, b.coordinates!.lng)
      : 999,
  }))
  .sort((a, b) => a.dist - b.dist)
  .slice(0, 3);

const _siteUrl = 'https://milos.guide';
const beachJsonld = {
  '@context': 'https://schema.org',
  '@type': 'TouristAttraction',
  name: getBeachName(beach),
  description: getBeachDesc(beach),
  url: `${_siteUrl}/beaches/${beach.slug}`,
  ...(beach.localPhoto ? { image: beach.localPhoto.startsWith('http') ? beach.localPhoto : _siteUrl + beach.localPhoto } : {}),
  ...(beach.coordinates?.lat ? {
    geo: { '@type': 'GeoCoordinates', latitude: beach.coordinates.lat, longitude: beach.coordinates.lng },
  } : {}),
  address: {
    '@type': 'PostalAddress',
    addressLocality: (beach as any).location?.area ?? 'Milos',
    addressRegion: 'South Aegean',
    addressCountry: 'GR',
  },
  ...(beach.facilities?.length ? {
    amenityFeature: beach.facilities.map((f: string) => ({ '@type': 'LocationFeatureSpecification', name: f, value: true })),
  } : {}),
  isAccessibleForFree: true,
  ...(mapsUrl ? { hasMap: mapsUrl } : {}),
  containedInPlace: { '@type': 'TouristDestination', '@id': `${_siteUrl}/#milos`, name: 'Milos' },
};
---

<Layout
  lang="en"
  title={`${getBeachName(beach)} — Beach in Milos`}
  description={`${getBeachName(beach)}: ${access.label}. ${beach.facilities.length ? 'Facilities: ' + beach.facilities.join(', ') + '.' : ''} Rating ${beach.rating}/5.`}
  jsonld={beachJsonld}
>

<!-- HERO -->
<div class="b-hero">
  {beach.localPhoto ? (
    <img
      src={beach.localPhoto ?? `/images/beaches/${beach.slug}.jpg`}
      alt={getBeachName(beach)}
      class="b-hero-img"
      fetchpriority="high"
    />
  ) : (
    <div class="b-hero-ph"></div>
  )}
  <div class="b-hero-overlay">
    <div class="container b-hero-inner">
      <a href="/beaches" class="back-link">← All beaches</a>
      <div class="b-hero-meta">
        <div class="b-hero-chips">
          <span class="b-access-chip">{access.icon} {access.label}</span>
          {beach.rating > 0 && (
            <span class="b-rating-chip">★ {beach.rating}</span>
          )}
        </div>
        <h1 class="b-hero-name">{getBeachName(beach)}</h1>
        {beach.location.area && (
          <p class="b-hero-area">
            <span style="color:var(--sky)">◉</span> {beach.location.area}
          </p>
        )}
      </div>
    </div>
  </div>
</div>


<!-- CONTENT -->
<div class="container b-layout">

  <!-- MAIN -->
  <main class="b-main">

    <!-- Quick bar -->
    <div class="quick-bar">
      <div class="qb-item">
        <span class="qb-icon">{access.icon}</span>
        <div>
          <span class="qb-val">{access.label}</span>
        </div>
      </div>
      {beach.rating > 0 && (
        <div class="qb-item">
          <span class="qb-icon" style="color:#d97706">★</span>
          <div>
            <span class="qb-val">{beach.rating}</span>
            <span class="qb-label">/ 5</span>
          </div>
        </div>
      )}
      {beach.facilities.map(f => (
        <div class="qb-item">
          <span class="qb-icon">{facilityIcons[f] ?? '✓'}</span>
          <span class="qb-val">{f}</span>
        </div>
      ))}
    </div>

    <!-- Description -->
    <p class="b-desc">{getBeachDesc(beach)}</p>

    <!-- Tips block -->
    <div class="tips-block">
      <h2 class="block-title">Useful information</h2>
      <div class="tips-grid">

        <!-- Getting there -->
        <div class="tip">
          <span class="tip-icon">{access.icon}</span>
          <div>
            <p class="tip-title">Getting there</p>
            <p class="tip-body">
              {beach.accessType === 'road' && 'Accessible by car or motorbike. Follow road signs from the main island road.'}
              {beach.accessType === 'hike' && 'Requires a hike over rough terrain. Wear sturdy footwear and bring plenty of water.'}
              {beach.accessType === 'boat' && 'Only reachable by sea. Book a daily boat tour from Adamas harbour, or arrive by private boat.'}
            </p>
          </div>
        </div>

        <!-- What to bring -->
        <div class="tip">
          <span class="tip-icon">🎒</span>
          <div>
            <p class="tip-title">What to bring</p>
            <p class="tip-body">
              {beach.facilities.includes('sunbeds')
                ? 'Sunbeds, umbrellas, and a snack bar are available on site.'
                : 'No beach facilities — pack your umbrella, towels, snacks, and plenty of water.'}
            </p>
          </div>
        </div>

        <!-- Crowds -->
        <div class="tip">
          <span class="tip-icon">👥</span>
          <div>
            <p class="tip-title">Crowds</p>
            <p class="tip-body">
              {beach.accessType === 'boat'
                ? 'Only accessible by boat — stays naturally uncrowded and pristine year-round.'
                : beach.accessType === 'hike'
                  ? 'The trail keeps visitor numbers low — expect peace and quiet even in peak season.'
                  : beach.rating >= 4.7
                    ? 'Very popular in July and August — arrive early in the morning to secure a good spot.'
                    : 'Moderately visited — usually easy to find space even in high season.'}
            </p>
          </div>
        </div>

        <!-- Parking (road only) -->
        {beach.accessType === 'road' && (
          <div class="tip">
            <span class="tip-icon">🅿️</span>
            <div>
              <p class="tip-title">Parking</p>
              <p class="tip-body">
                {beach.facilities.includes('parking')
                  ? 'Free parking area available near the beach.'
                  : 'No dedicated car park — park along the roadside near the access path.'}
              </p>
            </div>
          </div>
        )}

        <!-- Boat tours note -->
        {beach.accessType === 'boat' && (
          <div class="tip">
            <span class="tip-icon">🗺️</span>
            <div>
              <p class="tip-title">Boat tours</p>
              <p class="tip-body">Most organised day tours from Adamas include this beach as a stop. Check departure times at the port.</p>
            </div>
          </div>
        )}

      </div>
    </div>

  </main>

  <!-- SIDEBAR -->
  <aside class="b-sidebar">

    <!-- Rating -->
    {beach.rating > 0 && (
      <div class="s-card">
        <p class="s-card-label">Rating</p>
        <div class="s-rating">
          <span class="s-rating-num">{beach.rating}</span>
          <div class="s-rating-right">
            <span class="s-rating-stars">{'★'.repeat(Math.round(beach.rating))}{'☆'.repeat(5 - Math.round(beach.rating))}</span>
            <span class="s-rating-sub">out of 5</span>
          </div>
        </div>
      </div>
    )}

    <!-- Info -->
    <div class="s-card">
      <p class="s-card-label">Details</p>
      <ul class="s-info-list">
        <li class="s-info-row">
          <span class="s-info-key">Access</span>
          <span class="s-info-val">{access.icon} {access.label}</span>
        </li>
        {beach.facilities.includes('sunbeds') && (
          <li class="s-info-row">
            <span class="s-info-key">Type</span>
            <span class="s-info-val">🏖️ Organised</span>
          </li>
        )}
        <li class="s-info-row">
          <span class="s-info-key">Sunbeds</span>
          <span class="s-info-val">
            {beach.facilities.includes('sunbeds') ? '✅ Available' : '❌ Not available'}
          </span>
        </li>
        <li class="s-info-row">
          <span class="s-info-key">Snack bar</span>
          <span class="s-info-val">
            {beach.facilities.includes('sunbeds') ? '✅ Available' : '❌ Not available'}
          </span>
        </li>
        <li class="s-info-row">
          <span class="s-info-key">Parking</span>
          <span class="s-info-val">
            {beach.facilities.includes('parking') ? '✅ Free parking' : '❌ Not available'}
          </span>
        </li>
        {beach.sandType && (
          <li class="s-info-row">
            <span class="s-info-key">Surface</span>
            <span class="s-info-val">{beach.sandType}</span>
          </li>
        )}
        {beach.swimDepth && (
          <li class="s-info-row">
            <span class="s-info-key">Water depth</span>
            <span class="s-info-val">{beach.swimDepth}</span>
          </li>
        )}
        <li class="s-info-row">
          <span class="s-info-key">Natural shade</span>
          <span class="s-info-val">{beach.shade ? '✅ Yes' : '❌ No'}</span>
        </li>
        {beach.bestFor && beach.bestFor.length > 0 && (
          <li class="s-info-row">
            <span class="s-info-key">Best for</span>
            <span class="s-info-val">{beach.bestFor.join(' · ')}</span>
          </li>
        )}
      </ul>
    </div>

    <!-- CTA -->
    {mapsUrl && (
      <a
        href={mapsUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="s-btn s-btn--maps"
      >
        <span>📍</span> Google Maps ↗
      </a>
    )}

    {beach.website && (
      <a
        href={beach.website}
        target="_blank"
        rel="noopener noreferrer"
        class="s-btn s-btn--web"
      >
        <span>🌐</span> More information ↗
      </a>
    )}

  </aside>

</div>


<!-- RELATED -->
{related.length > 0 && (
  <section class="sec sec-sand related-sec">
    <div class="container">
      <div class="sec-hdr-row">
        <div>
          <span class="label">Close by</span>
          <h2 class="sec-title">Nearby beaches</h2>
        </div>
        <a href="/beaches" class="see-all">All beaches →</a>
      </div>
      <div class="related-grid">
        {related.map(r => (
          <a href={`/beaches/${r.slug}`} class="rel-card">
            <div class="rel-img-wrap">
              {r.localPhoto ? (
                <img
                  src={r.localPhoto ?? `/images/beaches/${r.slug}.jpg`}
                  alt={getBeachName(r)}
                  class="rel-img"
                  loading="lazy"
                />
              ) : (
                <div class="rel-ph"></div>
              )}
              <div class="rel-overlay">
                {r.rating > 0 && <span class="rel-rating">★ {r.rating}</span>}
                <h3 class="rel-name">{getBeachName(r)}</h3>
              </div>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>
)}

</Layout>


<style>
/* ── HERO ── */
.b-hero {
  position: relative;
  height: 520px;
  overflow: hidden;
  background: var(--deep-blue);
}
.b-hero-img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  display: block;
}
.b-hero-ph {
  width: 100%;
  height: 100%;
  background: linear-gradient(140deg, #0d2b4e, #1a5c8a, #3a9bc9);
}
.b-hero-overlay {
  position: absolute;
  inset: 0;
  background: linear-gradient(to top, rgba(0,0,0,.75) 0%, rgba(0,0,0,.1) 55%, transparent 100%);
  display: flex;
  flex-direction: column;
  justify-content: flex-end;
}
.b-hero-inner { padding-bottom: 2.5rem; }

.back-link {
  position: absolute;
  top: 1.5rem;
  left: 1.5rem;
  font-size: .75rem;
  font-weight: 600;
  letter-spacing: .05em;
  text-transform: uppercase;
  color: #fff;
  background: rgba(0,0,0,.35);
  backdrop-filter: blur(6px);
  padding: .35rem .85rem;
  border-radius: 100px;
  transition: background .15s;
}
.back-link:hover { background: rgba(0,0,0,.55); }

.b-hero-chips {
  display: flex;
  gap: .45rem;
  flex-wrap: wrap;
  margin-bottom: .55rem;
}
.b-access-chip,
.b-rating-chip {
  font-size: .62rem;
  font-weight: 600;
  letter-spacing: .04em;
  text-transform: uppercase;
  padding: 3px 10px;
  border-radius: 100px;
  background: rgba(0,0,0,.35);
  border: 1px solid rgba(255,255,255,.22);
  backdrop-filter: blur(6px);
  color: #fff;
}
.b-hero-name {
  font-family: var(--font-serif);
  font-size: clamp(2.2rem, 6vw, 4rem);
  color: #fff;
  line-height: 1.0;
  margin: 0 0 .4rem;
  text-shadow: 0 2px 16px rgba(0,0,0,.4);
}
.b-hero-area {
  font-size: .78rem;
  font-weight: 600;
  text-transform: uppercase;
  letter-spacing: .08em;
  color: rgba(255,255,255,.72);
  margin: 0;
}

/* ── LAYOUT ── */
.b-layout {
  display: grid;
  grid-template-columns: 1fr 300px;
  gap: 3rem;
  padding-top: 2.5rem;
  padding-bottom: 4rem;
  align-items: start;
}

/* ── QUICK BAR ── */
.quick-bar {
  display: flex;
  align-items: stretch;
  background: var(--white);
  border: 1px solid var(--border);
  border-radius: var(--radius-md);
  overflow: hidden;
  margin-bottom: 2rem;
}
.qb-item {
  display: flex;
  align-items: center;
  gap: .5rem;
  padding: .9rem 1.25rem;
  border-right: 1px solid var(--border);
  flex-shrink: 0;
}
.qb-item:last-child { border-right: none; }
.qb-icon { font-size: 1rem; flex-shrink: 0; }
.qb-val { font-size: .9rem; font-weight: 600; color: var(--ink); }
.qb-label { font-size: .72rem; color: var(--muted); }

/* ── MAIN ── */
.b-desc {
  font-size: 1.05rem;
  line-height: 1.8;
  color: var(--ink);
  margin-bottom: 2rem;
}

.tips-block { margin-bottom: 1rem; }
.block-title {
  font-size: .65rem;
  font-weight: 700;
  letter-spacing: .12em;
  text-transform: uppercase;
  color: var(--muted);
  margin-bottom: 1rem;
}
.tips-grid {
  display: flex;
  flex-direction: column;
  gap: 0;
  border: 1px solid var(--border);
  border-radius: var(--radius-md);
  overflow: hidden;
}
.tip {
  display: flex;
  align-items: flex-start;
  gap: 1rem;
  padding: 1.1rem 1.25rem;
  border-bottom: 1px solid var(--border);
  background: var(--white);
}
.tip:last-child { border-bottom: none; }
.tip:nth-child(even) { background: var(--sand); }
.tip-icon { font-size: 1.1rem; flex-shrink: 0; margin-top: .1rem; }
.tip-title { font-size: .78rem; font-weight: 600; color: var(--muted); text-transform: uppercase; letter-spacing: .06em; margin-bottom: .2rem; }
.tip-body { font-size: .9rem; color: var(--ink); margin: 0; line-height: 1.5; }

/* ── SIDEBAR ── */
.b-sidebar {
  display: flex;
  flex-direction: column;
  gap: 1rem;
  position: sticky;
  top: calc(var(--header-h) + 1.5rem);
}
.s-card {
  background: var(--white);
  border: 1px solid var(--border);
  border-radius: var(--radius-md);
  padding: 1.25rem;
}
.s-card-label {
  font-size: .62rem;
  font-weight: 700;
  letter-spacing: .12em;
  text-transform: uppercase;
  color: var(--muted);
  margin-bottom: .85rem;
}
.s-rating { display: flex; align-items: center; gap: .85rem; }
.s-rating-num { font-family: var(--font-serif); font-size: 2.8rem; color: var(--ink); line-height: 1; }
.s-rating-right { display: flex; flex-direction: column; gap: .15rem; }
.s-rating-stars { font-size: .9rem; color: #d97706; letter-spacing: .1em; }
.s-rating-sub { font-size: .72rem; color: var(--muted); }

.s-info-list { list-style: none; padding: 0; margin: 0; display: flex; flex-direction: column; gap: .6rem; }
.s-info-row { display: flex; justify-content: space-between; align-items: flex-start; font-size: .875rem; gap: .5rem; }
.s-info-key { font-weight: 600; color: var(--muted); flex-shrink: 0; }
.s-info-val { color: var(--ink); text-align: right; font-size: .875rem; }

.s-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: .5rem;
  padding: .8rem 1rem;
  border-radius: var(--radius-md);
  font-family: var(--font-sans);
  font-size: .875rem;
  font-weight: 600;
  transition: transform .15s, opacity .15s;
}
.s-btn:hover { transform: translateY(-1px); opacity: .9; }
.s-btn--maps { background: var(--deep-blue); color: #fff; box-shadow: var(--shadow-sm); }
.s-btn--web  { background: var(--white); color: var(--ink); border: 1px solid var(--border); }

/* ── RELATED ── */
.related-sec { margin-top: 0; }
.related-grid { display: grid; grid-template-columns: repeat(3,1fr); gap: 1rem; }
.rel-card {
  display: block;
  border-radius: var(--radius-lg);
  overflow: hidden;
  aspect-ratio: 4/3;
  position: relative;
  background: var(--sand-dark);
  transition: transform .2s, box-shadow .2s;
}
.rel-card:hover { transform: translateY(-3px); box-shadow: var(--shadow-md); }
.rel-img-wrap { position: absolute; inset: 0; }
.rel-img { width: 100%; height: 100%; object-fit: cover; transition: transform .4s; }
.rel-card:hover .rel-img { transform: scale(1.05); }
.rel-ph { width: 100%; height: 100%; background: linear-gradient(140deg, #1a5c8a, #3a9bc9); }
.rel-overlay {
  position: absolute;
  inset: 0;
  background: linear-gradient(to top, rgba(0,0,0,.65) 0%, transparent 55%);
  display: flex;
  flex-direction: column;
  justify-content: flex-end;
  padding: 1rem;
  color: #fff;
}
.rel-rating { font-size: .7rem; font-weight: 600; color: #fbbf24; margin-bottom: .25rem; }
.rel-name { font-family: var(--font-serif); font-size: 1.05rem; line-height: 1.2; margin: 0; }

/* ── RESPONSIVE ── */
@media (max-width: 900px) {
  .related-grid { grid-template-columns: 1fr 1fr; }
}
@media (max-width: 768px) {
  .b-hero { height: 360px; }
  .b-layout { grid-template-columns: 1fr; gap: 2rem; }
  .b-sidebar { position: static; }
  .quick-bar { flex-wrap: wrap; }
  .qb-item { border-bottom: 1px solid var(--border); flex: 1 1 calc(50% - 1px); }
  .related-grid { grid-template-columns: 1fr 1fr; }
}
@media (max-width: 480px) {
  .b-hero { height: 280px; }
  .b-hero-name { font-size: 2rem; }
  .related-grid { grid-template-columns: 1fr; }
}
</style>