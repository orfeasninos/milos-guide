---
import Layout from '../../layouts/Layout.astro';
import SmartImage from '../../components/SmartImage.astro';
import beachesData from '../../data/beaches.json';

function getArea(lat: number, lng: number): string {
  if (!lat || !lng) return 'north';
  if (lng < 24.37) return 'west';
  if (lng > 24.52 && lat > 36.68) return 'east';
  if (lat < 36.68) return 'south';
  if (lat >= 36.74) return 'north';
  return 'gulf';
}

const allFacilities = [...new Set(
  beachesData.flatMap(b => b.facilities)
)].filter(f => Boolean(f) && f !== 'snack bar').sort();

const FEATURED_SLUGS = ['sarakiniko', 'kleftiko', 'provatas', 'fyropotamos'];
const featuredBeaches = FEATURED_SLUGS
  .map(slug => beachesData.find(b => b.slug === slug))
  .filter(Boolean) as typeof beachesData;

const sortedBeaches = [...beachesData]
  .sort((a, b) => b.rating - a.rating)
  .map(b => ({
    ...b,
    area: getArea(b.coordinates?.lat ?? 0, b.coordinates?.lng ?? 0),
    isBoat: b.accessType === 'boat',
  }));

const getBeachName = (b: any): string => typeof b.name === 'object' ? b.name.en : b.name;

const beachMapData = sortedBeaches.map(b => ({
  slug: b.slug,
  name: getBeachName(b),
  lat: b.coordinates?.lat ?? 0,
  lng: b.coordinates?.lng ?? 0,
  rating: b.rating,
  area: b.area,
  isBoat: b.isBoat,
  facilities: b.facilities,
  image: (b as any).image ?? null,
}));
const _siteUrl = 'https://milos.guide';
const beachesJsonld = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: 'Beaches in Milos',
  description: `The best beaches in Milos — ${beachesData.length}+ options. Sarakiniko, Kleftiko, Tsigrado and more.`,
  url: `${_siteUrl}/beaches`,
  numberOfItems: sortedBeaches.length,
  itemListElement: sortedBeaches.map((b, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    name: getBeachName(b),
    url: `${_siteUrl}/beaches/${b.slug}`,
  })),
};
---

<Layout
  lang="en"
  title="Beaches in Milos"
  description={`The best beaches in Milos — ${beachesData.length}+ options. Sarakiniko, Kleftiko, Tsigrado and many more.`}
  jsonld={beachesJsonld}
>

<!-- PAGE HERO -->
<section class="page-hero">
  <div class="container">
    <p class="page-label">Explore</p>
    <h1 class="page-title">Beaches in Milos</h1>
    <p class="page-desc">
      Volcanic rocks, crystal-clear water, hidden sea caves.
      {beachesData.length} beaches — each with its own character.
    </p>
  </div>
</section>

<!-- FEATURED -->
<section class="featured-sec">
  <div class="container">
    <div class="featured-hdr">
      <span class="label">Must-visit</span>
      <h2 class="featured-title">Top picks</h2>
    </div>
    <div class="featured-grid">
      {featuredBeaches.map(b => (
        <a href={`/beaches/${b.slug}`} class="feat">
          <div class="feat-img-wrap">
            {(b as any).image ? (
              <SmartImage src={(b as any).image} alt={getBeachName(b)} width={600} height={400} class="feat-img" sizes="(max-width: 768px) 50vw, 25vw" />
            ) : (
              <div class="feat-ph"></div>
            )}
          </div>
          <div class="feat-overlay">
            {b.rating > 0 && <span class="feat-rating">★ {b.rating}</span>}
            <h3 class="feat-name">{getBeachName(b)}</h3>
          </div>
        </a>
      ))}
    </div>
  </div>
</section>

<!-- FILTERS -->
<div class="filters-bar">
  <div class="container">

    <div class="filter-row">
      <div class="filter-chips" id="area-chips">
        <button class="chip" data-area="north">North</button>
        <button class="chip" data-area="south">South</button>
        <button class="chip" data-area="west">West</button>
        <button class="chip" data-area="east">East</button>
        <button class="chip" data-area="gulf">Gulf</button>
      </div>

      <div class="filter-right">
        <span class="results-count" id="results-count">{beachesData.length} beaches</span>
        <div class="view-toggle">
          <button class="view-btn view-btn--active" id="view-grid-btn" title="Grid view">⊞</button>
          <button class="view-btn" id="view-map-btn" title="Map view">🗺</button>
        </div>
      </div>
    </div>

    <div class="filter-row filter-row--bottom">
      <div class="filter-chips" id="facility-chips">
        {allFacilities.map(f => (
          <button class="chip" data-facility={f}>{f}</button>
        ))}
      </div>

      <div class="filter-divider" aria-hidden="true"></div>

      <button class="chip" id="boat-toggle">⛵ Boat only</button>
    </div>

  </div>
</div>

<!-- GRID -->
<section class="sec sec-sand" id="grid-section">
  <div class="container">
    <div class="beaches-grid" id="beaches-grid">
      {sortedBeaches.map(beach => (
        <a
          href={`/beaches/${beach.slug}`}
          class="bc"
          data-area={beach.area}
          data-boat={String(beach.isBoat)}
          data-access={beach.accessType}
          data-facilities={JSON.stringify(beach.facilities)}
        >
          <div class="bc-img-wrap">
            {(beach as any).image ? (
              <SmartImage
                src={(beach as any).image}
                alt={getBeachName(beach)}
                width={400}
                height={280}
                class="bc-img"
                sizes="(max-width: 600px) 100vw, (max-width: 900px) 50vw, 33vw"
              />
            ) : (
              <div class="bc-ph" aria-hidden="true"></div>
            )}
            <div class="bc-overlay">
              <div class="bc-chips">
                {beach.accessType === 'boat' && (
                  <span class="bc-access-chip">⛵ Boat only</span>
                )}
                {beach.rating > 0 && (
                  <span class="bc-rating-chip">★ {beach.rating}</span>
                )}
              </div>
              <h2 class="bc-name">{getBeachName(beach)}</h2>
              {beach.facilities.length > 0 && (
                <p class="bc-facilities">{beach.facilities.join(' · ')}</p>
              )}
            </div>
          </div>
        </a>
      ))}
    </div>

    <div class="empty-state" id="empty-state" style="display:none">
      <p class="empty-icon">🏖</p>
      <p class="empty-text">No beaches found with these filters.</p>
      <button class="btn-dark" id="reset-filters">Show all</button>
    </div>
  </div>
</section>

<!-- MAP -->
<section id="map-section" style="display:none; padding:0;">
  <div id="map" style="height:580px; width:100%;"></div>
</section>

<script define:vars={{ beachMapData }}>
  window.__BEACH_DATA__ = beachMapData;
</script>

</Layout>


<style>
/* ── PAGE HERO ── */
.page-hero {
  background: var(--white);
  padding: 3rem 0 2.5rem;
  border-bottom: 1px solid var(--border);
}
.page-label {
  font-size: 0.68rem;
  font-weight: 600;
  letter-spacing: 0.14em;
  text-transform: uppercase;
  color: var(--sea);
  margin-bottom: 0.4rem;
}
.page-title {
  font-family: var(--font-serif);
  font-size: clamp(2rem, 5vw, 3.2rem);
  color: var(--deep-blue);
  line-height: 1.1;
  margin-bottom: 0.75rem;
}
.page-desc {
  font-size: 1rem;
  color: var(--muted);
  max-width: 540px;
  line-height: 1.7;
}

/* ── FEATURED ── */
.featured-sec {
  padding: 3rem 0 2.5rem;
  background: var(--white);
  border-bottom: 1px solid var(--border);
}
.featured-hdr { margin-bottom: 1.25rem; }
.featured-title {
  font-family: var(--font-serif);
  font-size: 1.5rem;
  color: var(--deep-blue);
  margin: 0.2rem 0 0;
}
.featured-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 1rem;
}
.feat {
  display: block;
  position: relative;
  aspect-ratio: 3/2;
  border-radius: var(--radius-lg);
  overflow: hidden;
  background: var(--sand-dark);
  transition: transform 0.22s var(--ease), box-shadow 0.22s var(--ease);
}
.feat:hover { transform: translateY(-4px); box-shadow: var(--shadow-lg); }
.feat-img-wrap { position: absolute; inset: 0; }
:global(.feat-img) { width: 100%; height: 100%; object-fit: cover; display: block; transition: transform 0.4s ease; }
.feat:hover :global(.feat-img) { transform: scale(1.05); }
.feat-ph { width: 100%; height: 100%; background: linear-gradient(140deg, #0d2b4e, #1a5c8a, #3a9bc9); }
.feat-overlay {
  position: absolute;
  inset: 0;
  background: linear-gradient(to top, rgba(0,0,0,.72) 0%, transparent 55%);
  display: flex;
  flex-direction: column;
  justify-content: flex-end;
  padding: 1.1rem 1.25rem;
  color: #fff;
}
.feat-rating { font-size: 0.68rem; font-weight: 600; color: #fbbf24; margin-bottom: 0.3rem; }
.feat-name {
  font-family: var(--font-serif);
  font-size: 1.25rem;
  line-height: 1.2;
  margin: 0;
  text-shadow: 0 1px 8px rgba(0,0,0,.4);
}

/* ── FILTERS ── */
.filters-bar {
  position: sticky;
  top: calc(var(--header-h) - 5px);
  z-index: 100;
  background: rgba(255,255,255,0.95);
  backdrop-filter: blur(12px);
  -webkit-backdrop-filter: blur(12px);
  border-bottom: 1px solid var(--border);
}
.filter-row {
  display: flex;
  align-items: center;
  gap: 0.5rem;
  padding-top: 0.45rem;
  padding-bottom: 0.45rem;
  overflow-x: auto;
  scrollbar-width: none;
  -ms-overflow-style: none;
}
.filter-row::-webkit-scrollbar { display: none; }
.filter-row--bottom { padding-top: 0; padding-bottom: 0.55rem; }
.filter-right {
  margin-left: auto;
  display: flex;
  align-items: center;
  gap: 0.75rem;
  flex-shrink: 0;
}
.filter-label {
  font-size: 0.65rem;
  font-weight: 700;
  letter-spacing: 0.1em;
  text-transform: uppercase;
  color: var(--muted);
  white-space: nowrap;
  flex-shrink: 0;
}
.filter-chips { display: flex; gap: 0.3rem; flex-shrink: 0; }
.chip {
  padding: 0.28rem 0.75rem;
  border-radius: 100px;
  border: 1px solid var(--border);
  background: transparent;
  font-family: var(--font-sans);
  font-size: 0.78rem;
  font-weight: 500;
  color: var(--muted);
  cursor: pointer;
  transition: background 0.15s, color 0.15s, border-color 0.15s;
  white-space: nowrap;
  flex-shrink: 0;
}
.chip:hover { background: var(--sand); color: var(--ink); border-color: var(--sand-dark); }
.chip--active { background: var(--deep-blue); color: #fff; border-color: var(--deep-blue); }
.filter-divider { width: 1px; height: 20px; background: var(--border); flex-shrink: 0; margin: 0 0.25rem; }
.results-count { font-size: 0.78rem; color: var(--muted); }

/* View toggle */
.view-toggle {
  display: flex;
  border: 1px solid var(--border);
  border-radius: var(--radius-sm);
  overflow: hidden;
}
.view-btn {
  padding: 0.28rem 0.65rem;
  background: transparent;
  border: none;
  font-size: 1rem;
  cursor: pointer;
  color: var(--muted);
  transition: background 0.15s, color 0.15s;
  line-height: 1;
}
.view-btn:hover { background: var(--sand); }
.view-btn--active { background: var(--deep-blue); color: #fff; }

/* ── GRID ── */
.beaches-grid {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
  gap: 1rem;
}

/* ── CARD ── */
.bc {
  display: block;
  border-radius: var(--radius-lg);
  overflow: hidden;
  position: relative;
  aspect-ratio: 4/3;
  background: var(--sand-dark);
  transition: transform 0.22s var(--ease), box-shadow 0.22s var(--ease);
}
.bc:hover { transform: translateY(-4px); box-shadow: var(--shadow-lg); }
.bc-img-wrap { position: absolute; inset: 0; }
:global(.bc-img) { width: 100%; height: 100%; object-fit: cover; display: block; transition: transform 0.4s ease; }
.bc:hover :global(.bc-img) { transform: scale(1.05); }
.bc-ph { width: 100%; height: 100%; background: linear-gradient(140deg, #1a5c8a, #3a9bc9); }
.bc-overlay {
  position: absolute;
  inset: 0;
  background: linear-gradient(to top, rgba(0,0,0,.72) 0%, rgba(0,0,0,.08) 55%, transparent 100%);
  display: flex;
  flex-direction: column;
  justify-content: flex-end;
  padding: 1.25rem 1.4rem;
  color: #fff;
}
.bc-chips { display: flex; gap: 0.4rem; flex-wrap: wrap; margin-bottom: 0.5rem; }
.bc-access-chip,
.bc-rating-chip {
  font-size: 0.62rem;
  font-weight: 600;
  letter-spacing: 0.04em;
  text-transform: uppercase;
  padding: 3px 9px;
  border-radius: 100px;
  background: rgba(0,0,0,.35);
  border: 1px solid rgba(255,255,255,.2);
  backdrop-filter: blur(6px);
}
.bc-name {
  font-family: var(--font-serif);
  font-size: 1.4rem;
  line-height: 1.15;
  margin: 0 0 0.2rem;
  text-shadow: 0 1px 8px rgba(0,0,0,.4);
}
.bc-facilities { font-size: 0.72rem; color: rgba(255,255,255,.65); margin: 0; }

/* ── EMPTY ── */
.empty-state { text-align: center; padding: 5rem 0; }
.empty-icon { font-size: 3rem; margin-bottom: 1rem; }
.empty-text { font-size: 1rem; color: var(--muted); margin-bottom: 1.5rem; }

/* ── CLUSTER ── */
:global(.b-cluster) {
  background: #1a7fc1;
  color: #fff;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-weight: 700;
  font-size: 0.82rem;
  border: 3px solid #fff;
  box-shadow: 0 2px 8px rgba(0,0,0,.3);
}
:global(.leaflet-popup-content-wrapper) {
  border-radius: 10px !important;
  padding: 0 !important;
  overflow: hidden;
}
:global(.leaflet-popup-content) {
  margin: 0 !important;
  line-height: 1 !important;
}

/* ── RESPONSIVE ── */
@media (max-width: 900px) {
  .featured-grid { grid-template-columns: repeat(2, 1fr); }
}
@media (max-width: 768px) {
  .filter-row {
    flex-wrap: wrap;
    overflow-x: visible;
    gap: 0.35rem;
    row-gap: 0.4rem;
  }
  .filter-row--bottom > .filter-divider { display: none; }
  .filter-right {
    position: absolute;
    top: 0.5rem;
    right: 1rem;
    width: auto;
    margin: 0;
    flex-direction: column;
    align-items: flex-end;
    gap: 0.3rem;
  }
  .filter-right .view-toggle { order: 1; }
  .filter-right .results-count { order: 2; font-size: 0.7rem; }
  .beaches-grid { grid-template-columns: 1fr 1fr; gap: 0.75rem; }
  .bc-name { font-size: 1.1rem; }
}
@media (max-width: 480px) {
  .beaches-grid { grid-template-columns: 1fr; }
  .featured-grid { grid-template-columns: 1fr 1fr; }
}
</style>


<script>
const grid        = document.getElementById('beaches-grid');
const empty       = document.getElementById('empty-state');
const counter     = document.getElementById('results-count');
const boatBtn     = document.getElementById('boat-toggle');
const gridSection = document.getElementById('grid-section');
const mapSection  = document.getElementById('map-section');
const viewGridBtn = document.getElementById('view-grid-btn');
const viewMapBtn  = document.getElementById('view-map-btn');

let activeAreas      = new Set<string>();
let activeFacilities = new Set<string>();
let boatOnly         = false;
let mapInitialized   = false;
let leafletMap: any  = null;
let clusterGroup: any = null;
let mapMarkers: { marker: any; beach: any }[] = [];

function matchesFilters(data: {
  area: string; isBoat: boolean; facilities: string[];
}): boolean {
  return (
    (activeAreas.size === 0 || activeAreas.has(data.area)) &&
    (activeFacilities.size === 0 || [...activeFacilities].every(f => data.facilities.includes(f))) &&
    (!boatOnly || data.isBoat)
  );
}

function applyFilters() {
  const cards = grid?.querySelectorAll<HTMLElement>('.bc') ?? [];
  let visible = 0;
  cards.forEach(card => {
    const show = matchesFilters({
      area:       card.dataset.area ?? '',
      isBoat:     card.dataset.boat === 'true',
      facilities: JSON.parse(card.dataset.facilities ?? '[]'),
    });
    card.style.display = show ? '' : 'none';
    if (show) visible++;
  });
  if (counter) counter.textContent = `${visible} beach${visible !== 1 ? 'es' : ''}`;
  if (empty)   empty.style.display = visible === 0 ? 'block' : 'none';
  if (grid)    grid.style.display  = visible === 0 ? 'none'  : '';
  updateMapMarkers();
}

// Area (multi-select)
document.querySelectorAll<HTMLButtonElement>('#area-chips .chip').forEach(chip => {
  chip.addEventListener('click', () => {
    const val = chip.dataset.area ?? '';
    if (activeAreas.has(val)) {
      activeAreas.delete(val);
      chip.classList.remove('chip--active');
    } else {
      activeAreas.add(val);
      chip.classList.add('chip--active');
    }
    applyFilters();
  });
});


// Surface

// Facilities (multi-select)
document.querySelectorAll<HTMLButtonElement>('#facility-chips .chip').forEach(chip => {
  chip.addEventListener('click', () => {
    const val = chip.dataset.facility ?? 'all';
    if (val === 'all') {
      activeFacilities.clear();
      document.querySelectorAll('#facility-chips .chip').forEach(c => c.classList.remove('chip--active'));
      chip.classList.add('chip--active');
    } else {
      document.querySelector('#facility-chips .chip[data-facility="all"]')?.classList.remove('chip--active');
      if (activeFacilities.has(val)) {
        activeFacilities.delete(val);
        chip.classList.remove('chip--active');
        if (activeFacilities.size === 0)
          document.querySelector('#facility-chips .chip[data-facility="all"]')?.classList.add('chip--active');
      } else {
        activeFacilities.add(val);
        chip.classList.add('chip--active');
      }
    }
    applyFilters();
  });
});

// Boat only
boatBtn?.addEventListener('click', () => {
  boatOnly = !boatOnly;
  boatBtn.classList.toggle('chip--active', boatOnly);
  applyFilters();
});

// Reset
document.getElementById('reset-filters')?.addEventListener('click', () => {
  activeAreas.clear(); activeFacilities.clear(); boatOnly = false;
  document.querySelectorAll('#area-chips .chip').forEach(c => c.classList.remove('chip--active'));
  document.querySelectorAll('#facility-chips .chip').forEach(c => c.classList.remove('chip--active'));
  boatBtn?.classList.remove('chip--active');
  applyFilters();
});

// ── View toggle ──
viewGridBtn?.addEventListener('click', () => {
  gridSection!.style.display = '';
  mapSection!.style.display  = 'none';
  viewGridBtn.classList.add('view-btn--active');
  viewMapBtn?.classList.remove('view-btn--active');
});

viewMapBtn?.addEventListener('click', () => {
  gridSection!.style.display = 'none';
  mapSection!.style.display  = '';
  viewMapBtn.classList.add('view-btn--active');
  viewGridBtn?.classList.remove('view-btn--active');
  if (!mapInitialized) initMap();
});

// ── Map ──
function updateMapMarkers() {
  if (!mapInitialized || !clusterGroup) return;
  clusterGroup.clearLayers();
  mapMarkers.forEach(({ marker, beach }) => {
    if (matchesFilters(beach)) clusterGroup.addLayer(marker);
  });
}

function loadScript(src: string, cb: () => void) {
  const s = document.createElement('script');
  s.src = src;
  s.onload = cb;
  document.head.appendChild(s);
}

function initMap() {
  mapInitialized = true;

  [
    'https://cdnjs.cloudflare.com/ajax/libs/leaflet/1.9.4/leaflet.min.css',
    'https://cdnjs.cloudflare.com/ajax/libs/leaflet.markercluster/1.5.3/MarkerCluster.css',
    'https://cdnjs.cloudflare.com/ajax/libs/leaflet.markercluster/1.5.3/MarkerCluster.Default.css',
  ].forEach(href => {
    const l = document.createElement('link');
    l.rel = 'stylesheet';
    l.href = href;
    document.head.appendChild(l);
  });

  loadScript(
    'https://cdnjs.cloudflare.com/ajax/libs/leaflet/1.9.4/leaflet.min.js',
    () => loadScript(
      'https://cdnjs.cloudflare.com/ajax/libs/leaflet.markercluster/1.5.3/leaflet.markercluster.min.js',
      setupMap,
    ),
  );
}

function setupMap() {
  const L = (window as any).L;
  const miloBounds = L.latLngBounds(L.latLng(36.60, 24.25), L.latLng(36.85, 24.65));

  leafletMap = L.map('map', {
    center: [36.710, 24.430],
    zoom: 12,
    minZoom: 11,
    maxZoom: 18,
    maxBounds: miloBounds,
    maxBoundsViscosity: 0.8,
  });

  const street = L.tileLayer(
    'https://{s}.basemaps.cartocdn.com/rastertiles/voyager/{z}/{x}/{y}{r}.png',
    { attribution: '© OpenStreetMap, © CARTO', maxZoom: 19, subdomains: 'abcd' },
  );
  const satellite = L.tileLayer(
    'https://server.arcgisonline.com/ArcGIS/rest/services/World_Imagery/MapServer/tile/{z}/{y}/{x}',
    { attribution: 'Tiles © Esri', maxZoom: 19 },
  );
  street.addTo(leafletMap);
  L.control.layers({ 'Map': street, 'Satellite': satellite }, null, {
    position: 'topright', collapsed: true,
  }).addTo(leafletMap);

  clusterGroup = L.markerClusterGroup({
    maxClusterRadius: 50,
    disableClusteringAtZoom: 15,
    showCoverageOnHover: false,
    iconCreateFunction: (c: any) => {
      const n = c.getChildCount();
      const s = n < 10 ? 36 : n < 20 ? 42 : 48;
      return L.divIcon({
        html: `<div style="width:${s}px;height:${s}px;background:#1a7fc1;color:#fff;border-radius:50%;display:flex;align-items:center;justify-content:center;font-weight:700;font-size:.82rem;border:3px solid #fff;box-shadow:0 2px 8px rgba(0,0,0,.3);">${n}</div>`,
        className: '',
        iconSize: [s, s],
        iconAnchor: [s / 2, s / 2],
      });
    },
  });

  const beaches: any[] = (window as any).__BEACH_DATA__ ?? [];

  beaches.forEach(beach => {
    if (!beach.lat || !beach.lng) return;

    const pinSvg = `<svg xmlns="http://www.w3.org/2000/svg" width="36" height="48" viewBox="0 0 40 52" style="filter:drop-shadow(0 2px 4px rgba(0,0,0,.35))">
      <path d="M20 2C10.06 2 2 10.06 2 20c0 11 18 30 18 30s18-19 18-30C38 10.06 29.94 2 20 2z" fill="#1a7fc1"/>
      <circle cx="20" cy="20" r="13" fill="white" opacity="0.2"/>
      <text x="20" y="26" text-anchor="middle" font-size="16">🏖</text>
    </svg>`;

    const icon = L.divIcon({ html: pinSvg, className: '', iconSize: [36, 48], iconAnchor: [18, 48] });
    const marker = L.marker([beach.lat, beach.lng], { icon });

    const photoHtml = beach.image
      ? `<img src="${beach.image}" alt="${beach.name}" style="width:100%;height:110px;object-fit:cover;display:block;">`
      : `<div style="width:100%;height:80px;display:flex;align-items:center;justify-content:center;font-size:2rem;background:#e8f4fb;">🏖</div>`;

    marker.bindPopup(
      L.popup({ maxWidth: 200, minWidth: 200, offset: [0, -6] }).setContent(`
        <div style="width:200px;font-family:sans-serif;overflow:hidden;border-radius:8px;">
          ${photoHtml}
          <div style="padding:.75rem .9rem;">
            <p style="font-family:Georgia,serif;font-size:.95rem;color:#0d2b4e;margin:0 0 .25rem;line-height:1.2;">${beach.name}</p>
            ${beach.rating > 0 ? `<p style="font-size:.72rem;color:#d97706;margin:0 0 .5rem;">★ ${beach.rating}</p>` : ''}
            <a href="/beaches/${beach.slug}" style="font-size:.75rem;font-weight:600;color:#1a7fc1;">View beach →</a>
          </div>
        </div>
      `),
    );

    if (matchesFilters(beach)) clusterGroup.addLayer(marker);
    mapMarkers.push({ marker, beach });
  });

  leafletMap.addLayer(clusterGroup);
  setTimeout(() => leafletMap.invalidateSize(), 200);
}
</script>
