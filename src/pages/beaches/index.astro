---
import Layout from "../../layouts/Layout.astro";
import beachesData from "../../data/beaches.json";

const base = import.meta.env.BASE_URL;

const accessIcon = {
  road: "🚗",
  hike: "🥾",
  boat: "⛵",
};
---

<Layout title="Παραλίες στη Μήλο" description="Οι καλύτερες παραλίες στη Μήλο.">
  <h1>Παραλίες στη Μήλο</h1>

  <div class="beaches-grid">
    {
      beachesData.map((beach) => (
        <a href={`${base}beaches/${beach.slug}`} class="beach-card">
          {beach.photoRef ? (
            <img
              src={`https://places.googleapis.com/v1/${beach.photoRef}/media?key=${import.meta.env.PUBLIC_GOOGLE_PLACES_API_KEY}&maxWidthPx=600`}
              alt={`Φωτογραφία της παραλίας ${beach.name}`}
              class="beach-image"
              loading="lazy"
            />
          ) : (
            <div class="beach-image-placeholder" aria-hidden="true">
              ◈
            </div>
          )}

          <div class="card-body">
            <h3 class="card-name">{beach.name}</h3>
            <p class="card-location">
              ◉ {beach.location.area ?? beach.location}
            </p>
            {beach.rating > 0 && <p class="card-rating">⭐ {beach.rating}</p>}
            <div class="card-footer">
              <span class="card-access">
                {accessIcon[beach.accessType as keyof typeof accessIcon] ??
                  "📍"}{" "}
                {beach.accessType}
              </span>
              {beach.facilities.length > 0 && (
                <span class="card-facilities">
                  {beach.facilities.join(" · ")}
                </span>
              )}
            </div>
          </div>
        </a>
      ))
    }
  </div>
</Layout>

<style>
  a {
    text-decoration: none;
  }

  h1 {
    padding: 2rem var(--container-px, 1.5rem) 1rem;
    font-family: var(--font-display, serif);
    font-size: 2.25rem;
  }

  .beaches-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: 1.5rem;
    padding: 1rem var(--container-px, 1.5rem) 4rem;
    margin-inline: auto;
  }

  .beach-card {
    display: flex;
    flex-direction: column;
    background: white;
    border-radius: 10px;
    border: 1px solid var(--color-border, #dedad3);
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.06);
    overflow: hidden;
    text-decoration: none;
    color: inherit;
    transition:
      transform 200ms ease,
      box-shadow 200ms ease;
  }

  .beach-card:hover {
    transform: translateY(-3px);
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.1);
  }

  .beach-image {
    width: 100%;
    height: 180px;
    object-fit: cover;
    display: block;
  }

  .beach-image-placeholder {
    width: 100%;
    height: 180px;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 2.5rem;
    color: var(--color-border, #dedad3);
    background-color: var(--color-surface-alt, #eeece8);
  }

  .card-body {
    padding: 1rem 1.25rem 1.25rem;
    display: flex;
    flex-direction: column;
    flex-grow: 1;
    gap: 0.25rem;
  }

  .card-name {
    font-family: var(--font-display, serif);
    font-size: 1.15rem;
    font-weight: 600;
    color: var(--color-text, #1a1916);
    margin: 0;
    line-height: 1.3;
  }

  .card-location {
    font-size: 0.75rem;
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--color-terracotta, #c0613a);
    margin: 0;
  }

  .card-rating {
    font-size: 0.8rem;
    color: var(--color-text-muted, #6b6760);
    margin: 0;
  }

  .card-footer {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-top: auto;
    padding-top: 0.75rem;
    border-top: 1px solid var(--color-border, #dedad3);
    gap: 0.5rem;
  }

  .card-access {
    font-size: 0.7rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--color-text-muted, #6b6760);
  }

  .card-facilities {
    font-size: 0.7rem;
    color: var(--color-text-light, #9e9b96);
    text-align: right;
  }
</style>
