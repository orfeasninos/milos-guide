---
import Layout from '../../layouts/Layout.astro';
import tavernsData from '../../data/taverns.json';

const sortedTaverns = [...tavernsData].sort((a, b) => {
  if (a.isFeatured && !b.isFeatured) return -1;
  if (!a.isFeatured && b.isFeatured) return 1;
  return 0;
});

const base = import.meta.env.BASE_URL; // handles /milos-guide prefix automatically
---

<Layout title="Φαγητό στη Μήλο" description="Τα καλύτερα εστιατόρια και ταβέρνες στη Μήλο.">
  <h1>🍽️ Φαγητό στη Μήλο</h1>

  <div class="taverns-grid">
    {sortedTaverns.map((tavern) => (
      <a href={`${base}eat/${tavern.slug}`} class="tavern-card">

        {tavern.photoRef ? (
          <img
            src={`https://places.googleapis.com/v1/${tavern.photoRef}/media?key=${import.meta.env.PUBLIC_GOOGLE_PLACES_API_KEY}&maxWidthPx=600`}
            alt={`Φωτογραφία του ${tavern.name}`}
            class="tavern-image"
            loading="lazy"
          />
        ) : (
          <div class="tavern-image-placeholder" aria-hidden="true">◈</div>
        )}

        <div class="card-body">
          {tavern.isFeatured && <span class="badge">Featured</span>}
          <h3 class="card-name">{tavern.name}</h3>
          <p class="card-location">◉ {tavern.location.area ?? tavern.location}</p>
          {tavern.rating && (
            <p class="card-rating">⭐ {tavern.rating}</p>
          )}
          <div class="card-footer">
            <span class="card-cuisine">{tavern.cuisine?.[0]}</span>
            <span class="card-price">{tavern.priceRange}</span>
          </div>
        </div>

      </a>
    ))}
  </div>
</Layout>

<style>
  a{
    text-decoration: none;
  }

  h1 {
    padding: 2rem var(--container-px, 1.5rem) 1rem;
    font-family: var(--font-display, serif);
    font-size: 2.25rem;
  }

  .taverns-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: 1.5rem;
    padding: 1rem var(--container-px, 1.5rem) 4rem;
    margin-inline: auto;
  }

  /* ── Card — the whole thing is the link ── */
  .tavern-card {
    display: flex;
    flex-direction: column;
    background: white;
    border-radius: 10px;
    border: 1px solid var(--color-border, #dedad3);
    box-shadow: 0 2px 8px rgba(0,0,0,0.06);
    overflow: hidden;
    text-decoration: none;
    color: inherit;
    transition: transform 200ms ease, box-shadow 200ms ease;
  }

  .tavern-card:hover {
    transform: translateY(-3px);
    box-shadow: 0 8px 24px rgba(0,0,0,0.10);
  }

  /* ── Image ── */
  .tavern-image {
    width: 100%;
    height: 180px;
    object-fit: cover;
    display: block;
  }

  .tavern-image-placeholder {
    width: 100%;
    height: 180px;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 2.5rem;
    color: var(--color-border, #dedad3);
    background-color: var(--color-surface-alt, #eeece8);
  }

  /* ── Body ── */
  .card-body {
    padding: 1rem 1.25rem 1.25rem;
    display: flex;
    flex-direction: column;
    flex-grow: 1;
    gap: 0.25rem;
  }

  .badge {
    display: inline-block;
    font-size: 0.6rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    background-color: var(--color-terracotta, #c0613a);
    color: white;
    padding: 2px 7px;
    border-radius: 100px;
    margin-bottom: 0.25rem;
    width: fit-content;
  }

  .card-name {
    font-family: var(--font-display, serif);
    font-size: 1.15rem;
    font-weight: 600;
    color: var(--color-text, #1a1916);
    margin: 0;
    line-height: 1.3;
  }

  .card-location {
    font-size: 0.75rem;
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--color-terracotta, #c0613a);
    margin: 0;
  }

  .card-rating {
    font-size: 0.8rem;
    color: var(--color-text-muted, #6b6760);
    margin: 0;
  }

  .card-footer {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-top: auto;
    padding-top: 0.75rem;
    border-top: 1px solid var(--color-border, #dedad3);
  }

  .card-cuisine {
    font-size: 0.7rem;
    font-weight: 500;
    text-transform: uppercase;
    color: var(--color-text-light, #9e9b96);
  }

  .card-price {
    font-size: 0.8rem;
    font-weight: 600;
    color: var(--color-gold, #b08d57);
    letter-spacing: 0.05em;
  }
</style>