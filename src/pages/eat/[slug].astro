---
import Layout from '../../layouts/Layout.astro';
import tavernsData from '../../data/taverns.json';

export function getStaticPaths() {
  return tavernsData.map((tavern) => ({
    params: { slug: tavern.slug },
    props: { tavern },
  }));
}

const { tavern } = Astro.props;
const base = import.meta.env.BASE_URL;
---

<Layout title={`${tavern.name} | Φαγητό στη Μήλο`} description={tavern.description}>

  <div class="hero">
    {tavern.photoRef ? (
      <img
        src={`https://places.googleapis.com/v1/${tavern.photoRef}/media?key=${import.meta.env.PUBLIC_GOOGLE_PLACES_API_KEY}&maxWidthPx=1200`}
        alt={`Φωτογραφία του ${tavern.name}`}
        class="hero-image"
      />
    ) : (
      <div class="hero-placeholder" aria-hidden="true">◈</div>
    )}
    <div class="hero-overlay">
      <a href={`${base}eat`} class="back-link">← Όλα τα εστιατόρια</a>
      <div class="hero-meta">
        {tavern.isFeatured && <span class="badge">Featured</span>}
        <h1>{tavern.name}</h1>
        <p class="hero-location">◉ {tavern.location.area}</p>
      </div>
    </div>
  </div>

  <div class="content">

    <div class="main">
      <p class="description">{tavern.description}</p>

      <div class="chips">
        {tavern.cuisine.map((c) => (
          <span class="chip">{c}</span>
        ))}
        <span class="chip chip--price">{tavern.priceRange}</span>
        {tavern.rating > 0 && (
          <span class="chip">⭐ {tavern.rating} / 5</span>
        )}
      </div>

      {tavern.openingHours && tavern.openingHours[0] !== "Δεν ανακοινώθηκε ωράριο" && (
        <div class="hours-block">
          <h2>Ωράριο</h2>
          <ul class="hours-list">
            {tavern.openingHours.map((line) => {
              const [day, time] = line.split(": ");
              return (
                <li>
                  <span class="day">{day}</span>
                  <span class="time">{time}</span>
                </li>
              );
            })}
          </ul>
        </div>
      )}
    </div>

    <aside class="sidebar">

      {tavern.rating > 0 && (
        <div class="info-block">
          <h2>Αξιολόγηση</h2>
          <p class="rating-big">⭐ {tavern.rating}<span>/5</span></p>
        </div>
      )}

      <div class="info-block">
        <h2>Πληροφορίες</h2>
        <ul class="info-list">
          <li>
            <span class="info-label">Περιοχή</span>
            <span>{tavern.location.area}</span>
          </li>
          <li>
            <span class="info-label">Τιμές</span>
            <span>{tavern.priceRange}</span>
          </li>
          {tavern.hours && (
            <li>
              <span class="info-label">Σήμερα</span>
              <span>{tavern.hours}</span>
            </li>
          )}
          {tavern.phone && (
            <li>
              <span class="info-label">Τηλέφωνο</span>
              <a href={`tel:${tavern.phone}`} class="info-link">{tavern.phone}</a>
            </li>
          )}
        </ul>
      </div>

      <div class="cta-group">
        {tavern.googleMapsUri && (
          <a href={tavern.googleMapsUri} target="_blank" rel="noopener noreferrer" class="btn btn--primary">
            Άνοιγμα στο Google Maps ↗
          </a>
        )}
        {tavern.website && (
          <a href={tavern.website} target="_blank" rel="noopener noreferrer" class="btn btn--secondary">
            Επίσκεψη ιστοσελίδας ↗
          </a>
        )}
      </div>

    </aside>

  </div>

</Layout>

<style>
  /* ── Hero ── */
  .hero {
    position: relative;
    width: 100%;
    height: 420px;
  }

  .hero-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .hero-placeholder {
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 4rem;
    background-color: var(--color-surface-alt, #eeece8);
    color: var(--color-border, #dedad3);
  }

  .hero-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(to top, rgba(0,0,0,0.65) 0%, transparent 50%);
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    padding: 2rem var(--container-px, 1.5rem);
    color: white;
  }

  .back-link {
    position: absolute;
    top: 1.25rem;
    left: var(--container-px, 1.5rem);
    font-size: 0.8rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: white;
    text-decoration: none;
    background: rgba(0,0,0,0.35);
    padding: 0.3rem 0.75rem;
    border-radius: 100px;
    backdrop-filter: blur(4px);
    transition: background 200ms;
  }

  .back-link:hover {
    background: rgba(0,0,0,0.55);
  }

  .badge {
    display: inline-block;
    font-size: 0.6rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    background: var(--color-terracotta, #c0613a);
    color: white;
    padding: 2px 8px;
    border-radius: 100px;
    margin-bottom: 0.4rem;
    width: fit-content;
  }

  .hero-overlay h1 {
    font-family: var(--font-display, serif);
    font-size: 2.5rem;
    margin: 0 0 0.25rem;
    line-height: 1.1;
  }

  .hero-location {
    font-size: 0.8rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    opacity: 0.85;
    margin: 0;
  }

  /* ── Layout ── */
  .content {
    display: grid;
    grid-template-columns: 1fr 300px;
    gap: 2.5rem;
    padding: 2.5rem var(--container-px, 1.5rem) 4rem;
    max-width: 1100px;
    margin-inline: auto;
  }

  @media (max-width: 768px) {
    .content {
      grid-template-columns: 1fr;
    }
  }

  /* ── Main ── */
  .description {
    font-size: 1.05rem;
    line-height: 1.75;
    color: var(--color-text, #1a1916);
    margin: 0 0 1.75rem;
  }

  .chips {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-bottom: 2rem;
  }

  .chip {
    font-size: 0.75rem;
    font-weight: 500;
    padding: 0.3rem 0.8rem;
    border-radius: 100px;
    background: var(--color-surface-alt, #eeece8);
    color: var(--color-text, #1a1916);
    border: 1px solid var(--color-border, #dedad3);
  }

  .chip--price {
    background: var(--color-gold, #b08d57);
    color: white;
    border-color: transparent;
    font-weight: 700;
    letter-spacing: 0.05em;
  }

  .hours-block h2 {
    font-family: var(--font-display, serif);
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--color-text-muted, #6b6760);
    margin: 0 0 0.75rem;
  }

  .hours-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0;
    border: 1px solid var(--color-border, #dedad3);
    border-radius: 8px;
    overflow: hidden;
  }

  .hours-list li {
    display: flex;
    justify-content: space-between;
    padding: 0.5rem 0.85rem;
    font-size: 0.875rem;
    color: var(--color-text, #1a1916);
    border-bottom: 1px solid var(--color-border, #dedad3);
  }

  .hours-list li:last-child {
    border-bottom: none;
  }

  .hours-list li:nth-child(odd) {
    background: var(--color-surface-alt, #eeece8);
  }

  .day {
    font-weight: 500;
  }

  .time {
    color: var(--color-text-muted, #6b6760);
  }

  /* ── Sidebar ── */
  .sidebar {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .info-block {
    padding: 1.25rem;
    background: white;
    border-radius: 10px;
    border: 1px solid var(--color-border, #dedad3);
  }

  .info-block h2 {
    font-family: var(--font-display, serif);
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--color-text-muted, #6b6760);
    margin: 0 0 0.75rem;
  }

  .rating-big {
    font-size: 1.75rem;
    font-weight: 700;
    color: var(--color-text, #1a1916);
    margin: 0;
  }

  .rating-big span {
    font-size: 0.9rem;
    color: var(--color-text-muted, #6b6760);
    font-weight: 400;
  }

  .info-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
  }

  .info-list li {
    display: flex;
    justify-content: space-between;
    font-size: 0.875rem;
    color: var(--color-text, #1a1916);
    gap: 0.5rem;
  }

  .info-label {
    font-weight: 600;
    color: var(--color-text-muted, #6b6760);
    flex-shrink: 0;
  }

  .info-link {
    color: var(--color-gold, #b08d57);
    text-decoration: none;
    font-weight: 500;
  }

  .info-link:hover {
    text-decoration: underline;
  }

  .cta-group {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .btn {
    display: block;
    text-align: center;
    padding: 0.85rem 1rem;
    border-radius: 8px;
    font-size: 0.85rem;
    font-weight: 600;
    text-decoration: none;
    transition: opacity 200ms;
  }

  .btn:hover {
    opacity: 0.85;
  }

  .btn--primary {
    background: var(--color-gold, #b08d57);
    color: white;
  }

  .btn--secondary {
    background: white;
    color: var(--color-text, #1a1916);
    border: 1px solid var(--color-border, #dedad3);
  }
</style>