---
import Layout from '../../layouts/Layout.astro';
import tavernsRaw from '../../data/taverns.json';

type Tavern = typeof tavernsRaw[number] & { localPhoto?: string | null };
const tavernsData = tavernsRaw as Tavern[];


const getName    = (t: any): string => typeof t.name === 'object' ? t.name.en : t.name;
const getDesc    = (t: any): string => typeof t.description === 'object' ? t.description.en : t.description;
const getCuisine = (t: any): string => typeof t.cuisine === 'object' && !Array.isArray(t.cuisine) ? t.cuisine.en : t.cuisine?.[0] ?? '';

export function getStaticPaths() {
  return tavernsRaw.map((tavern) => ({
    params: { slug: tavern.slug },
    props:  { tavern },
  }));
}

const { tavern } = Astro.props;
const base = import.meta.env.BASE_URL;

// Opening hours come from Places API in Greek — match by day index
// Sunday=0 in JS, but Places API starts from Monday (index 0)
const todayIndex = (new Date().getDay() + 6) % 7; // Mon=0 ... Sun=6

const showHours = tavern.openingHours?.length &&
  tavern.openingHours[0] !== 'Δεν ανακοινώθηκε ωράριο' && tavern.openingHours[0] !== 'Hours not announced';

// Related taverns: same area, not this one, up to 3
const related = tavernsData
  .filter(t => t.slug !== tavern.slug && t.location.area === tavern.location.area)
  .sort((a, b) => b.rating - a.rating)
  .slice(0, 3);
---

<Layout
  lang="en"
  title={`${getName(tavern)} — Restaurant in Milos`}
  description={`${getName(tavern)} in${tavern.location.area ? ' ' + tavern.location.area : ''}, Milos. ${getCuisine(tavern) || 'Greek cuisine'} · Rating ${tavern.rating}/5.`}
>

<!-- HERO -->
<div class="t-hero">
  {tavern.localPhoto ? (
    <img
      src={tavern.localPhoto}
      alt={getName(tavern)}
      class="t-hero-img"
      fetchpriority="high"
    />
  ) : (
    <div class="t-hero-ph" aria-hidden="true"></div>
  )}
  <div class="t-hero-overlay">
    <div class="container t-hero-inner">
      <a href="/eat" class="back-link">← All restaurants</a>
      <div class="t-hero-meta">
        {tavern.isFeatured && <span class="featured-badge">Featured</span>}
        <h1 class="t-hero-name">{getName(tavern)}</h1>
        <p class="t-hero-area">
          <span class="area-dot">◉</span>
          {tavern.location.area}
          {getCuisine(tavern) && <span class="area-sep">·</span>}
          {getCuisine(tavern)}
        </p>
      </div>
    </div>
  </div>
</div>


<!-- CONTENT -->
<div class="container t-layout">

  <!-- MAIN -->
  <main class="t-main">

    <!-- Quick info bar -->
    <div class="quick-bar">
      {tavern.rating > 0 && (
        <div class="qb-item">
          <span class="qb-icon">★</span>
          <span class="qb-val">{tavern.rating}</span>
          <span class="qb-label">/ 5</span>
        </div>
      )}
      {tavern.priceRange && (
        <div class="qb-item">
          <span class="qb-val">{tavern.priceRange}</span>
          <span class="qb-label">prices</span>
        </div>
      )}
      {tavern.hours && (
        <div class="qb-item">
          <span class="qb-icon">🕐</span>
          <span class="qb-val qb-hours">{tavern.hours}</span>
        </div>
      )}
      {tavern.location.area && (
        <div class="qb-item">
          <span class="qb-icon">📍</span>
          <span class="qb-val">{tavern.location.area}</span>
        </div>
      )}
    </div>

    <!-- Description -->
    <p class="t-desc">{getDesc(tavern)}</p>

    <!-- Tags -->
    <div class="t-tags">
      <span class="tag">{getCuisine(tavern)}</span>
      
    </div>

    <!-- Opening Hours -->
    {showHours && (
      <div class="hours-block">
        <h2 class="block-title">Opening hours</h2>
        <div class="hours-grid">
          {tavern.openingHours!.map((line, idx) => {
            const [day, time] = line.split(': ');
            const isToday = idx === todayIndex;
            return (
              <div class={`hours-row${isToday ? ' hours-row--today' : ''}`}>
                <span class="hours-day">{day}</span>
                <span class="hours-time">{time ?? '—'}</span>
                {isToday && <span class="hours-today-tag">Today</span>}
              </div>
            );
          })}
        </div>
      </div>
    )}

  </main>

  <!-- SIDEBAR -->
  <aside class="t-sidebar">

    <!-- Rating -->
    {tavern.rating > 0 && (
      <div class="s-card">
        <p class="s-card-label">Rating</p>
        <div class="s-rating">
          <span class="s-rating-num">{tavern.rating}</span>
          <div class="s-rating-right">
            <span class="s-rating-stars">{'★'.repeat(Math.round(tavern.rating))}{'☆'.repeat(5 - Math.round(tavern.rating))}</span>
            <span class="s-rating-sub">out of 5</span>
          </div>
        </div>
      </div>
    )}

    <!-- Info -->
    <div class="s-card">
      <p class="s-card-label">Information</p>
      <ul class="s-info-list">
        {tavern.location.area && (
          <li class="s-info-row">
            <span class="s-info-key">Area</span>
            <span class="s-info-val">{tavern.location.area}</span>
          </li>
        )}
        {tavern.priceRange && (
          <li class="s-info-row">
            <span class="s-info-key">Prices</span>
            <span class="s-info-val s-info-price">{tavern.priceRange}</span>
          </li>
        )}
        {tavern.hours && (
          <li class="s-info-row">
            <span class="s-info-key">Today</span>
            <span class="s-info-val">{tavern.hours}</span>
          </li>
        )}
        {tavern.phone && (
          <li class="s-info-row">
            <span class="s-info-key">Phone</span>
            <a href={`tel:${tavern.phone}`} class="s-info-link">{tavern.phone}</a>
          </li>
        )}
        {tavern.location.address && (
          <li class="s-info-row">
            <span class="s-info-key">Address</span>
            <span class="s-info-val s-info-addr">{tavern.location.address}</span>
          </li>
        )}
      </ul>
    </div>

    <!-- CTAs -->
    <div class="s-ctas">
      {tavern.googleMapsUri && (
        <a href={tavern.googleMapsUri} target="_blank" rel="noopener noreferrer" class="s-btn s-btn--maps">
          <span>📍</span> Google Maps ↗
        </a>
      )}
      {tavern.website && (
        <a href={tavern.website} target="_blank" rel="noopener noreferrer" class="s-btn s-btn--web">
          <span>🌐</span> Website ↗
        </a>
      )}
    </div>

  </aside>

</div>


<!-- RELATED -->
{related.length > 0 && (
  <section class="sec sec-sand related-sec">
    <div class="container">
      <div class="sec-hdr-row">
        <div>
          <span class="label">Same area</span>
          <h2 class="sec-title">More restaurants in {tavern.location.area}</h2>
        </div>
        <a href="/eat" class="see-all">All restaurants →</a>
      </div>
      <div class="related-grid">
        {related.map(r => (
          <a href={`/eat/${r.slug}`} class="rel-card">
            <div class="rel-img-wrap">
              {r.localPhoto ? (
                <img
                  src={r.localPhoto}
                  alt={getName(r)}
                  class="rel-img"
                  loading="lazy"
                />
              ) : (
                <div class="rel-ph" aria-hidden="true">◈</div>
              )}
            </div>
            <div class="rel-body">
              <p class="rel-area">{r.location.area}</p>
              <h3 class="rel-name">{getName(r)}</h3>
              {r.rating > 0 && <p class="rel-rating">★ {r.rating}</p>}
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>
)}

</Layout>


<style>
/* ── HERO ── */
.t-hero {
  position: relative;
  height: 480px;
  background: var(--deep-blue);
  overflow: hidden;
}
.t-hero-img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  display: block;
}
.t-hero-ph {
  width: 100%;
  height: 100%;
  background: linear-gradient(140deg, #0d2b4e, #1a5c8a);
}
.t-hero-overlay {
  position: absolute;
  inset: 0;
  background: linear-gradient(to top, rgba(0,0,0,.72) 0%, rgba(0,0,0,.15) 55%, transparent 100%);
  display: flex;
  flex-direction: column;
  justify-content: flex-end;
}
.t-hero-inner {
  padding-bottom: 2.5rem;
}
.back-link {
  display: inline-flex;
  align-items: center;
  gap: .4rem;
  position: absolute;
  top: 1.5rem;
  left: 1.5rem;
  font-size: .75rem;
  font-weight: 600;
  letter-spacing: .05em;
  text-transform: uppercase;
  color: #fff;
  background: rgba(0,0,0,.35);
  backdrop-filter: blur(6px);
  padding: .35rem .85rem;
  border-radius: 100px;
  transition: background .15s;
}
.back-link:hover { background: rgba(0,0,0,.55); }
.featured-badge {
  display: inline-block;
  font-size: .58rem;
  font-weight: 700;
  letter-spacing: .07em;
  text-transform: uppercase;
  background: var(--aegean);
  color: #fff;
  padding: 3px 10px;
  border-radius: 100px;
  margin-bottom: .5rem;
}
.t-hero-name {
  font-family: var(--font-serif);
  font-size: clamp(2rem, 5vw, 3.5rem);
  color: #fff;
  line-height: 1.05;
  margin: 0 0 .4rem;
  text-shadow: 0 2px 12px rgba(0,0,0,.3);
}
.t-hero-area {
  font-size: .8rem;
  font-weight: 600;
  text-transform: uppercase;
  letter-spacing: .08em;
  color: rgba(255,255,255,.75);
  margin: 0;
  display: flex;
  align-items: center;
  gap: .5rem;
}
.area-dot { color: var(--sky); }
.area-sep { opacity: .5; }

/* ── LAYOUT ── */
.t-layout {
  display: grid;
  grid-template-columns: 1fr 300px;
  gap: 3rem;
  padding-top: 2.5rem;
  padding-bottom: 4rem;
  align-items: start;
}

/* ── QUICK BAR ── */
.quick-bar {
  display: flex;
  align-items: center;
  gap: 0;
  background: var(--white);
  border: 1px solid var(--border);
  border-radius: var(--radius-md);
  overflow: hidden;
  margin-bottom: 2rem;
}
.qb-item {
  display: flex;
  align-items: center;
  gap: .4rem;
  padding: .9rem 1.25rem;
  border-right: 1px solid var(--border);
  flex-shrink: 0;
}
.qb-item:last-child { border-right: none; }
.qb-icon { font-size: .9rem; }
.qb-val { font-size: .95rem; font-weight: 600; color: var(--ink); }
.qb-label { font-size: .72rem; color: var(--muted); }
.qb-hours { font-size: .82rem; }

/* ── MAIN ── */
.t-desc {
  font-size: 1.05rem;
  line-height: 1.8;
  color: var(--ink);
  margin-bottom: 1.5rem;
}
.t-tags {
  display: flex;
  flex-wrap: wrap;
  gap: .45rem;
  margin-bottom: 2.5rem;
}
.tag {
  font-size: .72rem;
  font-weight: 500;
  padding: .3rem .85rem;
  border-radius: 100px;
  background: var(--sand);
  color: var(--ink);
  border: 1px solid var(--sand-dark);
}

/* Hours */
.hours-block { margin-bottom: 2rem; }
.block-title {
  font-size: .65rem;
  font-weight: 700;
  letter-spacing: .12em;
  text-transform: uppercase;
  color: var(--muted);
  margin-bottom: .85rem;
}
.hours-grid {
  border: 1px solid var(--border);
  border-radius: var(--radius-md);
  overflow: hidden;
}
.hours-row {
  display: flex;
  align-items: center;
  gap: 1rem;
  padding: .6rem 1rem;
  border-bottom: 1px solid var(--border);
  font-size: .875rem;
}
.hours-row:last-child { border-bottom: none; }
.hours-row:nth-child(even) { background: var(--sand); }
.hours-row--today { background: rgba(26,92,138,.06) !important; }
.hours-day { font-weight: 500; width: 100px; flex-shrink: 0; }
.hours-time { color: var(--muted); flex: 1; }
.hours-today-tag {
  font-size: .58rem;
  font-weight: 700;
  letter-spacing: .06em;
  text-transform: uppercase;
  background: var(--aegean);
  color: #fff;
  padding: 2px 7px;
  border-radius: 4px;
  flex-shrink: 0;
}

/* ── SIDEBAR ── */
.t-sidebar {
  display: flex;
  flex-direction: column;
  gap: 1rem;
  position: sticky;
  top: calc(var(--header-h) + 1.5rem);
}
.s-card {
  background: var(--white);
  border: 1px solid var(--border);
  border-radius: var(--radius-md);
  padding: 1.25rem;
}
.s-card-label {
  font-size: .62rem;
  font-weight: 700;
  letter-spacing: .12em;
  text-transform: uppercase;
  color: var(--muted);
  margin-bottom: .85rem;
}
.s-rating {
  display: flex;
  align-items: center;
  gap: .85rem;
}
.s-rating-num {
  font-family: var(--font-serif);
  font-size: 2.8rem;
  color: var(--ink);
  line-height: 1;
}
.s-rating-right { display: flex; flex-direction: column; gap: .15rem; }
.s-rating-stars { font-size: .9rem; color: #d97706; letter-spacing: .1em; }
.s-rating-sub { font-size: .72rem; color: var(--muted); }

.s-info-list { list-style: none; padding: 0; margin: 0; display: flex; flex-direction: column; gap: .6rem; }
.s-info-row { display: flex; justify-content: space-between; align-items: flex-start; font-size: .875rem; gap: .5rem; }
.s-info-key { font-weight: 600; color: var(--muted); flex-shrink: 0; }
.s-info-val { color: var(--ink); text-align: right; }
.s-info-price { font-weight: 700; color: #b08d57; }
.s-info-addr { font-size: .78rem; color: var(--muted); text-align: right; line-height: 1.4; }
.s-info-link { color: var(--aegean); font-weight: 500; }
.s-info-link:hover { text-decoration: underline; }

.s-ctas { display: flex; flex-direction: column; gap: .6rem; }
.s-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: .5rem;
  padding: .8rem 1rem;
  border-radius: var(--radius-md);
  font-family: var(--font-sans);
  font-size: .875rem;
  font-weight: 600;
  text-align: center;
  transition: transform .15s, box-shadow .15s, opacity .15s;
}
.s-btn:hover { transform: translateY(-1px); opacity: .9; }
.s-btn--maps { background: var(--deep-blue); color: #fff; box-shadow: var(--shadow-sm); }
.s-btn--web  { background: var(--white); color: var(--ink); border: 1px solid var(--border); }

/* ── RELATED ── */
.related-sec { margin-top: 0; }
.related-grid { display: grid; grid-template-columns: repeat(3,1fr); gap: 1rem; }
.rel-card {
  display: flex;
  flex-direction: column;
  background: var(--white);
  border: 1px solid var(--border);
  border-radius: var(--radius-md);
  overflow: hidden;
  transition: transform .2s, box-shadow .2s;
}
.rel-card:hover { transform: translateY(-3px); box-shadow: var(--shadow-md); }
.rel-img-wrap { height: 140px; overflow: hidden; background: var(--sand); flex-shrink: 0; }
.rel-img { width: 100%; height: 100%; object-fit: cover; transition: transform .4s; }
.rel-card:hover .rel-img { transform: scale(1.05); }
.rel-ph { width: 100%; height: 100%; display: flex; align-items: center; justify-content: center; font-size: 2rem; color: var(--sand-dark); background: linear-gradient(140deg, var(--sand), var(--sand-dark)); }
.rel-body { padding: .9rem 1rem 1rem; display: flex; flex-direction: column; gap: .2rem; }
.rel-area { font-size: .65rem; font-weight: 600; letter-spacing: .08em; text-transform: uppercase; color: #c0613a; }
.rel-name { font-family: var(--font-serif); font-size: 1rem; color: var(--ink); line-height: 1.25; }
.rel-rating { font-size: .78rem; color: #d97706; font-weight: 600; margin-top: .15rem; }

/* ── RESPONSIVE ── */
@media (max-width: 900px) {
  .related-grid { grid-template-columns: 1fr 1fr; }
}
@media (max-width: 768px) {
  .t-hero { height: 340px; }
  .t-layout { grid-template-columns: 1fr; gap: 2rem; }
  .t-sidebar { position: static; }
  .quick-bar { flex-wrap: wrap; }
  .qb-item { border-bottom: 1px solid var(--border); width: 50%; }
  .qb-item:nth-child(2n) { border-right: none; }
  .related-grid { grid-template-columns: 1fr; }
}
@media (max-width: 480px) {
  .t-hero { height: 260px; }
  .t-hero-name { font-size: 1.75rem; }
}
</style>