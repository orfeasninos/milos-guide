---
import Layout from '../layouts/Layout.astro';
import tavernsRaw from '../data/taverns.json';
import beachesRaw from '../data/beaches.json';
import villagesRaw from '../data/villages.json';
import accommodationsRaw from '../data/accommodations.json';

const points = [
  ...tavernsRaw
    .filter(t => t.coordinates?.lat && t.coordinates?.lng)
    .map(t => ({
      slug:  t.slug, type: 'restaurant',
      name:  typeof t.name === 'object' ? (t.name as any).en : t.name,
      area:  t.location.area, rating: t.rating, photo: t.localPhoto ?? null,
      url:   `/eat/${t.slug}`, lat: t.coordinates.lat, lng: t.coordinates.lng, icon: '🍽',
    })),
  ...beachesRaw
    .filter(b => b.coordinates?.lat && b.coordinates?.lng)
    .map(b => ({
      slug:  b.slug, type: 'beach',
      name:  typeof b.name === 'object' ? (b.name as any).en : b.name,
      area:  b.location.area, rating: b.rating, photo: b.localPhoto ?? null,
      url:   `/beaches/${b.slug}`, lat: b.coordinates.lat, lng: b.coordinates.lng, icon: '🏖',
    })),
  ...(accommodationsRaw as any[])
    .filter((a: any) => a.coordinates?.lat && a.coordinates?.lng)
    .map((a: any) => ({
      slug:  a.slug, type: 'accommodation',
      name:  typeof a.name === 'object' ? a.name.en : a.name,
      area:  a.location.area, rating: a.rating, photo: a.localPhoto ?? null,
      url:   `/stay/${a.slug}`, lat: a.coordinates.lat, lng: a.coordinates.lng, icon: '🏨',
    })),
  ...villagesRaw
    .filter(v => v.coordinates?.lat && v.coordinates?.lng)
    .map(v => ({
      slug:  v.slug, type: 'village',
      name:  (v as any).nameEn ?? v.name,
      area:  v.area, rating: 0, photo: null,
      url:   `/villages/${v.slug}`, lat: v.coordinates.lat, lng: v.coordinates.lng, icon: '🏘',
    })),
];
---

<Layout
  lang="en"
  title="Map of Milos"
  description="Interactive map of Milos — beaches, restaurants, villages and accommodation."
>

<div class="map-page">
  <aside class="map-sidebar" id="map-sidebar">
    <div class="sidebar-top">
      <h1 class="sidebar-title">Milos Map</h1>
      <p class="sidebar-count" id="sidebar-count">{points.length} places</p>
    </div>
    <div class="sidebar-filters">
      <button class="mf-chip mf-chip--active" data-filter="beach">🏖 Beaches</button>
      <button class="mf-chip mf-chip--active" data-filter="restaurant">🍽 Food</button>
      <button class="mf-chip mf-chip--active" data-filter="village">🏘 Villages</button>
      <button class="mf-chip" data-filter="accommodation">🏨 Stay</button>
    </div>
    <div class="sidebar-cards" id="sidebar-cards">
      {points.map(p => (
        <a href={p.url} class="mc" id={`mc-${p.slug}`} data-slug={p.slug} data-type={p.type} data-lat={p.lat} data-lng={p.lng}>
          <div class="mc-img-wrap">
            {p.photo ? <img src={p.photo} alt={p.name} class="mc-img" loading="lazy" /> : <div class="mc-ph">{p.icon}</div>}
          </div>
          <div class="mc-body">
            <span class="mc-type">{p.type}</span>
            <p class="mc-name">{p.name}</p>
            <p class="mc-area">📍 {p.area}</p>
            {p.rating > 0 && <p class="mc-rating">★ {p.rating}</p>}
          </div>
        </a>
      ))}
    </div>
    <div class="sidebar-empty" id="sidebar-empty" style="display:none">
      <p class="empty-icon">🗺</p>
      <p class="empty-text">No results for this filter.</p>
    </div>
  </aside>

  <div class="map-wrap" id="map-wrap">
    <div id="map"></div>
  </div>
</div>

</Layout>

<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/leaflet/1.9.4/leaflet.min.css" />
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/leaflet.markercluster/1.5.3/MarkerCluster.css" />
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/leaflet.markercluster/1.5.3/MarkerCluster.Default.css" />

<style>
.map-page { display: flex; height: calc(100vh - var(--header-h)); overflow: hidden; position: relative; z-index: 0; }

.map-sidebar { width: 340px; flex-shrink: 0; display: flex; flex-direction: column; background: var(--sand); border-right: 1px solid var(--border); overflow: hidden; }
.sidebar-top { padding: 1.25rem 1.25rem 0.75rem; border-bottom: 1px solid var(--border); background: var(--white); flex-shrink: 0; }
.sidebar-title { font-family: var(--font-serif); font-size: 1.4rem; color: var(--deep-blue); margin-bottom: 0.15rem; }
.sidebar-count { font-size: 0.75rem; color: var(--muted); }

.sidebar-filters { display: flex; gap: 0.35rem; padding: 0.75rem 1.25rem; flex-wrap: wrap; background: var(--white); border-bottom: 1px solid var(--border); flex-shrink: 0; }
.mf-chip {
  padding: 0.28rem 0.75rem;
  border-radius: 100px;
  border: 1.5px solid var(--border);
  background: transparent;
  font-family: var(--font-sans);
  font-size: 0.75rem;
  font-weight: 500;
  color: var(--muted);
  cursor: pointer;
  transition: background 0.15s, color 0.15s, border-color 0.15s, opacity 0.15s;
  white-space: nowrap;
  user-select: none;
}
.mf-chip:hover { background: var(--sand); color: var(--ink); border-color: var(--sand-dark); }
.mf-chip--active { background: var(--deep-blue); color: #fff; border-color: var(--deep-blue); }
.mf-chip[data-filter="beach"].mf-chip--active    { background: #1a7fc1; border-color: #1a7fc1; }
.mf-chip[data-filter="restaurant"].mf-chip--active { background: #b05230; border-color: #b05230; }
.mf-chip[data-filter="village"].mf-chip--active  { background: #2d6a4f; border-color: #2d6a4f; }
.mf-chip[data-filter="accommodation"].mf-chip--active { background: #7b5ea7; border-color: #7b5ea7; }

.sidebar-cards { flex: 1; overflow-y: auto; padding: 0.5rem 0; }
.sidebar-cards::-webkit-scrollbar { width: 4px; }
.sidebar-cards::-webkit-scrollbar-track { background: transparent; }
.sidebar-cards::-webkit-scrollbar-thumb { background: var(--sand-dark); border-radius: 4px; }

.mc { display: flex; align-items: center; gap: 0.85rem; padding: 0.75rem 1.25rem; border-bottom: 1px solid var(--border); color: inherit; transition: background 0.15s; cursor: pointer; }
.mc:hover { background: var(--white); }
.mc.is-active { background: var(--white); border-left: 3px solid var(--aegean); }
.mc-img-wrap { width: 52px; height: 52px; border-radius: 10px; overflow: hidden; flex-shrink: 0; background: var(--sand-dark); }
.mc-img { width: 100%; height: 100%; object-fit: cover; }
.mc-ph { width: 100%; height: 100%; display: flex; align-items: center; justify-content: center; font-size: 1.4rem; background: var(--sand-dark); }
.mc-body { flex: 1; min-width: 0; }
.mc-type { font-size: 0.6rem; font-weight: 700; letter-spacing: 0.1em; text-transform: uppercase; color: var(--sea); display: block; }
.mc-name { font-family: var(--font-serif); font-size: 0.95rem; color: var(--ink); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; margin: 0.1rem 0; }
.mc-area { font-size: 0.72rem; color: var(--muted); }
.mc-rating { font-size: 0.72rem; color: #d97706; margin-top: 0.1rem; }

.sidebar-empty { text-align: center; padding: 3rem 1rem; }
.sidebar-empty .empty-icon { font-size: 2.5rem; margin-bottom: 0.75rem; }
.sidebar-empty .empty-text { font-size: 0.875rem; color: var(--muted); }

.map-wrap { flex: 1; position: relative; overflow: hidden; }
#map { position: absolute; inset: 0; width: 100%; height: 100%; }

/* Layer switcher styling */
:global(.leaflet-control-layers) {
  border: 1px solid var(--border) !important;
  border-radius: var(--radius-md) !important;
  box-shadow: var(--shadow-md) !important;
  font-family: var(--font-sans) !important;
  font-size: 0.8rem !important;
}
:global(.leaflet-control-layers-toggle) {
  background-color: var(--white) !important;
  border-radius: var(--radius-md) !important;
  width: 32px !important;
  height: 32px !important;
}

.custom-marker { cursor: pointer; transition: transform 0.15s; }
.custom-marker:hover { transform: translateY(-4px) scale(1.12); }
.custom-marker--active { transform: translateY(-5px) scale(1.2) !important; }

:global(.cluster-icon) { background: var(--deep-blue); color: #fff; border-radius: 50%; display: flex; align-items: center; justify-content: center; font-family: var(--font-sans); font-weight: 700; font-size: 0.85rem; border: 3px solid #fff; box-shadow: 0 3px 10px rgba(0,0,0,0.3); }
:global(.cluster-icon span) { line-height: 1; }
:global(.leaflet-popup-content-wrapper) { border-radius: 12px !important; box-shadow: 0 8px 24px rgba(0,0,0,0.15) !important; padding: 0 !important; overflow: hidden; }
:global(.leaflet-popup-content) { margin: 0 !important; }
:global(.map-popup) { width: 200px; }
:global(.map-popup-img) { width: 100%; height: 110px; object-fit: cover; display: block; }
:global(.map-popup-ph) { width: 100%; height: 110px; display: flex; align-items: center; justify-content: center; font-size: 2rem; background: var(--sand); }
:global(.map-popup-body) { padding: 0.85rem 1rem; }
:global(.map-popup-type) { font-size: 0.6rem; font-weight: 700; letter-spacing: 0.1em; text-transform: uppercase; color: var(--sea); display: block; margin-bottom: 0.2rem; }
:global(.map-popup-name) { font-family: var(--font-serif); font-size: 1rem; color: var(--ink); margin-bottom: 0.25rem; line-height: 1.2; }
:global(.map-popup-area) { font-size: 0.72rem; color: var(--muted); margin-bottom: 0.65rem; }
:global(.map-popup-link) { display: inline-block; font-size: 0.75rem; font-weight: 600; color: var(--aegean); border-bottom: 1px solid var(--sea); padding-bottom: 1px; }

/* ── MOBILE ── */
@media (max-width: 768px) {
  .map-page {
    flex-direction: column;
    height: calc(100vh - var(--header-h));
    overflow: hidden;
  }

  /* Sidebar on top */
  .map-sidebar {
    width: 100%;
    height: 45vh;
    flex-shrink: 0;
    min-height: 0;
    border-right: none;
    border-bottom: 2px solid var(--border);
    background: var(--white);
  }

  /* Map below */
  .map-wrap {
    flex: 1;
    position: relative;
  }

  /* Compact header */
  .sidebar-top {
    padding: 0.65rem 1rem 0.5rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
  }
  .sidebar-title { font-size: 1.1rem; margin: 0; }
  .sidebar-count { margin: 0; }

  /* Chips in one scrollable row */
  .sidebar-filters {
    padding: 0.4rem 1rem;
    flex-wrap: nowrap;
    overflow-x: auto;
    gap: 0.4rem;
    -webkit-overflow-scrolling: touch;
    scrollbar-width: none;
  }
  .sidebar-filters::-webkit-scrollbar { display: none; }
  .mf-chip { font-size: 0.72rem; padding: 0.22rem 0.65rem; flex-shrink: 0; }

  /* Cards compact */
  .mc { padding: 0.55rem 1rem; gap: 0.65rem; }
  .mc-img-wrap { width: 40px; height: 40px; border-radius: 8px; }
  .mc-name { font-size: 0.88rem; }
  .mc-area { font-size: 0.68rem; }
}
</style>

<script define:vars={{ points }}>
const script = document.createElement('script');
script.src = 'https://cdnjs.cloudflare.com/ajax/libs/leaflet/1.9.4/leaflet.min.js';
script.onload = () => {
  const clusterScript = document.createElement('script');
  clusterScript.src = 'https://cdnjs.cloudflare.com/ajax/libs/leaflet.markercluster/1.5.3/leaflet.markercluster.min.js';
  clusterScript.onload = initMap;
  document.head.appendChild(clusterScript);
};
document.head.appendChild(script);

const markerColors = { beach: '#1a7fc1', restaurant: '#b05230', village: '#2d6a4f', accommodation: '#7b5ea7' };
const markerEmoji  = { beach: '🏖', restaurant: '🍽', village: '🏘', accommodation: '🏨' };

let map, markers = [], clusterGroup, activeSlug = null;
// All types active by default
let activeFilters = new Set(['beach', 'restaurant', 'village']);

function initMap() {
  const milosBounds = L.latLngBounds(L.latLng(36.60, 24.25), L.latLng(36.85, 24.65));

  map = L.map('map', {
    center: [36.710, 24.430],
    zoom: 12,
    minZoom: 12,
    maxZoom: 18,
    maxBounds: milosBounds,
    maxBoundsViscosity: 1.0,
    zoomControl: true,
  });

  const wikimediaLayer = L.tileLayer('https://maps.wikimedia.org/osm-intl/{z}/{x}/{y}{r}.png', {
    maxZoom: 19,
    attribution: '<a href="https://wikimediafoundation.org/wiki/Maps_Terms_of_Use">Wikimedia</a> | &copy; OpenStreetMap'
  });
  const satelliteLayer = L.tileLayer('https://server.arcgisonline.com/ArcGIS/rest/services/World_Imagery/MapServer/tile/{z}/{y}/{x}', {
    maxZoom: 19,
    attribution: 'Tiles &copy; Esri'
  });
  wikimediaLayer.addTo(map);
  L.control.layers({ "Map": wikimediaLayer, "Satellite": satelliteLayer }, null, { position: 'topright', collapsed: true }).addTo(map);

  clusterGroup = L.markerClusterGroup({
    maxClusterRadius: 50,
    disableClusteringAtZoom: 15,
    zoomToBoundsOnClick: true,
    iconCreateFunction: (cluster) => {
      const count = cluster.getChildCount();
      const size = count < 10 ? 36 : count < 20 ? 42 : 48;
      return L.divIcon({
        html: `<div class="cluster-icon" style="width:${size}px;height:${size}px"><span>${count}</span></div>`,
        className: '', iconSize: [size, size], iconAnchor: [size/2, size/2],
      });
    },
    spiderfyOnMaxZoom: true,
    showCoverageOnHover: false,
  });

  points.forEach(p => {
    const color = markerColors[p.type] || '#0d2b4e';
    const emoji = markerEmoji[p.type] || '📍';
    const svg = `<svg xmlns="http://www.w3.org/2000/svg" width="40" height="52" viewBox="0 0 40 52">
      <defs><filter id="sh-${p.slug}" x="-30%" y="-20%" width="160%" height="160%">
        <feDropShadow dx="0" dy="3" stdDeviation="3" flood-color="rgba(0,0,0,0.35)"/>
      </filter></defs>
      <path d="M20 2 C10.06 2 2 10.06 2 20 C2 31 20 50 20 50 C20 50 38 31 38 20 C38 10.06 29.94 2 20 2 Z"
        fill="${color}" filter="url(#sh-${p.slug})"/>
      <circle cx="20" cy="20" r="13" fill="white" opacity="0.2"/>
      <text x="20" y="26" text-anchor="middle" font-size="16">${emoji}</text>
    </svg>`;

    const el = document.createElement('div');
    el.className = 'custom-marker';
    el.innerHTML = svg;

    const icon = L.divIcon({ html: el, className: '', iconSize: [40, 52], iconAnchor: [20, 52] });
    const marker = L.marker([p.lat, p.lng], { icon });

    const photoHtml = p.photo
      ? `<img src="${p.photo}" alt="${p.name}" class="map-popup-img" />`
      : `<div class="map-popup-ph">${markerEmoji[p.type]}</div>`;

    marker.bindPopup(L.popup({ maxWidth: 200, minWidth: 200, offset: [0, -8] }).setContent(`
      <div class="map-popup">
        ${photoHtml}
        <div class="map-popup-body">
          <span class="map-popup-type">${p.type}</span>
          <p class="map-popup-name">${p.name}</p>
          <p class="map-popup-area">📍 ${p.area}</p>
          <a href="${p.url}" class="map-popup-link">View details →</a>
        </div>
      </div>
    `));

    marker.on('click', () => activateCard(p.slug, false));
    markers.push({ slug: p.slug, type: p.type, marker, el });
    clusterGroup.addLayer(marker);
  });

  map.addLayer(clusterGroup);
  setTimeout(() => map.invalidateSize(), 300);
  applyFilter(); // sync initial state

  // Filter chips — multi-select toggle
  document.querySelectorAll('.mf-chip').forEach(chip => {
    chip.addEventListener('click', () => {
      const filter = chip.dataset.filter;
      if (activeFilters.has(filter)) {
        // Don't allow deselecting all
        if (activeFilters.size > 1) {
          activeFilters.delete(filter);
          chip.classList.remove('mf-chip--active');
        }
      } else {
        activeFilters.add(filter);
        chip.classList.add('mf-chip--active');
      }
      applyFilter();
    });
  });

  // Sidebar card clicks
  document.querySelectorAll('.mc').forEach(card => {
    card.addEventListener('click', e => {
      e.preventDefault();
      const slug = card.dataset.slug;
      activateCard(slug, true);
      const m = markers.find(m => m.slug === slug);
      if (!m) return;
      clusterGroup.zoomToShowLayer(m.marker, () => m.marker.openPopup());
    });
  });
}

function activateCard(slug, scroll) {
  if (activeSlug) {
    document.getElementById(`mc-${activeSlug}`)?.classList.remove('is-active');
    const prev = markers.find(m => m.slug === activeSlug);
    if (prev) prev.el.classList.remove('custom-marker--active');
  }
  activeSlug = slug;
  const card = document.getElementById(`mc-${slug}`);
  card?.classList.add('is-active');
  if (scroll && card) card.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
  const m = markers.find(m => m.slug === slug);
  if (m) m.el.classList.add('custom-marker--active');
}

function applyFilter() {
  let visible = 0;
  clusterGroup.clearLayers();
  markers.forEach(m => {
    const show = activeFilters.has(m.type);
    if (show) { clusterGroup.addLayer(m.marker); visible++; }
  });
  document.querySelectorAll('.mc').forEach(card => {
    card.style.display = activeFilters.has(card.dataset.type) ? '' : 'none';
  });
  const counter = document.getElementById('sidebar-count');
  if (counter) counter.textContent = `${visible} places`;
  const empty = document.getElementById('sidebar-empty');
  const cards = document.getElementById('sidebar-cards');
  if (empty && cards) {
    empty.style.display = visible === 0 ? 'block' : 'none';
    cards.style.display = visible === 0 ? 'none' : '';
  }
}
</script>