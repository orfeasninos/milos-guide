---
import Layout from '../../layouts/Layout.astro';
import tavernsRaw from '../../data/taverns.json';
import beachesRaw from '../../data/beaches.json';
import villagesRaw from '../../data/villages.json';

// Build flat points array for the map
const points = [
  ...tavernsRaw
    .filter(t => t.coordinates?.lat && t.coordinates?.lng)
    .map(t => ({
      slug:  t.slug,
      type:  'restaurant',
      name:  typeof t.name === 'object' ? (t.name as any).el : t.name,
      area:  t.location.area,
      rating: t.rating,
      photo: t.localPhoto ?? null,
      url:   `/el/eat/${t.slug}`,
      lat:   t.coordinates.lat,
      lng:   t.coordinates.lng,
      icon:  '🍽',
    })),
  ...beachesRaw
    .filter(b => b.coordinates?.lat && b.coordinates?.lng)
    .map(b => ({
      slug:  b.slug,
      type:  'beach',
      name:  typeof b.name === 'object' ? (b.name as any).el : b.name,
      area:  b.location.area,
      rating: b.rating,
      photo: b.localPhoto ?? null,
      url:   `/el/beaches/${b.slug}`,
      lat:   b.coordinates.lat,
      lng:   b.coordinates.lng,
      icon:  '🏖',
    })),
  ...villagesRaw
    .filter(v => v.coordinates?.lat && v.coordinates?.lng)
    .map(v => ({
      slug:  v.slug,
      type:  'village',
      name:  v.name,
      area:  v.area,
      rating: 0,
      photo: null,
      url:   `/el/villages/${v.slug}`,
      lat:   v.coordinates.lat,
      lng:   v.coordinates.lng,
      icon:  '🏘',
    })),
];
---

<Layout
  lang="el"
  title="Χάρτης Μήλου"
  description="Διαδραστικός χάρτης της Μήλου — παραλίες, εστιατόρια και χωριά. Βρες τα πάντα στο νησί σε ένα μέρος."
>

<div class="map-page">

  <!-- SIDEBAR -->
  <aside class="map-sidebar" id="map-sidebar">
    <div class="sidebar-top">
      <h1 class="sidebar-title">Χάρτης Μήλου</h1>
      <p class="sidebar-count" id="sidebar-count">{points.length} places</p>
    </div>

    <!-- Filters -->
    <div class="sidebar-filters">
      <button class="mf-chip mf-chip--active" data-filter="all">Όλα</button>
      <button class="mf-chip" data-filter="beach">🏖 Παραλίες</button>
      <button class="mf-chip" data-filter="restaurant">🍽 Φαγητό</button>
      <button class="mf-chip" data-filter="village">🏘 Χωριά</button>
    </div>

    <!-- Cards -->
    <div class="sidebar-cards" id="sidebar-cards">
      {points.map(p => (
        <a
          href={p.url}
          class="mc"
          id={`mc-${p.slug}`}
          data-slug={p.slug}
          data-type={p.type}
          data-lat={p.lat}
          data-lng={p.lng}
        >
          <div class="mc-img-wrap">
            {p.photo ? (
              <img src={p.photo} alt={p.name} class="mc-img" loading="lazy" />
            ) : (
              <div class="mc-ph">{p.icon}</div>
            )}
          </div>
          <div class="mc-body">
            <span class="mc-type">{p.type}</span>
            <p class="mc-name">{p.name}</p>
            <p class="mc-area">📍 {p.area}</p>
            {p.rating > 0 && <p class="mc-rating">★ {p.rating}</p>}
          </div>
        </a>
      ))}
    </div>

    <div class="sidebar-empty" id="sidebar-empty" style="display:none">
      <p class="empty-icon">🗺</p>
      <p class="empty-text">Δεν βρέθηκαν αποτελέσματα.</p>
    </div>
  </aside>

  <!-- MAP -->
  <div class="map-wrap" id="map-wrap">
    <div id="map"></div>
  </div>

</div>

</Layout>

<!-- Leaflet CSS -->
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/leaflet/1.9.4/leaflet.min.css" />

<style>
/* Full-height layout */
.map-page {
  display: flex;
  height: calc(100vh - var(--header-h));
  overflow: hidden;
}

/* ── SIDEBAR ── */
.map-sidebar {
  width: 340px;
  flex-shrink: 0;
  display: flex;
  flex-direction: column;
  background: var(--sand);
  border-right: 1px solid var(--border);
  overflow: hidden;
}

.sidebar-top {
  padding: 1.25rem 1.25rem 0.75rem;
  border-bottom: 1px solid var(--border);
  background: var(--white);
  flex-shrink: 0;
}
.sidebar-title {
  font-family: var(--font-serif);
  font-size: 1.4rem;
  color: var(--deep-blue);
  margin-bottom: 0.15rem;
}
.sidebar-count {
  font-size: 0.75rem;
  color: var(--muted);
}

.sidebar-filters {
  display: flex;
  gap: 0.35rem;
  padding: 0.75rem 1.25rem;
  flex-wrap: wrap;
  background: var(--white);
  border-bottom: 1px solid var(--border);
  flex-shrink: 0;
}
.mf-chip {
  padding: 0.28rem 0.75rem;
  border-radius: 100px;
  border: 1px solid var(--border);
  background: transparent;
  font-family: var(--font-sans);
  font-size: 0.75rem;
  font-weight: 500;
  color: var(--muted);
  cursor: pointer;
  transition: background 0.15s, color 0.15s, border-color 0.15s;
  white-space: nowrap;
}
.mf-chip:hover { background: var(--sand); color: var(--ink); }
.mf-chip--active { background: var(--deep-blue); color: #fff; border-color: var(--deep-blue); }

.sidebar-cards {
  flex: 1;
  overflow-y: auto;
  padding: 0.5rem 0;
}
.sidebar-cards::-webkit-scrollbar { width: 4px; }
.sidebar-cards::-webkit-scrollbar-track { background: transparent; }
.sidebar-cards::-webkit-scrollbar-thumb { background: var(--sand-dark); border-radius: 4px; }

/* Card */
.mc {
  display: flex;
  align-items: center;
  gap: 0.85rem;
  padding: 0.75rem 1.25rem;
  border-bottom: 1px solid var(--border);
  color: inherit;
  transition: background 0.15s;
  cursor: pointer;
}
.mc:hover { background: var(--white); }
.mc.is-active { background: var(--white); border-left: 3px solid var(--aegean); }

.mc-img-wrap {
  width: 52px;
  height: 52px;
  border-radius: 10px;
  overflow: hidden;
  flex-shrink: 0;
  background: var(--sand-dark);
}
.mc-img { width: 100%; height: 100%; object-fit: cover; }
.mc-ph {
  width: 100%;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 1.4rem;
  background: var(--sand-dark);
}
.mc-body { flex: 1; min-width: 0; }
.mc-type {
  font-size: 0.6rem;
  font-weight: 700;
  letter-spacing: 0.1em;
  text-transform: uppercase;
  color: var(--sea);
  display: block;
}
.mc-name {
  font-family: var(--font-serif);
  font-size: 0.95rem;
  color: var(--ink);
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
  margin: 0.1rem 0;
}
.mc-area { font-size: 0.72rem; color: var(--muted); }
.mc-rating { font-size: 0.72rem; color: #d97706; margin-top: 0.1rem; }

.sidebar-empty {
  text-align: center;
  padding: 3rem 1rem;
}
.sidebar-empty .empty-icon { font-size: 2.5rem; margin-bottom: 0.75rem; }
.sidebar-empty .empty-text { font-size: 0.875rem; color: var(--muted); }

/* ── MAP ── */
.map-wrap {
  flex: 1;
  position: relative;
  overflow: hidden;
}
#map {
  width: 100%;
  height: 100%;
}

/* Custom Leaflet marker — SVG pin */
.custom-marker {
  cursor: pointer;
  transition: transform 0.15s;
}
.custom-marker:hover { transform: translateY(-4px) scale(1.12); }
.custom-marker--active { transform: translateY(-5px) scale(1.2) !important; }

/* Popup */
.leaflet-popup-content-wrapper {
  border-radius: 12px !important;
  box-shadow: 0 8px 24px rgba(0,0,0,0.15) !important;
  padding: 0 !important;
  overflow: hidden;
}
.leaflet-popup-content { margin: 0 !important; }
.map-popup {
  width: 200px;
}
.map-popup-img {
  width: 100%;
  height: 110px;
  object-fit: cover;
  display: block;
}
.map-popup-ph {
  width: 100%;
  height: 110px;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 2rem;
  background: var(--sand);
}
.map-popup-body { padding: 0.85rem 1rem; }
.map-popup-type {
  font-size: 0.6rem;
  font-weight: 700;
  letter-spacing: 0.1em;
  text-transform: uppercase;
  color: var(--sea);
  display: block;
  margin-bottom: 0.2rem;
}
.map-popup-name {
  font-family: var(--font-serif);
  font-size: 1rem;
  color: var(--ink);
  margin-bottom: 0.25rem;
  line-height: 1.2;
}
.map-popup-area { font-size: 0.72rem; color: var(--muted); margin-bottom: 0.65rem; }
.map-popup-link {
  display: inline-block;
  font-size: 0.75rem;
  font-weight: 600;
  color: var(--aegean);
  border-bottom: 1px solid var(--sea);
  padding-bottom: 1px;
}

/* ── RESPONSIVE ── */
@media (max-width: 768px) {
  .map-page { flex-direction: column; height: auto; }
  .map-sidebar { width: 100%; height: 45vh; border-right: none; border-bottom: 1px solid var(--border); }
  .map-wrap { height: 55vh; }
}
</style>

<script define:vars={{ points }}>
// Load Leaflet dynamically
const script = document.createElement('script');
script.src = 'https://cdnjs.cloudflare.com/ajax/libs/leaflet/1.9.4/leaflet.min.js';
script.onload = initMap;
document.head.appendChild(script);

const markerColors = {
  beach:      '#3a9bc9',
  restaurant: '#c0613a',
  village:    '#0d2b4e',
};
const markerEmoji = {
  beach:      '🏖',
  restaurant: '🍽',
  village:    '🏘',
};

let map, markers = [], activeSlug = null, activeFilter = 'all';

function initMap() {
  map = L.map('map', {
    center: [36.738, 24.455],
    zoom: 12,
    zoomControl: true,
  });

  L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
    attribution: '© <a href="https://www.openstreetmap.org/">OpenStreetMap</a>',
    maxZoom: 18,
  }).addTo(map);

  // Add markers
  points.forEach(p => {
    const color = markerColors[p.type] || '#0d2b4e';
    const emoji = markerEmoji[p.type] || '📍';
    const svg = `<svg xmlns="http://www.w3.org/2000/svg" width="40" height="52" viewBox="0 0 40 52">
      <defs>
        <filter id="shadow-${p.slug}" x="-30%" y="-20%" width="160%" height="160%">
          <feDropShadow dx="0" dy="3" stdDeviation="3" flood-color="rgba(0,0,0,0.35)"/>
        </filter>
      </defs>
      <path d="M20 2 C10.06 2 2 10.06 2 20 C2 31 20 50 20 50 C20 50 38 31 38 20 C38 10.06 29.94 2 20 2 Z"
        fill="${color}" filter="url(#shadow-${p.slug})"/>
      <circle cx="20" cy="20" r="13" fill="white" opacity="0.2"/>
      <text x="20" y="26" text-anchor="middle" font-size="16">${emoji}</text>
    </svg>`;

    const el = document.createElement('div');
    el.className = 'custom-marker';
    el.innerHTML = svg;

    const icon = L.divIcon({ html: el, className: '', iconSize: [40, 52], iconAnchor: [20, 52] });
    const marker = L.marker([p.lat, p.lng], { icon }).addTo(map);

    const photoHtml = p.photo
      ? `<img src="${p.photo}" alt="${p.name}" class="map-popup-img" />`
      : `<div class="map-popup-ph">${markerEmoji[p.type]}</div>`;

    const popup = L.popup({ maxWidth: 200, minWidth: 200, offset: [0, -8] }).setContent(`
      <div class="map-popup">
        ${photoHtml}
        <div class="map-popup-body">
          <span class="map-popup-type">${p.type}</span>
          <p class="map-popup-name">${p.name}</p>
          <p class="map-popup-area">📍 ${p.area}</p>
          <a href="${p.url}" class="map-popup-link">Δες περισσότερα →</a>
        </div>
      </div>
    `);

    marker.bindPopup(popup);
    marker.on('click', () => activateCard(p.slug, false));

    markers.push({ slug: p.slug, type: p.type, marker, el });
  });

  // Sidebar card clicks
  document.querySelectorAll('.mc').forEach(card => {
    card.addEventListener('click', e => {
      e.preventDefault();
      const slug = card.dataset.slug;
      const lat  = parseFloat(card.dataset.lat);
      const lng  = parseFloat(card.dataset.lng);
      activateCard(slug, true);
      map.setView([lat, lng], 14, { animate: true });
      const m = markers.find(m => m.slug === slug);
      if (m) m.marker.openPopup();
    });
  });

  // Filter chips
  document.querySelectorAll('.mf-chip').forEach(chip => {
    chip.addEventListener('click', () => {
      document.querySelectorAll('.mf-chip').forEach(c => c.classList.remove('mf-chip--active'));
      chip.classList.add('mf-chip--active');
      activeFilter = chip.dataset.filter;
      applyFilter();
    });
  });
}

function activateCard(slug, scroll) {
  // Deactivate previous
  if (activeSlug) {
    document.getElementById(`mc-${activeSlug}`)?.classList.remove('is-active');
    const prev = markers.find(m => m.slug === activeSlug);
    if (prev) {
      prev.el.classList.remove('custom-marker--active');
    }
  }

  activeSlug = slug;

  // Activate card
  const card = document.getElementById(`mc-${slug}`);
  card?.classList.add('is-active');
  if (scroll && card) {
    card.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
  }

  // Activate marker
  const m = markers.find(m => m.slug === slug);
  if (m) {
    m.el.classList.add('custom-marker--active');
  }
}

function applyFilter() {
  let visible = 0;

  markers.forEach(m => {
    const show = activeFilter === 'all' || m.type === activeFilter;
    if (show) { m.marker.addTo(map); visible++; }
    else m.marker.remove();
  });

  document.querySelectorAll('.mc').forEach(card => {
    const show = activeFilter === 'all' || card.dataset.type === activeFilter;
    card.style.display = show ? '' : 'none';
  });

  const counter = document.getElementById('sidebar-count');
  if (counter) counter.textContent = `${visible} τοποθεσίες`;

  const empty = document.getElementById('sidebar-empty');
  const cards = document.getElementById('sidebar-cards');
  if (empty && cards) {
    empty.style.display = visible === 0 ? 'block' : 'none';
    cards.style.display = visible === 0 ? 'none' : '';
  }
}
</script>