---
import Layout from '../../layouts/Layout.astro';
import tavernsRaw from '../../data/taverns.json';
import beachesRaw from '../../data/beaches.json';

type Tavern = typeof tavernsRaw[number] & { localPhoto?: string | null };
type Beach  = typeof beachesRaw[number] & { localPhoto?: string | null };

const tavernsData = tavernsRaw as Tavern[];
const beachesData = beachesRaw as Beach[];

const base = import.meta.env.BASE_URL;

const featuredTaverns = [...tavernsData]
  .filter(t => t.isFeatured)
  .sort((a, b) => b.rating - a.rating)
  .slice(0, 3);
const getName    = (t: Tavern) => typeof t.name === 'object' ? (t.name as any).el : t.name as string;
const getCuisine = (t: Tavern) => typeof t.cuisine === 'object' && !Array.isArray(t.cuisine) ? (t.cuisine as any).el : (t.cuisine as any)?.[0] ?? '';
---

<Layout
  title="Ο Πλήρης Οδηγός για τη Μήλο"
  description="Παραλίες, εστιατόρια, χωριά, boat tours — ο πιο πλήρης οδηγός για τη Μήλο. Χωρίς διαφημίσεις."
>

<!-- ══ HERO ══ -->
<section class="hero">
  <div class="hero-bg"><div class="hero-radial"></div></div>
  <div class="hero-ghost" aria-hidden="true">ΜΗΛΟΣ</div>

  <div class="hero-content container">
    <div class="hero-eyebrow">
      <span class="eyedot"></span>
      <span>Κυκλάδες · Ελλάδα · 151 km²</span>
    </div>
    <div class="hero-title">
      <span class="hero-title-main">Μήλος</span>
      <span class="hero-title-sub">Ο πιο αυθεντικός οδηγός για το νησί</span>
    </div>
    <p class="hero-desc">
      Ηφαιστειακό τοπίο, 70+ παραλίες, κρυφά σπήλαια, ταβέρνες με αλιευμένη γεύση.
      Ό,τι χρειάζεσαι για να ζήσεις τη Μήλο σωστά — χωρίς διαφημίσεις.
    </p>
    <div class="hero-ctas">
      <a href={`${base}beaches`} class="btn-primary">🏖 Παραλίες</a>
      <a href={`${base}eat`} class="btn-secondary">🍽 Φαγητό</a>
    </div>
  </div>

  <div class="hero-stats container">
    <div class="stat-pill"><span class="stat-n">70+</span><span class="stat-l">Παραλίες</span></div>
    <div class="stat-pill"><span class="stat-n">151</span><span class="stat-l">km²</span></div>
    <div class="stat-pill"><span class="stat-n">125</span><span class="stat-l">km ακτογραμμή</span></div>
    <div class="stat-pill"><span class="stat-n">~5.000</span><span class="stat-l">Κάτοικοι</span></div>
  </div>

  <div class="hero-waves" aria-hidden="true">
    <svg viewBox="0 0 1440 100" preserveAspectRatio="none" xmlns="http://www.w3.org/2000/svg">
      <path d="M0,40 C360,90 1080,0 1440,50 L1440,100 L0,100 Z" fill="#f5f0e8"/>
    </svg>
  </div>
  <div class="scroll-hint" aria-hidden="true">
    <span>scroll</span><div class="scroll-line"></div>
  </div>
</section>


<!-- ══ EXPLORE ══ -->
<section class="sec sec-sand" style="padding-top:3.5rem">
  <div class="container">
    <div class="explore-head">
      <span class="label" style="margin:0">Εξερεύνηση</span>
      <span class="explore-head-title">Τι θες να ανακαλύψεις στη Μήλο;</span>
    </div>
    <div class="cat-list">
      <a href={`${base}beaches`} class="cat-row">
        <span class="cat-num">01</span>
        <div class="cat-info">
          <span class="cat-name">Παραλίες</span>
          <span class="cat-desc">Από το ηφαιστειακό Σαρακήνικο ως τα κρυφά σπήλαια — {beachesData.length}+ ακτές για κάθε γούστο</span>
        </div>
        <span class="cat-count">{beachesData.length}+ παραλίες</span>
        <span class="cat-arrow">→</span>
      </a>
      <a href={`${base}eat`} class="cat-row">
        <span class="cat-num">02</span>
        <div class="cat-info">
          <span class="cat-name">Φαγητό</span>
          <span class="cat-desc">Ταβέρνες με αλιευμένη γεύση, ψητά σε ξυλόφουρνο, λευκό κρασί δίπλα στη θάλασσα</span>
        </div>
        <span class="cat-count">{tavernsData.length}+ εστιατόρια</span>
        <span class="cat-arrow">→</span>
      </a>
      <a href={`${base}villages`} class="cat-row">
        <span class="cat-num">03</span>
        <div class="cat-info">
          <span class="cat-name">Χωριά</span>
          <span class="cat-desc">Πλάκα, Κλήμα, Τρυπητή, Πολλώνια — το νησί πέρα από τις παραλίες</span>
        </div>
        <span class="cat-count">8 χωριά</span>
        <span class="cat-arrow">→</span>
      </a>
      <div class="cat-row cat-row--dim">
        <span class="cat-num">04</span>
        <div class="cat-info">
          <span class="cat-name">Boat Tours</span>
          <span class="cat-desc">Κλέφτικο, Συκιά, γύρος νησιού — οι καλύτεροι καπετάνιοι στη Μήλο</span>
        </div>
        <span class="soon-tag">Σύντομα</span>
        <span class="cat-arrow">→</span>
      </div>
      <div class="cat-row cat-row--dim">
        <span class="cat-num">05</span>
        <div class="cat-info">
          <span class="cat-name">Ενοικιάσεις</span>
          <span class="cat-desc">Αυτοκίνητα, μηχανάκια, ATV — εξερεύνησε με τους δικούς σου ρυθμούς</span>
        </div>
        <span class="soon-tag">Σύντομα</span>
        <span class="cat-arrow">→</span>
      </div>
    </div>
  </div>
</section>


<!-- ══ NUMBERS ══ -->
<section class="sec sec-dark">
  <div class="container">
    <div class="sec-hdr-row" style="margin-bottom:3rem">
      <div>
        <span class="label label-lt">Η Μήλος με αριθμούς</span>
        <h2 class="sec-title sec-title-lt">Ένα νησί σε στοιχεία</h2>
      </div>
    </div>
    <div class="numbers-grid">
      <div class="num-item"><div class="num-label">Παραλίες</div><div class="num-val">70+</div><div class="num-desc">Μία από τις πιο πλούσιες σε παραλίες Κυκλάδες</div></div>
      <div class="num-item"><div class="num-label">Ακτογραμμή</div><div class="num-val">125 km</div><div class="num-desc">Έντονα διαρθρωμένη λόγω της ηφαιστειακής προέλευσης</div></div>
      <div class="num-item"><div class="num-label">Έκταση</div><div class="num-val">151 km²</div><div class="num-desc">Η 7η μεγαλύτερη νήσος στις Κυκλάδες</div></div>
      <div class="num-item"><div class="num-label">Από Πειραιά</div><div class="num-val">86 ν.μ.</div><div class="num-desc">Ταχύπλοο ~3.5 ώρες, κανονικό ~7 ώρες</div></div>
      <div class="num-item"><div class="num-label">Λιμάνι</div><div class="num-val">Top 5</div><div class="num-desc">Ένα από τα μεγαλύτερα φυσικά λιμάνια της Μεσογείου</div></div>
      <div class="num-item"><div class="num-label">Ηφαιστειακό τόξο</div><div class="num-val">3M χρόνια</div><div class="num-desc">Γεωλογική ιστορία που διαμόρφωσε κάθε βράχο</div></div>
    </div>
  </div>
</section>


<!-- ══ QUICK FACTS ══ -->
<section class="sec sec-white">
  <div class="container">
    <div class="sec-hdr-row">
      <div>
        <span class="label">Γρήγορες πληροφορίες</span>
        <h2 class="sec-title">Quick Facts</h2>
      </div>
    </div>
    <div class="facts-grid">
      <div class="fact-item"><span class="fact-key">Περιφέρεια</span><span class="fact-val">Κυκλάδες</span></div>
      <div class="fact-item"><span class="fact-key">Πρωτεύουσα</span><span class="fact-val">Πλάκα</span></div>
      <div class="fact-item"><span class="fact-key">Λιμάνι</span><span class="fact-val">Αδάμαντας</span></div>
      <div class="fact-item"><span class="fact-key">Πληθυσμός</span><span class="fact-val">~5.000</span></div>
      <div class="fact-item"><span class="fact-key">Παραλίες</span><span class="fact-val">70+</span></div>
      <div class="fact-item"><span class="fact-key">Έκταση</span><span class="fact-val">151 km²</span></div>
      <div class="fact-item"><span class="fact-key">Ψηλότερη κορυφή</span><span class="fact-val">Προφήτης Ηλίας</span></div>
      <div class="fact-item"><span class="fact-key">Διάσημο εύρημα</span><span class="fact-val">Αφροδίτη της Μήλου</span></div>
    </div>
  </div>
</section>


<!-- ══ WHY DIFFERENT ══ -->
<section class="sec sec-sand">
  <div class="container">
    <div class="sec-hdr-row">
      <div>
        <span class="label">Γιατί η Μήλος είναι διαφορετική</span>
        <h2 class="sec-title">Αυτό που δεν θα βρεις<br/>αλλού στο Αιγαίο</h2>
      </div>
    </div>
    <div class="why-grid">
      <div class="why-item">
        <div class="why-num">01</div>
        <div class="why-title">Ηφαιστειακή προέλευση</div>
        <p class="why-text">Η Μήλος ανήκει στο Αιγαιακό Ηφαιστειακό Τόξο και το τοπίο της έχει διαμορφωθεί από εκατομμύρια χρόνια ηφαιστειακής δραστηριότητας. Αυτό εξηγεί τους λευκούς βραχώδεις σχηματισμούς του Σαρακήνικο, τα θερμά νερά στο Παλαιοχώρι και τα ηφαιστειογενή πετρώματα σε κάθε γωνιά του νησιού.</p>
      </div>
      <div class="why-item">
        <div class="why-num">02</div>
        <div class="why-title">Οψιδιανός και αρχαίο εμπόριο</div>
        <p class="why-text">Από τη Νεολιθική εποχή η Μήλος ήταν σημαντικό εμπορικό κέντρο λόγω του οψιδιανού — ενός ηφαιστειακού πετρώματος που χρησιμοποιούσαν για εργαλεία και όπλα σε όλη τη Μεσόγειο. Έχουν βρεθεί κομμάτια μηλιακού οψιδιανού ακόμα και στην Αίγυπτο.</p>
      </div>
      <div class="why-item">
        <div class="why-num">03</div>
        <div class="why-title">Η Αφροδίτη που δεν υπάρχει πλέον</div>
        <p class="why-text">Το 1820 ένας αγρότης στη Μήλο ανακάλυψε το άγαλμα που σήμερα κοσμεί το Λούβρο. Η περίφημη Αφροδίτη της Μήλου φιλοτεχνήθηκε γύρω στο 130 π.Χ. και ήταν κρυμμένη επί αιώνες στο έδαφος του νησιού.</p>
      </div>
      <div class="why-item">
        <div class="why-num">04</div>
        <div class="why-title">Φυσικό λιμάνι βουλκανικής καλδέρας</div>
        <p class="why-text">Ο κόλπος της Μήλου είναι στην ουσία μια βυθισμένη ηφαιστειακή καλδέρα — ένα από τα μεγαλύτερα φυσικά λιμάνια στη Μεσόγειο. Ιστορικά χρησιμοποιούνταν ως καταφύγιο για στόλους από την αρχαιότητα ως τον Β' Παγκόσμιο Πόλεμο.</p>
      </div>
    </div>
  </div>
</section>


<!-- ══ FEATURED TAVERNS ══ -->
{featuredTaverns.length > 0 && (
  <section class="sec sec-white">
    <div class="container">
      <div class="sec-hdr-row">
        <div>
          <span class="label">Φαγητό</span>
          <h2 class="sec-title">Επιλεγμένα εστιατόρια</h2>
        </div>
        <a href={`${base}eat`} class="see-all">Όλα τα εστιατόρια →</a>
      </div>
      <div class="tav-grid">
        {featuredTaverns.map(tavern => (
          <a href={`${base}eat/${tavern.slug}`} class="tav-card">
            {tavern.localPhoto ? (
              <img src={tavern.localPhoto} alt={getName(tavern)} class="tav-img" loading="lazy"/>
            ) : (
              <div class="tav-ph">🍽</div>
            )}
            <div class="tav-body">
              <div class="tav-top">
                <span class="tav-badge">⭐ Επιλεγμένο</span>
                <span class="tav-price">{tavern.priceRange}</span>
              </div>
              <h3 class="tav-name">{getName(tavern)}</h3>
              <p class="tav-loc">◉ {tavern.location.area}</p>
              <div class="tav-foot">
                <span class="tav-rating">⭐ {tavern.rating} / 5</span>
                <span class="tav-cuisine">{getCuisine(tavern)}</span>
              </div>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>
)}


<!-- ══ BEACHES BY TYPE ══ -->
<section class="sec sec-white">
  <div class="container">
    <div class="sec-hdr-row">
      <div>
        <span class="label">Παραλίες</span>
        <h2 class="sec-title">Βρες την παραλία σου</h2>
      </div>
      <a href={`${base}beaches`} class="see-all">Όλες οι παραλίες →</a>
    </div>
    <div class="beach-cat-grid">
      <div class="beach-cat">
        <div class="beach-cat-title">👨‍👩‍👧 Για οικογένειες</div>
        <div class="beach-cat-list">
          <a href={`${base}beaches/paleochori`} class="beach-link"><span class="beach-link-icon">🚗</span>Παλαιοχώρι</a>
          <a href={`${base}beaches/provatas`}   class="beach-link"><span class="beach-link-icon">🚗</span>Προβατάς</a>
          <a href={`${base}beaches/fyriplaka`}  class="beach-link"><span class="beach-link-icon">🚗</span>Φυριπλάκα</a>
        </div>
      </div>
      <div class="beach-cat">
        <div class="beach-cat-title">📸 Για φωτογραφίες</div>
        <div class="beach-cat-list">
          <a href={`${base}beaches/sarakiniko`} class="beach-link"><span class="beach-link-icon">🚗</span>Σαρακήνικο</a>
          <a href={`${base}beaches/kleftiko`}   class="beach-link"><span class="beach-link-icon">⛵</span>Κλέφτικο</a>
          <a href={`${base}beaches/tsigrado`}   class="beach-link"><span class="beach-link-icon">🥾</span>Τσιγκράδο</a>
        </div>
      </div>
      <div class="beach-cat">
        <div class="beach-cat-title">🔇 Για ησυχία</div>
        <div class="beach-cat-list">
          <a href={`${base}beaches/triades`}   class="beach-link"><span class="beach-link-icon">🚗</span>Τριάδες</a>
          <a href={`${base}beaches/gerontas`}  class="beach-link"><span class="beach-link-icon">🚗</span>Γέροντας</a>
          <a href={`${base}beaches/ammoudaki`} class="beach-link"><span class="beach-link-icon">🥾</span>Αμμουδάκι</a>
        </div>
      </div>
      <div class="beach-cat">
        <div class="beach-cat-title">⛵ Μόνο με σκάφος</div>
        <div class="beach-cat-list">
          <a href={`${base}beaches/kleftiko`}   class="beach-link"><span class="beach-link-icon">⛵</span>Κλέφτικο</a>
          <a href={`${base}beaches/sikia-cave`} class="beach-link"><span class="beach-link-icon">⛵</span>Σπηλιά Συκιάς</a>
          <a href={`${base}beaches/ammoudaki`}  class="beach-link"><span class="beach-link-icon">⛵</span>Αμμουδάκι</a>
        </div>
      </div>
    </div>
  </div>
</section>


<!-- ══ VILLAGES ══ -->
<section class="sec sec-sand">
  <div class="container">
    <div class="sec-hdr-row">
      <div>
        <span class="label">Χωριά</span>
        <h2 class="sec-title">Η Μήλος πέρα από τις παραλίες</h2>
      </div>
      <a href={`${base}villages`} class="see-all">Όλα τα χωριά →</a>
    </div>
    <div class="villages-grid">
      <a href={`${base}villages/plaka`}       class="village-card"><span class="village-name">Πλάκα</span><span class="village-note">Η πρωτεύουσα, πάνω στο βράχο, με πανοραμική θέα</span></a>
      <a href={`${base}villages/tripiti`}     class="village-card"><span class="village-name">Τρυπητή</span><span class="village-note">Κατακόμβες, αρχαίο θέατρο, ατμοσφαιρικό χωριό</span></a>
      <a href={`${base}villages/pollonia`}    class="village-card"><span class="village-name">Πολλώνια</span><span class="village-note">Βόρεια, με ψαροταβέρνες και πρόσβαση στη Κίμωλο</span></a>
      <a href={`${base}villages/klima`}       class="village-card"><span class="village-name">Κλήμα</span><span class="village-note">Τα περίφημα σύρματα — αλιευτικές αποθήκες στο νερό</span></a>
      <a href={`${base}villages/mandrakia`}   class="village-card"><span class="village-name">Μανδράκια</span><span class="village-note">Μικρό λιμανάκι με πολύχρωμα σύρματα</span></a>
      <a href={`${base}villages/firopotamos`} class="village-card"><span class="village-name">Φυροπόταμος</span><span class="village-note">Ήσυχος, αυθεντικός, μακριά από τον τουρισμό</span></a>
    </div>
  </div>
</section>


<!-- ══ KNOWN PLACES ══ -->
<section class="sec sec-white">
  <div class="container">
    <div class="sec-hdr-row">
      <div>
        <span class="label">Αξιοθέατα &amp; τοπόσημα</span>
        <h2 class="sec-title">Τα πιο γνωστά μέρη</h2>
      </div>
    </div>
    <div class="places-strip">
      <a href={`${base}beaches/sarakiniko`}   class="place-chip"><span class="place-chip-name">Σαρακήνικο</span><span class="place-chip-type">🏖 Παραλία</span></a>
      <a href={`${base}beaches/kleftiko`}     class="place-chip"><span class="place-chip-name">Κλέφτικο</span><span class="place-chip-type">⛵ Θαλάσσιο σπήλαιο</span></a>
      <a href={`${base}villages/plaka`}       class="place-chip"><span class="place-chip-name">Πλάκα</span><span class="place-chip-type">🏘 Χωριό</span></a>
      <a href={`${base}villages/pollonia`}    class="place-chip"><span class="place-chip-name">Πολλώνια</span><span class="place-chip-type">🍽 Φαγητό &amp; θάλασσα</span></a>
      <a href={`${base}villages/klima`}       class="place-chip"><span class="place-chip-name">Κλήμα</span><span class="place-chip-type">🏠 Σύρματα</span></a>
      <a href={`${base}villages/firopotamos`} class="place-chip"><span class="place-chip-name">Φυροπόταμος</span><span class="place-chip-type">📷 Φωτογένια</span></a>
    </div>
  </div>
</section>


<!-- ══ WHEN TO VISIT ══ -->
<section class="sec sec-sand">
  <div class="container">
    <div class="sec-hdr-row">
      <div>
        <span class="label">Πότε να έρθεις</span>
        <h2 class="sec-title">Κάθε μήνας έχει<br/>τον χαρακτήρα του</h2>
      </div>
    </div>
    <div class="months-grid">
      <div class="month-item">
        <div class="month-name">Μάιος</div>
        <span class="month-tag">Ήρεμα</span>
        <p class="month-desc">Λιγότερος κόσμος, ανθισμένο τοπίο, ιδανικό για εξερεύνηση. Θάλασσα ακόμα δροσερή.</p>
      </div>
      <div class="month-item">
        <div class="month-name">Ιούνιος</div>
        <span class="month-tag">Ιδανικό</span>
        <p class="month-desc">Η καλύτερη ισορροπία. Ζεστή θάλασσα, λίγα πλήθη, όλα ανοιχτά.</p>
      </div>
      <div class="month-item month-item--best">
        <div class="month-name">Σεπτέμβριος</div>
        <span class="month-tag">Καλύτερος</span>
        <p class="month-desc">Ίσως ο τέλειος μήνας. Ζεστή θάλασσα, λιγότερος κόσμος, χαμηλότερες τιμές.</p>
      </div>
      <div class="month-item month-item--warn">
        <div class="month-name">Αύγουστος</div>
        <span class="month-tag">Προσοχή</span>
        <p class="month-desc">Μελτέμια επηρεάζουν ποιες παραλίες είναι κατάλληλες κάθε μέρα. Πολύς κόσμος.</p>
      </div>
      <div class="month-item">
        <div class="month-name">Ιούλιος</div>
        <span class="month-tag">Υψηλή σεζόν</span>
        <p class="month-desc">Ζωντανή ατμόσφαιρα, αλλά χρειάζεται κράτηση παντού εκ των προτέρων.</p>
      </div>
    </div>
